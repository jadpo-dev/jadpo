{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Jadpo record",
  "scopeName": "source.jadpo-record",
  "comment": "The record format (docs/language/18-records-and-manifest.md, \"The record format\"): a header, then entries whose heading starts in column 0 and whose members are indented. A line's kind is known from its first characters, so this reads one line at a time as the format allows. The record kinds are checked against the compiler by tools/checks/editor_grammar.py.",
  "patterns": [
    { "include": "#header" },
    { "include": "#record-line" },
    { "include": "#description" },
    { "include": "#comment" },
    { "include": "#route" },
    { "include": "#heading" },
    { "include": "#field" },
    { "include": "#fact" },
    { "include": "#values" }
  ],
  "repository": {
    "header": {
      "match": "^// Generated by Jadpo .*$",
      "name": "comment.line.double-slash.header.jadpo-record"
    },
    "record-line": {
      "match": "^(record) (api|events|access|network|surface|identities|translations|ignored_suggestions|taught_suggestions|lock) ([0-9]+)$",
      "captures": {
        "1": { "name": "keyword.other.record.jadpo-record" },
        "2": { "name": "entity.name.type.record-kind.jadpo-record" },
        "3": { "name": "constant.numeric.format.jadpo-record" }
      }
    },
    "description": {
      "match": "^ *///.*$",
      "name": "comment.line.documentation.jadpo-record"
    },
    "comment": {
      "comment": "Any other comment is a hand edit, which the language server reports. A URL's `://` is no comment.",
      "match": "(?<=^| )//(?!/).*$",
      "name": "comment.line.double-slash.jadpo-record"
    },
    "route": {
      "match": "^(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS) (\\S+)",
      "captures": {
        "1": { "name": "keyword.other.http-method.jadpo-record" },
        "2": { "name": "string.unquoted.route-path.jadpo-record" }
      }
    },
    "heading": {
      "match": "^([a-z][a-z0-9_]*)(?= |$)",
      "captures": {
        "1": { "name": "keyword.control.entry.jadpo-record" }
      }
    },
    "field": {
      "match": "^( +)([a-z][a-z0-9_]*)(:) ",
      "captures": {
        "2": { "name": "variable.other.field.jadpo-record" },
        "3": { "name": "punctuation.separator.key-value.jadpo-record" }
      }
    },
    "fact": {
      "match": "^( +)([a-z][a-z0-9_]*)(?= |$)",
      "captures": {
        "2": { "name": "keyword.other.fact.jadpo-record" }
      }
    },
    "values": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.jadpo-record",
          "patterns": [
            { "match": "\\\\[\"\\\\nrt]", "name": "constant.character.escape.jadpo-record" }
          ]
        },
        { "match": "\\bsha256:[0-9a-f]{64}\\b", "name": "constant.other.digest.jadpo-record" },
        { "match": "\\b(?:[0-9a-f]{64}|[0-9a-f]{40}|[0-9a-f]{12})\\b", "name": "constant.other.hash.jadpo-record" },
        { "match": "->", "name": "keyword.operator.arrow.jadpo-record" },
        { "match": "\\b[0-9]+(?:\\.[0-9]+)*(?:-[0-9A-Za-z.]+)?\\b", "name": "constant.numeric.jadpo-record" },
        { "match": "\\b[A-Z][A-Za-z0-9_]*\\b", "name": "entity.name.type.jadpo-record" },
        { "match": "[{}\\[\\](),]", "name": "punctuation.jadpo-record" }
      ]
    }
  }
}
