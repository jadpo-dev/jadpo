{
  "name": "jadpo",
  "displayName": "Jadpo",
  "description": "Jadpo for VS Code: the compiler's errors as you type, completion, hover, go to definition, formatting and quick fixes.",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#15181c",
    "theme": "dark"
  },
  "version": "0.2.0",
  "publisher": "jadpo",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/jadpo-dev/jadpo.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.91.0",
    "node": ">=22"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "scripts": {
    "package": "vsce package --skip-license",
    "test": "node --test test/*.test.js"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Jadpo runs the `jadpo` binary `jadpo.server.path` names, which a workspace's own settings may set, so it waits until the workspace is trusted."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "languages": [
      {
        "id": "jadpo",
        "aliases": [
          "Jadpo",
          "jadpo"
        ],
        "extensions": [
          ".jadpo"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jadpo",
        "scopeName": "source.jadpo",
        "path": "./syntaxes/jadpo.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "jadpo.openGeneratedFile",
        "title": "Open Generated File",
        "category": "Jadpo"
      },
      {
        "command": "jadpo.restartServer",
        "title": "Restart Language Server",
        "category": "Jadpo"
      },
      {
        "command": "jadpo.showServerLog",
        "title": "Show Language Server Log",
        "category": "Jadpo"
      },
      {
        "command": "jadpo.openServerSetting",
        "title": "Open the jadpo.server.path Setting",
        "category": "Jadpo"
      }
    ],
    "configuration": {
      "title": "Jadpo",
      "properties": {
        "jadpo.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "An override for people working on the compiler: the `jadpo` binary that runs `jadpo lsp`. Left empty, the `jadpo` on `PATH` runs it from the project's folder, and runs the Jadpo release the project names. A bare name is looked up on `PATH`. To use a build from a checkout of the Jadpo repository, give its path, for example `${workspaceFolder}/target/release/jadpo` (`${workspaceFolder}` is the first folder open in the window; a leading `~` is your home folder)."
        },
        "jadpo.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Logs the messages between the editor and the language server to the Jadpo output channel."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "jadpo.openServerSetting",
          "when": "false"
        }
      ]
    },
    "configurationDefaults": {
      "[jadpo]": {
        "editor.formatOnSave": true
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "11.0.0"
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.0",
    "vscode-jsonrpc": "10.0.0",
    "vscode-languageserver-protocol": "3.18.5"
  },
  "overrides": {
    "@azure/msal-node": "7.1.2"
  },
  "keywords": [
    "jadpo",
    "language server"
  ],
  "homepage": "https://github.com/jadpo-dev/jadpo/tree/main/editors/vscode",
  "bugs": {
    "url": "https://github.com/jadpo-dev/jadpo/issues"
  }
}
