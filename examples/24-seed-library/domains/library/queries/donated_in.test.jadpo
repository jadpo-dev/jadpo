use library/entities { SeedPacket }
use library/types { PacketLabel }
use library/actions { add_packet }

test "a season's donations are the packets given that year" {
    var last_year: SeedPacket = add_packet("Painted Lady runner bean", 2024, "2025-12-30", false)
    var this_year: SeedPacket = add_packet("Painted Lady runner bean", 2025, "2026-01-02", false)
    assert last_year.saved_in == 2024
    var given: List<PacketLabel> = donated_in(2026)
    assert given == [
        PacketLabel {
            id: this_year.id
            variety: "Painted Lady runner bean"
            donated_on: "2026-01-02"
        }
    ]
}
