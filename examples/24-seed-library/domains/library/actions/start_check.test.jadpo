// A run starts after the action that starts it commits, on the runner;
// a test's host keeps no runner, so these tests see a run as it starts,
// and test what each page and `finished:` call on their own.

use library/entities { SeedPacket, StockCheck }
use library/actions { add_packet, check_progress, open_check, stop_check }

test "starting a check twice gives the same run" {
    var crimson: SeedPacket = add_packet("Crimson Flowered broad bean", 2024, "2024-09-14", false)
    assert crimson.withdrawn == false
    var spring: StockCheck = open_check(2026)
    var started: StockCheck = start_check(spring)
    var again: StockCheck = start_check(started)
    assert started.sweep != none
    assert again.sweep == started.sweep
}

test "a check starts running, with nothing done and no problems yet" {
    var spring: StockCheck = start_check(open_check(2026))
    match spring.sweep {
        some(sweep) -> {
            var progress: BatchProgress = check_progress(sweep)
            assert progress.state == BatchState.running
            assert progress.items_done == 0
            assert progress.problems == 0
        }
        none -> {
            assert false
        }
    }
}

test "a stopped check runs until its next page" {
    var spring: StockCheck = start_check(open_check(2026))
    match spring.sweep {
        some(sweep) -> {
            stop_check(sweep)
            assert check_progress(sweep).state == BatchState.running
        }
        none -> {
            assert false
        }
    }
}
