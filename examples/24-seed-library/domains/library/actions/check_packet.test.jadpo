use library/entities { SeedPacket }
use library/failures { PacketOnLoan }
use library/actions { add_packet }

test "a packet saved four seasons ago is withdrawn" {
    var old: SeedPacket = add_packet("Cherokee Trail of Tears bean", 2022, "2022-09-14", false)
    attempt check_packet(old, 2026)
    var fresh: SeedPacket = add_packet("Gardener's Delight tomato", 2025, "2025-09-14", false)
    attempt check_packet(fresh, 2026)
    var old_now: SeedPacket = attempt SeedPacket.get(old.id)
    var fresh_now: SeedPacket = attempt SeedPacket.get(fresh.id)
    assert old_now.withdrawn
    assert fresh_now.withdrawn == false
}

test "a packet out on loan fails, which a run keeps as a problem" {
    var lent: SeedPacket = add_packet("Boston Pickling cucumber", 2024, "2024-09-14", true)
    assert check_packet(lent, 2026) fails PacketOnLoan
}
