// `csv.read` reads a stored file's rows after this action commits, in
// the background, a batch at a time: each row read as `as:`'s `Input`
// and handed to `each:`'s action. Each batch's rows are read from the
// store before its transaction opens, then their packets and how far the
// run got commit together, so a restart picks up at the next row and
// adds no packet twice. A row that can't be read, or whose action fails,
// is a problem, by its row as a spreadsheet numbers it and its column;
// a column the sheet lacks, or a quote that never closes, stops the run.

use seedbank/entities { DonationSheet, DonationSheetNotFound }
use seedbank/types { DonationRow }
use seedbank/actions { add_donation, record_sheet }

/// Starts shelving the packets a kept sheet lists.
action add_sheet(sheet_id: DonationSheet.id) fails DonationSheetNotFound -> DonationSheet {
    var donations: DonationSheet = attempt DonationSheet.get(sheet_id)
    var shelving: BatchRun = csv.read(
        donations.sheet,
        as: DonationRow,
        each: donation -> add_donation(donation),
        finished: summary -> record_sheet(summary, donations.id),
        key: donations.id
    )
    return DonationSheet.update(donations) {
        set: {
            shelving: shelving
        }
    }
}
