// A run starts after the action that starts it commits, on the runner;
// a test's host keeps no runner, so these tests see a run as it starts,
// and test what each page and `finished:` call on their own.

use seedbank/entities { SeedPacket, StockCheck }
use seedbank/actions { add_packet, check_progress, open_check, stop_check }

test "starting a check twice gives the same run" {
    var crimson: SeedPacket = add_packet("Crimson Flowered broad bean", 2024, "2024-09-14", false)
    assert crimson.withdrawn == false
    var spring_check: StockCheck = open_check(2026)
    var started: StockCheck = start_check(spring_check)
    var restarted: StockCheck = start_check(started)
    assert started.shelf_walk != none
    assert restarted.shelf_walk == started.shelf_walk
}

test "a check starts running, with nothing done and no problems yet" {
    var spring_check: StockCheck = start_check(open_check(2026))
    match spring_check.shelf_walk {
        some(shelf_walk) -> {
            var walk_state: BatchProgress = check_progress(shelf_walk)
            assert walk_state.state == BatchState.running
            assert walk_state.items_done == 0
            assert walk_state.problems == 0
        }
        none -> {
            assert false
        }
    }
}

test "a stopped check runs until its next page" {
    var spring_check: StockCheck = start_check(open_check(2026))
    match spring_check.shelf_walk {
        some(shelf_walk) -> {
            stop_check(shelf_walk)
            assert check_progress(shelf_walk).state == BatchState.running
        }
        none -> {
            assert false
        }
    }
}
