// A run starts after the action that starts it commits. In a test it runs
// to the end before the test's next line, two packets a batch with a
// restart between batches, so the test sees what the whole run did, and
// every check it makes is a check of resuming too.

use seedbank/entities { SeedPacket, StockCheck }
use seedbank/actions { add_packet, check_progress, open_check, stop_check }

test "starting a check twice gives the same run" {
    var crimson: SeedPacket = add_packet("Crimson Flowered broad bean", 2024, "2024-09-14", false)
    assert crimson.withdrawn == false
    var spring_check: StockCheck = open_check(2026)
    var started: StockCheck = start_check(spring_check)
    var restarted: StockCheck = start_check(started)
    assert started.shelf_walk != none
    assert restarted.shelf_walk == started.shelf_walk
}

test "an old packet is withdrawn by the check" {
    var old: SeedPacket = add_packet("Old bean", 2020, "2020-09-14", false)
    var fresh: SeedPacket = add_packet("Gardener's Delight tomato", 2025, "2025-09-14", false)
    var spring_check: StockCheck = start_check(open_check(2026))
    assert spring_check.shelf_walk != none
    var old_now: SeedPacket = attempt SeedPacket.get(old.id)
    var fresh_now: SeedPacket = attempt SeedPacket.get(fresh.id)
    assert old_now.withdrawn
    assert fresh_now.withdrawn == false
}

test "a check counts every packet, and one out on loan is a problem" {
    var cherokee: SeedPacket = add_packet("Cherokee Trail of Tears bean", 2022, "2022-09-14", false)
    var lent: SeedPacket = add_packet("Boston Pickling cucumber", 2024, "2024-09-14", true)
    var fresh: SeedPacket = add_packet("Gardener's Delight tomato", 2025, "2025-09-14", false)
    assert lent.on_loan
    var spring_check: StockCheck = start_check(open_check(2026))
    var counted: StockCheck = attempt StockCheck.get(spring_check.id)
    assert counted.packets_checked == 3
    assert counted.packets_on_loan == 1
    var cherokee_now: SeedPacket = attempt SeedPacket.get(cherokee.id)
    var fresh_now: SeedPacket = attempt SeedPacket.get(fresh.id)
    assert cherokee_now.withdrawn
    assert fresh_now.withdrawn == false
    match spring_check.shelf_walk {
        some(shelf_walk) -> {
            var walk_state: BatchProgress = check_progress(shelf_walk)
            assert walk_state.state == BatchState.finished
            assert walk_state.items_done == 3
            assert walk_state.problems == 1
        }
        none -> {
            assert false
        }
    }
}

test "stopping a check that has finished leaves it finished" {
    var spring_check: StockCheck = start_check(open_check(2026))
    match spring_check.shelf_walk {
        some(shelf_walk) -> {
            stop_check(shelf_walk)
            assert check_progress(shelf_walk).state == BatchState.finished
        }
        none -> {
            assert false
        }
    }
}
