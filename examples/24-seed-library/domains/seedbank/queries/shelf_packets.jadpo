// A batch walks a query that returns a `Page`, a page at a time. Ordering
// by `id`, which never changes, keeps every packet in exactly one page
// however the shelves change during the walk.

use seedbank/entities { SeedPacket }
use seedbank/types { PacketPage }

/// Every packet not yet withdrawn, a page at a time.
query shelf_packets(page: PacketPage) -> Page<SeedPacket> {
    from: SeedPacket
    where: SeedPacket.withdrawn == false
    order: [SeedPacket.id asc]
    page: {
        size: page.page_size
        after: page.after
    }
}
