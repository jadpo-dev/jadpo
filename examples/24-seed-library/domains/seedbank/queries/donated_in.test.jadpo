use seedbank/entities { SeedPacket }
use seedbank/types { PacketLabel }
use seedbank/actions { add_packet }

test "a season's donations are the packets given that year" {
    var older_gift: SeedPacket = add_packet("Painted Lady runner bean", 2024, "2025-12-30", false)
    var newer_gift: SeedPacket = add_packet("Painted Lady runner bean", 2025, "2026-01-02", false)
    assert older_gift.saved_in == 2024
    var donations: List<PacketLabel> = donated_in(2026)
    assert donations == [
        PacketLabel {
            id: newer_gift.id
            variety: "Painted Lady runner bean"
            donated_on: "2026-01-02"
        }
    ]
}
