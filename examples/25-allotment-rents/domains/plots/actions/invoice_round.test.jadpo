// A batch runs after the action that starts it commits, on the runner;
// a test's host keeps no runner, so these tests see a run as it starts.

use plots/entities { RentRound }
use plots/types { SocietySites }
use plots/actions { open_rent_round, round_progress }
use plots/fixtures { two_societies }

test "starting a round twice gives the same run" {
    var allotments: SocietySites = two_societies()
    var rent_round: RentRound = attempt open_rent_round(allotments.vale_road.id, 2027)
    var first: RentRound = invoice_round(rent_round)
    var restarted: RentRound = invoice_round(first)
    assert first.invoices != none
    assert restarted.invoices == first.invoices
}

test "a round starts running with nothing done yet" {
    var allotments: SocietySites = two_societies()
    var rent_round: RentRound = attempt open_rent_round(allotments.hill_top.id, 2027)
    var started: RentRound = invoice_round(rent_round)
    var started_ok: Bool = match started.invoices {
        some(invoices) -> round_progress(invoices).state == BatchState.running
        none -> false
    }
    assert started_ok
}
