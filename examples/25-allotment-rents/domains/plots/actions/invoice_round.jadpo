// A batch in an application with a tenant runs within one tenant: the
// one its saved values name. Here `from:`'s first argument is a
// `Society.id`, so every page, and every plot's action, runs as the
// system within that society alone, however many societies share the
// application. A run that saves no tenant's id reaches no tenant's
// records, only those every tenant shares.
//
// `key:` is the round, so starting a round twice charges nobody twice.

use plots/entities { RentRound }
use plots/types { PlotPage }
use plots/actions { invoice_plot }
use plots/queries { society_plots }

/// Charges every plot in the round's society its year's rent.
action invoice_round(round: RentRound) -> RentRound {
    var run: BatchRun = batches.each(
        from: society_plots(round.society_id, PlotPage {}),
        each: plot -> invoice_plot(plot, round.id),
        key: round.id
    )
    return RentRound.update(round) {
        set: {
            invoices: run
        }
    }
}
