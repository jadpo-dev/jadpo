// `batches.each` walks a named query's pages after this action commits,
// calling an action per item, and gives a `BatchRun` at once. Each page
// is one transaction holding its items' writes and the run's position,
// so a crash or a deploy resumes at the next page and no plot is charged
// twice. An item whose action fails is undone alone and kept as a
// problem, its place in the walk and its failure's code but never its
// values, and the rest carry on.
//
// What `each:` and `finished:` capture, and `key:`, are saved with the
// run. `key:` makes a repeated start give the same run, so pressing the
// button twice charges nobody twice.
//
// The run is limited to one society: its saved values include a
// `Society.id`, `from:`'s first argument, so every page, item and
// `finished:` runs as the system within that society alone.

use plots/entities { RentRound }
use plots/types { PlotPage }
use plots/actions { invoice_plot }
use plots/queries { society_plots }

/// Charges every plot in the round's society its year's rent.
action invoice_round(round: RentRound) -> RentRound {
    var run: BatchRun = batches.each(
        from: society_plots(round.society_id, PlotPage {}),
        each: plot -> invoice_plot(plot, round.id),
        key: round.id
    )
    return RentRound.update(round) {
        set: {
            invoices: run
        }
    }
}
