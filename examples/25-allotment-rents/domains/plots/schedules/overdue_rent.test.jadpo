use plots/entities { Plot }
use plots/types { SocietySites }
use plots/fixtures { two_societies }

test "one run flags the overdue plots of every society" {
    clock: "2026-10-19T07:00:00Z"
    var allotments: SocietySites = two_societies()
    overdue_rent.run()
    var ada: Plot = attempt Plot.get(allotments.ada_overdue.id)
    var ben: Plot = attempt Plot.get(allotments.ben_overdue.id)
    var cy: Plot = attempt Plot.get(allotments.cy_not_due.id)
    assert ada.reminded_on == "2026-10-19"
    assert ben.reminded_on == "2026-10-19"
    assert cy.reminded_on == none
}

test "a plot flagged once isn't flagged again the next day" {
    clock: "2026-10-19T07:00:00Z"
    var allotments: SocietySites = two_societies()
    overdue_rent.run()
    clock.advance(1d)
    overdue_rent.run()
    var ada: Plot = attempt Plot.get(allotments.ada_overdue.id)
    assert ada.reminded_on == "2026-10-19"
}
