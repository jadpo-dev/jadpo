type PageSize = Int {
    min: 1
    max: 100
}

input ListTodos {
    status: Todo.status optional
    due_before: Instant optional
    page_size: PageSize default 25
    after: TodoCursor optional
}

enum AuthenticationStrength {
    primary
    multi_factor
}

enum HealthStatus {
    healthy
}

input PatchTodo {
    title: Todo.title optional
    status: Todo.status optional
    due_at: Todo.due_at optional
}

input CreateTodo {
    title: Todo.title
    due_at: Todo.due_at default none
}

input DisableUser {
    user_id: User.id
}

value TodoCursor {
    created_at: Todo.created_at
    id: Todo.id
}

output TodoView {
    id: Todo.id
    title: Todo.title
    status: Todo.status
    due_at: Todo.due_at
    created_at: Todo.created_at
    updated_at: Todo.updated_at
}

output TodoPage {
    items: List<TodoView>
    next: TodoCursor?
}

output UserWithTodos {
    user_id: User.id
    todos: List<TodoView>
}

input UserTodoPageStart {
    after: TodoCursor optional
}

output PublicHealth {
    status: HealthStatus
}

value ReminderMessage {
    idempotency_key: ReminderIntentId
    from: Email
    to: User.email
    todo_title: Todo.title
    due_at: Todo.due_at
}

value ReminderReceipt {
    accepted_at: Instant
}
