use lettings/types { RentPayment, SignedWebhook, WeeklyRent }
use lettings/failures { WebhookRefused }
use lettings/actions { acknowledge_payment }

test "a webhook signed with the shared secret is read" {
    // Each test run makes its own throwaway secret, so the test signs its
    // webhook the way the office signs its own.
    var acknowledgement: SignedWebhook = acknowledge_payment(
        RentPayment {
            tenancy_ref: "T-1042"
            paid: WeeklyRent(money.from_minor(25000, Currency.gbp))
        }
    )
    assert acknowledgement.body == "{\"tenancy_ref\":\"T-1042\",\"paid\":{\"amount\":25000,\"currency\":\"GBP\"}}"
    var payment: RentPayment = attempt rent_paid(acknowledgement.body, acknowledgement.webhook_mac)
    assert payment.paid == WeeklyRent(money.from_minor(25000, Currency.gbp))
}

test "a webhook whose body was changed is refused" {
    var acknowledgement: SignedWebhook = acknowledge_payment(
        RentPayment {
            tenancy_ref: "T-1042"
            paid: WeeklyRent(money.from_minor(25000, Currency.gbp))
        }
    )
    assert rent_paid(
        "{\"tenancy_ref\":\"T-1042\",\"paid\":{\"amount\":99999,\"currency\":\"GBP\"}}",
        acknowledgement.webhook_mac
    ) fails WebhookRefused
}
