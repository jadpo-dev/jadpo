// Passwords are never stored: the office keeps each one's hash, and
// checks a password typed at sign-in against it (`staff_sign_in`).

use lettings/types { StaffPassword }

/// The hash a member of staff's new password is stored as: Argon2id,
/// with a fresh random salt, so only an action may make one.
action set_password(typed_password: StaffPassword) -> PasswordHash {
    return crypto.hash_password(typed_password)
}
