use lettings/types { CertificateSummary }
use lettings/failures { CertificateUnreadable }

test "the council's certificate is read from its DER" {
    var summary: CertificateSummary = attempt council_certificate(
        ""
    )
    assert summary.subject == "CN=jadpo-test.example,O=Jadpo Test\\, Signing,C=GB"
    assert summary.valid_until == "2036-10-01T00:00:00Z"
    assert council_certificate("not base64!") fails CertificateUnreadable
}
