use lettings/types { SignedReceipt, WeeklyRent }
use lettings/actions { check_receipt, receipt_key }

test "a receipt checks with the office's public key" {
    var receipt_issued: SignedReceipt = issue_receipt(
        "T-1042",
        WeeklyRent(money.from_minor(25000, Currency.gbp))
    )
    assert receipt_issued.receipt == "Harbour Lettings received GBP 250.00 for tenancy T-1042."
    assert check_receipt(receipt_issued.receipt, receipt_issued.office_signature, receipt_key())
    assert not check_receipt(
        "Harbour Lettings received GBP 999.99 for tenancy T-1042.",
        receipt_issued.office_signature,
        receipt_key()
    )
}

test "another office's key doesn't check the office's receipts" {
    // RFC 8032's first test key: a public key, so not a secret.
    var receipt_issued: SignedReceipt = issue_receipt(
        "T-1042",
        WeeklyRent(money.from_minor(25000, Currency.gbp))
    )
    assert not check_receipt(
        receipt_issued.receipt,
        receipt_issued.office_signature,
        "11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo"
    )
}

test "a receipt names the office the deployment sets" {
    config: {
        office_name: "Quayside Homes"
    }
    assert issue_receipt(
        "T-1042",
        WeeklyRent(money.from_minor(25000, Currency.gbp))
    ).receipt == "Quayside Homes received GBP 250.00 for tenancy T-1042."
}
