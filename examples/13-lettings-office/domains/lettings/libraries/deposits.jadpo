// A constant: a value fixed in the code, the same in every deployment,
// worked out while compiling. A law sets this cap, not an operator, so it
// is a constant rather than a setting. Code reads it as
// `deposits.cap_weeks`, and inside the library by its name.

use lettings/types { DepositAmount, DepositWeeks, WeeklyRent }

/// What the office may take as a deposit.
library deposits {
    /// The most weeks' rent a deposit may be: the cap the Tenant Fees Act
    /// 2019 sets while a year's rent is under £50,000.
    constant cap_weeks: DepositWeeks = 5

    /// The largest deposit the office may take for `rent`.
    function largest_deposit(rent: WeeklyRent) -> DepositAmount {
        return DepositAmount(rent * cap_weeks)
    }
}
