// Generated by Jadpo from the routes of API main; update it with `jadpo api update`, never by hand.
record api 1

api main
    authentication browser_session

POST /account/sign-up
    authentication none
    input SignUp (body)
    status 204
    fails handle_taken

GET /bakeries
    output List<BakeryView>
    status 200

POST /bakeries
    caller user
    input NewBakery (body)
    output BakeryView
    status 201

GET /bakeries/{bakery_id: Uuid}/recipes
    output List<RecipeCard>
    status 200

POST /bakeries/{bakery_id: Uuid}/recipes
    caller user
    input WriteRecipe (body)
    output RecipeCard
    status 201
    fails bakery_not_found

GET /bakeries/{bakery_id: Uuid}/staff
    output List<StaffView>
    status 200

POST /bakeries/{bakery_id: Uuid}/staff
    input NewStaff (body)
    output StaffView
    status 201
    fails baker_not_found
    fails bakery_not_found

GET /ingredients
    output List<IngredientView>
    status 200

POST /ingredients
    input ListIngredient (body)
    output IngredientView
    status 201
    fails ingredient_listed

GET /openapi.json
    generated openapi
    status 200

PATCH /recipes/{recipe_id: Uuid}
    input RenameRecipe (body)
    output RecipeCard
    status 200
    fails recipe_not_found

PUT /recipes/{recipe_id: Uuid}/cost
    input CostRecipe (body)
    output RecipeCosting
    status 200
    fails recipe_not_found

POST /recipes/{recipe_id: Uuid}/hand-over
    input HandOver (body)
    output RecipeCard
    status 200
    fails baker_not_found
    fails recipe_not_found

DELETE /staff/{staff_id: Uuid}
    status 204
    fails staff_member_not_found

output BakeryView
    id: Uuid
    name: Text { min_length: 1, max_length: 80 }

input CostRecipe
    batch_cost: Money { min: 0, currency: GBP, rounding: half_even }

input HandOver
    to: Uuid

enum Hazard
    variant eggs
    variant gluten
    variant milk
    variant nuts

output IngredientView
    allergen: Hazard?
    id: Uuid
    name: Text { min_length: 1, max_length: 60 }

input ListIngredient
    allergen: Hazard optional
    name: Text { min_length: 1, max_length: 60 }

input NewBakery
    name: Text { min_length: 1, max_length: 80 }

input NewStaff
    baker_id: Uuid
    role: StaffRole

output RecipeCard
    author_id: Uuid
    id: Uuid
    name: Text { min_length: 1, max_length: 80 }

output RecipeCosting
    batch_cost: Money { min: 0, currency: GBP, rounding: half_even }
    id: Uuid
    name: Text { min_length: 1, max_length: 80 }

input RenameRecipe
    name: Text { min_length: 1, max_length: 80 }

input SignUp
    handle: Text { min_length: 3, max_length: 40 }

enum StaffRole
    variant baker
    variant counter
    variant owner

output StaffView
    baker_id: Uuid
    id: Uuid
    role: StaffRole

input WriteRecipe
    name: Text { min_length: 1, max_length: 80 }

failure baker_not_found
    status 404

failure bakery_not_found
    status 404

failure handle_taken
    status 409
    message "That handle is taken."

failure ingredient_listed
    status 409
    message "That ingredient is already seen."

failure recipe_not_found
    status 404

failure staff_member_not_found
    status 404
