// Generated by Jadpo from who can do what; update it with `jadpo records update`, never by hand.
record access 1

tenant Bakery

entity kitchen.Baker
    create Access.public
    read id
    shared

entity kitchen.Bakery
    read StaffRole.baker
    read StaffRole.counter
    read StaffRole.owner
    update StaffRole.owner
    tenant id

entity kitchen.Ingredient
    create PlatformRole.editor
    read Access.authenticated
    update PlatformRole.editor
    shared

entity kitchen.PlatformStaff
    read baker_id
    shared

entity kitchen.Recipe
    create StaffRole.baker
    create StaffRole.owner
    read StaffRole.baker
    read StaffRole.counter
    read StaffRole.owner
    update StaffRole.owner
    update author_id
    delete StaffRole.owner
    tenant bakery_id

field kitchen.Recipe.batch_cost
    read StaffRole.owner
    update StaffRole.owner

field kitchen.Recipe.old_reference
    server_only

entity kitchen.StaffMember
    create StaffRole.owner
    read StaffRole.owner
    read baker_id
    update StaffRole.owner
    delete StaffRole.owner
    delete baker_id
    tenant bakery_id

action kitchen.hand_over_recipe
