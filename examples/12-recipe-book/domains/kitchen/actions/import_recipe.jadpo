// The import from a bakery's old system runs on the server, never from a
// request, so it may set `old_reference`, which no request may. No route
// runs it; a call with no caller, such as a test's, runs without policy.

use kitchen/entities { Baker, BakerNotFound, Bakery, BakeryNotFound, Recipe }
use kitchen/types { OldReference, RecipeName, Sterling }

/// Brings a recipe over from the bakery's old system.
action import_recipe(
    bakery_id: Bakery.id,
    author_id: Baker.id,
    name: RecipeName,
    batch_cost: Sterling,
    old_reference: OldReference
) fails BakeryNotFound, BakerNotFound -> Recipe {
    return attempt Recipe.create {
        set: {
            bakery_id: bakery_id
            author_id: author_id
            name: name
            batch_cost: batch_cost
            old_reference: old_reference
        }
    }
}
