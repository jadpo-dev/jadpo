/// `card` emptied, once its free coffee has been given.
action redeem_card(card: Card) fails CardNotFull -> Card {
    if (stamps_to_go(card) > 0) {
        reject CardNotFull {
            stamps: card.stamps
        }
    }
    return Card {
        holder: card.holder
        stamps: 0
    }
}

/// How many more stamps `card` needs before it can be redeemed.
function stamps_to_go(card: Card) -> Stamps {
    // `card.stamps` is 0 to 10, so `10 - card.stamps` is too, and the
    // compiler proves it fits `Stamps`.
    return Stamps(10 - card.stamps)
}
