// Tagged unions: an enum whose variants carry fields of their own. Each
// value is exactly one variant and has only that variant's fields, so
// there is no way to read a delivery address on an order collected in
// the shop.

use sales/types { Pence }

/// What `handover` adds to the bill, and where to deliver, if anywhere.
action choose_handover(handover: Handover) -> HandoverCharge {
    // The only way to read a variant's fields is to `match` on it. The
    // name in brackets, `delivery(chosen)`, binds that variant's fields,
    // read as `chosen.address`.
    return match handover {
        Handover.in_shop -> HandoverCharge {
            fee: 0
            deliver_to: none
        }
        Handover.delivery(chosen) -> HandoverCharge {
            fee: chosen.fee
            deliver_to: chosen.address
        }
        // A pattern without brackets matches the variant without reading
        // its fields.
        Handover.locker -> HandoverCharge {
            fee: 50
            deliver_to: none
        }
    }
}

/// A street address for deliveries.
type StreetAddress = Text {
    min_length: 5
    max_length: 120
}

/// The code that opens a collection locker.
type LockerCode = Text {
    pattern: "[0-9]{4}"
}

/// How a customer gets their cake. A variant with fields is written
/// `name: { ... }`; one without is just its name.
type Handover = Enum {
    in_shop
    delivery: {
        address: StreetAddress
        fee: Pence
    }
    locker: {
        code: LockerCode
    }
}

/// What a handover choice adds to the bill.
type HandoverCharge = Object {
    fee: Pence
    // `Handover.delivery.address` is the type of the `address` field of
    // the `delivery` variant: payload fields have field types too.
    deliver_to: Handover.delivery.address?
}
