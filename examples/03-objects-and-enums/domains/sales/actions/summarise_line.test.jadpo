use sales/types { CakeLine, Sterling }

test "a receipt line multiplies the price by the count" {
    var line: CakeLine = CakeLine {
        cake: "Victoria sponge"
        count: 3
        each: CakeLine.each(money.from_minor(2000, Currency.gbp))
    }
    assert summarise_line(line) == LineReceipt {
        cake: "Victoria sponge"
        each: CakeLine.each(money.from_minor(2000, Currency.gbp))
        total: Sterling(money.from_minor(6000, Currency.gbp))
    }
}
