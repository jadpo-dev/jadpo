// Values never change. Passing an object to a function or returning it
// never lets anyone else change it, and fields can't be assigned: to
// change an object, build a new one from the old one's fields.

use sales/types { CakeLine }

/// A copy of `change.line` at its new price, or at half price when the
/// change gives none.
action reprice_line(change: Reprice) -> CakeLine {
    // A value that may be absent is read with `match`: `some(each)` when
    // there is one, naming it `each`, and `none` when there isn't.
    return match change.each {
        some(each) -> CakeLine {
            cake: change.line.cake
            count: change.line.count
            each: each
        }
        none -> half_price(change.line)
    }
}

/// A price change: the line to change and its new price per cake, left
/// out for cakes left at closing time, which go at half price.
type Reprice = Object {
    line: CakeLine
    each: CakeLine.each?
}

/// `line` at half price: half of each cake's price, rounded down to the
/// penny.
function half_price(line: CakeLine) -> CakeLine {
    // `line.each / 2` is a plain `Int`, and a field needs a value of its
    // own type, so `CakeLine.each(...)` uses the field as a constructor:
    // it checks the value against the field's rules (`Pence`'s `min: 0`
    // and the field's `max: 6000`) and gives it the field's type. Half of
    // a price that fits is from 0 to 3000, so the compiler proves this
    // check can't fail.
    return CakeLine {
        cake: line.cake
        count: line.count
        each: CakeLine.each(line.each / 2)
    }
}
