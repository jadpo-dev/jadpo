// Values that arrive from outside, values sent back, and values that may
// be absent.

// An enum is a closed list of named alternatives, its variants. A variant
// is always written with its enum's name: `CakeSize.large`.

use sales/types { CakeLine, CakeName }

/// How big a cake is.
type CakeSize = Enum {
    small
    medium
    large
}

/// How many candles go on top.
type CandleCount = Int {
    min: 0
    max: 100
}

/// Words iced on top of a cake.
type Icing = Text {
    max_length: 30
}

// Some values have no literal, so here they only arrive from outside: a
// photo is `Bytes`, and a moment seen in a time zone is a `ZonedTime`,
// sent as its instant and its zone. They can still be declared, received
// and sent back.

/// A photo of the cake a customer wants copied.
type CakePhoto = Bytes {
    max_length: 2000000
}

/// When a customer will collect, in the shop's time zone.
type CollectAt = ZonedTime {}

/// An allergy a customer tells the bakery about.
type Allergen = Text {
    max_length: 30
}

/// How strongly a customer reacts to an allergen.
type Reaction = Enum {
    mild
    severe
}

// An `Input` is an object that arrives from outside, such as a request
// body. It is the only kind of object whose fields may be left out:
// `optional: true` lets the sender leave a field out, and reading it gives
// `T?`, which is `none` when it was left out; `default:` fills in a value
// instead, checked against the field's rules while compiling.

/// What a customer asks for when ordering a cake.
type CakeRequest = Input {
    cake: CakeName
    size: CakeSize {
        default: CakeSize.medium
    }
    candles: CandleCount {
        default: 0
    }
    icing: Icing {
        optional: true
    }
    photo: CakePhoto {
        optional: true
    }
    collect_at: CollectAt {
        optional: true
    }
    // A `Map` holds values by key. Maps arrive from outside as JSON
    // objects, so a map in an `Input` or `Output` is keyed by text. There
    // is no map literal yet, and `for` and the `collection` operations take
    // only lists so far (example 04), so a map can be received, passed on,
    // compared with `==` and sent back, but not yet walked or searched.
    allergies: Map<Allergen, Reaction> {
        optional: true
    }
}

// An `Output` is an object sent back, such as a response. It may hold
// other objects: here a whole `CakeLine`.

/// What the bakery quotes for a cake, with the details the customer gave
/// read back to them to confirm.
type CakeQuote = Output {
    line: CakeLine
    // `T?` is a type that may hold `none`. A nullable field is still
    // required: building a `CakeQuote` must say `icing: none` out loud.
    icing: Icing?
    candles: CandleCount
    collect_at: CollectAt?
    allergies: Map<Allergen, Reaction>?
}

// Every field is a type of its own, written `Owner.field`: here
// `CakeLine.each` is `Pence` with the field's `max: 6000` added. Returning
// it, rather than `Pence`, lets `quote_cake` build a `CakeLine` that the
// compiler knows is valid; a plain `Pence` might be over £60.

/// The price of one cake of `size`.
function size_price(size: CakeSize) -> CakeLine.each {
    // `match` chooses between the cases of a value and must cover every
    // one; here it gives a value, one for each variant. Example 05 shows
    // every form of `match`.
    return match size {
        CakeSize.small -> 1800
        CakeSize.medium -> 2600
        CakeSize.large -> 3800
    }
}

/// The quote for one cake as `request` describes it.
action quote_cake(request: CakeRequest) -> CakeQuote {
    // An object value is written with its type's name and every field.
    // Unknown fields and missing fields are errors.
    var line: CakeLine = CakeLine {
        cake: request.cake
        count: 1
        each: size_price(request.size)
    }
    // The quote reads the customer's choices back to them, the allergies
    // above all, so a mistake is caught before anything is baked. The
    // photo isn't sent back: the customer already has it, and the
    // decorator reads it from the order once orders are stored (area 5).
    return CakeQuote {
        line: line
        icing: request.icing
        candles: request.candles
        collect_at: request.collect_at
        allergies: request.allergies
    }
}
