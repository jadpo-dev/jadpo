test "collecting in the shop is free" {
    assert choose_handover(Handover.in_shop).fee == 0
}

test "a delivery charges its fee and says where to go" {
    // A variant with fields is built like an object, after its name.
    var delivery: Handover = Handover.delivery {
        address: "12 Mill Lane"
        fee: 450
    }
    var charge: HandoverCharge = choose_handover(delivery)
    assert charge.fee == 450
    assert charge.deliver_to == "12 Mill Lane"
}

test "a locker costs 50 pence" {
    var locker: Handover = Handover.locker {
        code: "4821"
    }
    assert choose_handover(locker) == HandoverCharge {
        fee: 50
        deliver_to: none
    }
}
