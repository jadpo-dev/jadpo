// Building a type from other types. Most objects in an application are
// slices of another: a view that shows some fields, a change where every
// field may be left out. Instead of writing each field out again, a
// type's body can copy fields, read from top to bottom:
//
//   include: [T]      adds every field of T (never on an `Input`)
//   pick: [T.a, T.b]  adds just those fields, keeping their names
//   omit: [T.a]       removes a field that is there at that point
//   a: SomeType       a written field: adds one, or replaces one above
//   optional: all     on an `Input`, makes every field optional
//
// Copied fields follow their source: their types and rules come with
// them, and renaming `CakeLine.cake` renames it everywhere it is copied.
// `show_on_menu.jadpo` and `change_line.jadpo` use `pick` and
// `optional: all`.

use sales/types { CakeLine, Sterling }

/// A line as the receipt prints it.
type LineReceipt = Output {
    include: [CakeLine]
    omit: [CakeLine.count]
    // A written field replaces a copied field of the same name, visibly:
    // the receipt's `each` is a plain `Sterling`, without the line's £60 limit.
    each: Sterling
    total: Sterling
}

/// The receipt line for `line`.
action summarise_line(line: CakeLine) -> LineReceipt {
    return LineReceipt {
        cake: line.cake
        each: line.each
        total: Sterling(line.each * line.count)
    }
}
