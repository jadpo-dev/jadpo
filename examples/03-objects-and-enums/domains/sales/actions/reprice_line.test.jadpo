use sales/types { CakeLine, Sterling }

test "repricing builds a new line and leaves the old one alone" {
    var before: CakeLine = CakeLine {
        cake: "Carrot"
        count: 2
        each: CakeLine.each(money.from_minor(2400, Currency.gbp))
    }
    var after: CakeLine = reprice_line(
        Reprice {
            line: before
            each: CakeLine.each(money.from_minor(2200, Currency.gbp))
        }
    )
    assert after.each == Sterling(money.from_minor(2200, Currency.gbp))
    assert before.each == Sterling(money.from_minor(2400, Currency.gbp))
    // Same cake and count, different price: not equal.
    assert after != before
}

test "half price rounds down and equals a line built with the same fields" {
    var line: CakeLine = CakeLine {
        cake: "Carrot"
        count: 2
        each: CakeLine.each(money.from_minor(2401, Currency.gbp))
    }
    var end_of_day: Reprice = Reprice {
        line: line
        each: none
    }
    // `==` compares contents, so the line `reprice_line` builds equals one
    // written out separately with the same fields.
    assert reprice_line(end_of_day) == CakeLine {
        cake: "Carrot"
        count: 2
        each: CakeLine.each(money.from_minor(1200, Currency.gbp))
    }
}
