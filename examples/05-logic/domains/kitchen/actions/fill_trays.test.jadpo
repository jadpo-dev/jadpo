test "a part-filled tray still counts" {
    assert fill_trays(100, 24).trays == 5
    assert fill_trays(96, 24).trays == 4
    assert fill_trays(0, 24).trays == 0
}

test "the last tray holds what whole trays leave over" {
    assert fill_trays(100, 24) == TrayPlan {
        trays: 5
        last_tray: 4
    }
    assert fill_trays(96, 24).last_tray == 0
}
