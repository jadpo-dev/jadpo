test "bread keyed in for the top shelf is turned down and browns" {
    assert set_oven("BREAD", 2, true) == OvenSetting {
        temperature: 210degC
        crust: Crust.browned
        steam: "steam on"
    }
}

test "the oven sets nothing for a bake it doesn't know" {
    assert set_oven("TOAST", 0, false) == none
}

test "bread is turned down on the upper shelves" {
    assert turned_down(Bake.bread, 2) == 210degC
    assert turned_down(Bake.bread, 1) == 220degC
    assert turned_down(Bake.bread, 0) == 230degC
}

test "pastry is turned down above the middle, meringue never" {
    assert turned_down(Bake.pastry, 1) == 190degC
    assert turned_down(Bake.pastry, -1) == 200degC
    assert turned_down(Bake.meringue, 2) == 100degC
}

test "the lowest and highest shelves change the crust" {
    assert crust_on(-2) == Crust.pale
    assert crust_on(2) == Crust.browned
    assert crust_on(0) == Crust.golden
}

test "steam is shown as a word" {
    assert steam_word(true) == "steam on"
    assert steam_word(false) == "steam off"
}
