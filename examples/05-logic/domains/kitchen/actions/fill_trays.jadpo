// Division. `/` divides two values of the same named type: between whole
// numbers it drops the remainder, between decimals it is exact. When the
// two sides are different types, or the answer must round another way,
// the standard library says how: `integer.divide` and `decimal.divide`
// take a `rounding:`.
//
// Dividing by zero can't happen in Jadpo. The divisor's type must exclude
// zero (a literal divisor must not be 0), so the compiler rules it out
// before the program runs.

/// How many buns are baked.
type BunCount = Int {
    min: 0
    max: 5000
}

/// How many buns fit on one tray. Never zero, so it can be a divisor.
type TrayCapacity = Int {
    min: 1
    max: 48
}

/// How many trays a bake needs.
type TrayCount = Int {
    min: 0
    max: 5000
}

/// How many trays `buns` buns need, `per_tray` to a tray: a part-filled
/// tray still counts, so the division rounds up.
action fill_trays(buns: BunCount, per_tray: TrayCapacity) -> TrayCount {
    // Standard-library operations are the only calls that take named
    // arguments: `rounding:` says which way, and makes the call read
    // plainly. `Rounding.up` rounds away from zero. The compiler knows a
    // division of a count never below zero by a divisor of at least 1 is
    // from zero up to the count, so `TrayCount(...)` can't fail.
    return TrayCount(integer.divide(buns, per_tray, rounding: Rounding.up))
}

/// How many buns are left over after filling only whole trays.
function left_over(buns: BunCount, per_tray: TrayCapacity) -> BunCount {
    return BunCount(buns % per_tray)
}

/// A price in pounds and pence.
type Price = Decimal {
    scale: 2
    min: 0.00
}

/// How many people share a bill.
type Diners = Int {
    min: 1
    max: 20
}

/// Each person's share of `bill`. The share keeps the bill's two places,
/// and a half penny goes to the even penny (banker's rounding), so
/// rounding errors don't all lean one way.
function share(bill: Price, diners: Diners) -> Price {
    return Price(decimal.divide(bill, diners, rounding: Rounding.half_even))
}

/// The same share, with a half penny always rounded up, as a till does.
function till_share(bill: Price, diners: Diners) -> Price {
    return Price(decimal.divide(bill, diners, rounding: Rounding.half_up))
}
