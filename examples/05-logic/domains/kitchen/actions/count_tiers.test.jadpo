test "a three-tier cake counts every tier" {
    var top_tier: Tier = Tier {
        name: "Top"
        above: []
    }
    var middle: Tier = Tier {
        name: "Middle"
        above: [top_tier]
    }
    var base: Tier = Tier {
        name: "Base"
        above: [middle]
    }
    assert count_tiers(base) == 3
    assert tiers_above(middle) == 1
}

test "two tiers can rest side by side on one" {
    var cupcake: Tier = Tier {
        name: "Cupcake"
        above: []
    }
    var cake_stand: Tier = Tier {
        name: "Stand"
        above: [cupcake, cupcake]
    }
    assert count_tiers(cake_stand) == 3
}
