test "a wet dough at the right temperature, kneaded ten minutes, is ready" {
    assert mix_dough(1000, 700, 25, 10, false)
}

test "resting stands in for kneading" {
    assert mix_dough(1000, 700, 25, 3, true)
    assert not mix_dough(1000, 700, 25, 3, false)
}

test "a dry dough or cold water isn't ready" {
    assert not mix_dough(1000, 600, 25, 10, false)
    assert not mix_dough(1000, 700, 18, 10, false)
}

test "differences have a sign" {
    assert water_difference(30) == 4
    assert water_difference(20) == -6
}

test "water 4 degrees too cold is close enough, 5 isn't" {
    assert mix_dough(1000, 700, 22, 10, false)
    assert not mix_dough(1000, 700, 21, 10, false)
}
