// Generated by Jadpo from the routes of API main; update it with `jadpo api update`, never by hand.
record api 1

api main
    authentication browser_session

GET /auth/google/callback
    generated provider sign-in
    authentication none
    redirect return_to
    status 303

POST /auth/google/start
    generated provider sign-in
    authentication none
    input ProviderSignInStart (body)
    output ProviderSignInAddress
    status 200

POST /auth/magic-link
    generated magic link
    authentication none
    input MagicLinkAsk (body)
    status 202

POST /auth/magic-link/confirm
    generated magic link
    authentication none
    input MagicLinkConfirmation (body)
    output MagicLinkConfirmed
    status 200

GET /books
    output List<CatalogueBook>
    status 200

GET /me/loans
    caller user
    output List<LoanView>
    status 200

GET /openapi.json
    generated openapi
    status 200

POST /staff/books
    input NewBook (body)
    output StockBook
    status 201

GET /staff/donations
    output List<DonatedBook>
    status 200

POST /staff/loans
    input Lending (body)
    output LoanView
    status 201
    fails book_not_found
    fails book_on_loan
    fails no_such_customer

DELETE /staff/loans/{loan_id: Uuid}
    status 204
    fails loan_not_found

GET /staff/stock
    output List<StockBook>
    status 200

output CatalogueBook
    author: Text { min_length: 1, max_length: 120 }
    id: Uuid
    title: Text { min_length: 1, max_length: 200 }

output DonatedBook
    donor: Text { min_length: 1, max_length: 80 }?
    id: Uuid
    title: Text { min_length: 1, max_length: 200 }

input Lending
    book_id: Uuid
    borrower: Email

output LoanView
    book_id: Uuid
    due_at: Instant
    id: Uuid

output MagicLinkConfirmed
    return_to: Text

input NewBook
    author: Text { min_length: 1, max_length: 120 }
    donor: Text { min_length: 1, max_length: 80 }?
    shelf: Text { min_length: 1, max_length: 20 }
    title: Text { min_length: 1, max_length: 200 }

output ProviderSignInAddress
    address: Url

input ProviderSignInStart
    return_to: Text optional

output StockBook
    id: Uuid
    shelf: Text { min_length: 1, max_length: 20 }
    title: Text { min_length: 1, max_length: 200 }

failure book_not_found
    status 404

failure book_on_loan
    status 409
    message "That book is out on loan."

failure loan_not_found
    status 404

failure no_such_customer
    status 404
    message "No customer has signed in with that address."
