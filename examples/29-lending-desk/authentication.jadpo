// Two ways in, one session. Customers sign in with a link, or the code
// beside it, emailed to them; staff sign in with Google, through routes
// Jadpo writes under `/auth/google`. Either ends in the same browser
// session.
//
// `on_first_sign_in:` decides for both, the first time someone signs in
// whom the desk has no record for: a customer is made, and a Google
// account is linked to the member of staff with its address.

use desk

authentication {
    browser_session: {
        cookie: "desk_session"
        origin: config.site
    }
    sign_in: {
        magic_link: {
            link: "/sign-in/confirm"
        }
        providers: [google]
    }
    on_first_sign_in: desk.meet_newcomer
}
