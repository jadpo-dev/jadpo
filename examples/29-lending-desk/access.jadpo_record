// Generated by Jadpo from who can do what; update it with `jadpo records update`, never by hand.
record access 1

entity desk.Book
    create StaffRole.admin
    read Access.authenticated
    read Access.system
    update StaffRole.admin

field desk.Book.donor
    read StaffRole.admin

field desk.Book.shelf
    read StaffRole.admin
    read StaffRole.front_desk

entity desk.Loan
    create StaffRole.admin
    create StaffRole.front_desk
    read Access.system
    read StaffRole.admin
    read StaffRole.front_desk
    read borrower_id
    update Access.system
    delete StaffRole.admin
    delete StaffRole.front_desk

entity desk.Patron
    create Access.system
    read Access.system
    read StaffRole.admin
    read StaffRole.front_desk
    read id
    update Access.system

entity desk.StaffMember
    create StaffRole.admin
    read Access.system
    read StaffRole.admin
    read patron_id
    delete StaffRole.admin

query desk.donations
    who StaffRole.admin

query desk.stock
    who StaffRole.admin
    who StaffRole.front_desk

role desk.StaffRole.admin
    sign_in SignInMethod.google
    strength AuthenticationStrength.multi_factor

role desk.StaffRole.front_desk
    sign_in SignInMethod.google

sign_in magic_link
    code_attempts: 5
    expires_after: 15m
    failed_codes_per_day: 20
