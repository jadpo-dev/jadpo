// Whole numbers (`Int`) and yes-or-no values (`Bool`).

use pantry/types { Grams }

/// Weighs a delivery of flour and says whether it needs cooling.
action weigh_flour(each: Grams, sacks: SackCount, temperature: Celsius) -> NeedsCooling {
    var weight: Grams = total_weight(each, sacks)
    // A literal takes the type it goes into: here `100000` is a `Grams`.
    var heavy: Bool = weight > 100000
    return NeedsCooling(heavy or needs_cooling(temperature))
}

/// How many sacks of flour arrived. `min` and `max` are inclusive, so a
/// delivery holds from 1 to 40 sacks.
type SackCount = Int {
    min: 1
    max: 40
}

/// A storage temperature. Rules may allow negative numbers.
type Celsius = Int {
    min: -30
    max: 60
}

// A type built on `Bool` gives a yes-or-no answer a meaning, so a
// function's result says what it is, not just that it is true.

/// Whether the flour must go in the cold store.
type NeedsCooling = Bool {}

/// The total weight of `sacks` sacks of `each` grams.
function total_weight(each: Grams, sacks: SackCount) -> Grams {
    // `each * sacks` multiplies a `Grams` by a `SackCount`, which is fine:
    // `*` may mix types, because a weight times a count is a weight.
    // The result is a plain `Int`; `Grams(...)` checks it against `Grams`'
    // rules. Both sides are at least 0, so the product is too, and the
    // compiler proves this can't fail.
    return Grams(each * sacks)
}

/// Whether flour kept at `temperature` must move to the cold store.
function needs_cooling(temperature: Celsius) -> NeedsCooling {
    // A comparison gives a plain `Bool`; wrapping it in `NeedsCooling`
    // says what the answer means.
    return NeedsCooling(temperature > 25)
}
