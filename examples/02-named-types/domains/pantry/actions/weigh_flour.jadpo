// Whole numbers (`Int`), quantities with a unit (`Mass`, `Temperature`) and
// yes-or-no values (`Bool`).

use pantry/types { SackWeight }

/// How many sacks of flour arrived. `min` and `max` are inclusive, so a
/// delivery holds from 1 to 40 sacks.
type SackCount = Int {
    min: 1
    max: 40
}

/// A storage temperature. Rules may allow negative temperatures.
type StoreTemperature = Temperature {
    min: -30degC
    max: 60degC
}

// A type built on `Bool` gives a yes-or-no answer a meaning, so a
// function's result says what it is, not just that it is true.

/// Whether the flour must go in the cold store.
type NeedsCooling = Bool {}

/// The total weight of `sacks` sacks weighing `each`.
function total_weight(each: SackWeight, sacks: SackCount) -> SackWeight {
    // `each * sacks` multiplies a `SackWeight` by a `SackCount`, which is
    // fine: `*` may mix types, because a weight times a count is a weight.
    // The result is a plain `Mass`; `SackWeight(...)` checks it against
    // `SackWeight`'s rules. Both sides are at least 0, so the product is
    // too, and the compiler proves this can't fail.
    return SackWeight(each * sacks)
}

/// Whether flour kept at `temperature` must move to the cold store.
function needs_cooling(temperature: StoreTemperature) -> NeedsCooling {
    // A comparison gives a plain `Bool`; wrapping it in `NeedsCooling`
    // says what the answer means.
    return NeedsCooling(temperature > 25degC)
}

/// Weighs a delivery of flour and says whether it needs cooling.
action weigh_flour(
    each: SackWeight,
    sacks: SackCount,
    temperature: StoreTemperature
) -> NeedsCooling {
    var weight: SackWeight = total_weight(each, sacks)
    // A quantity literal carries its unit: `100kg` is a `Mass`, compared
    // with `weight` whatever unit each was written in.
    var heavy: Bool = weight > 100kg
    return NeedsCooling(heavy or needs_cooling(temperature))
}
