// Money (`Money`): an exact amount in one currency, never a bare decimal.
// A decimal number is exact, never binary floating point, and an amount of
// money is held as whole pence with its currency, so it adds up to the
// penny.

use pantry/types { SackWeight }

/// A price per kilogram of flour. `currency:` fixes the currency, so an
/// amount in euros doesn't compile where one is wanted, and `rounding:`
/// says which way a half penny goes. Money has no literal: an amount is
/// built from its minor units, `money.from_minor(120, Currency.gbp)` for
/// £1.20.
type KiloPrice = Money {
    currency: Currency.gbp
    rounding: Rounding.half_even
}

/// What a delivery costs.
type DeliveryCost = Money {
    currency: Currency.gbp
    rounding: Rounding.half_even
}

/// What flour weighing `weight` costs at `per_kilo`, to the nearest penny.
action price_flour(weight: SackWeight, per_kilo: KiloPrice) -> DeliveryCost {
    // `/` divides two quantities of one kind, `2.5kg / 1kg`, and gives the
    // plain `Decimal` 2.5. A price times a decimal is a price, rounded
    // to a penny the way `KiloPrice` says, and `DeliveryCost(...)` builds
    // the cost from it.
    return DeliveryCost(per_kilo * (weight / 1kg))
}
