test "flour is charged by the kilogram" {
    // £1.20 a kilogram: 2.5 kilograms cost exactly £3.00.
    var per_kilo: KiloPrice = KiloPrice(money.from_minor(120, Currency.gbp))
    assert price_flour(2500g, per_kilo) == DeliveryCost(money.from_minor(300, Currency.gbp))
}

test "a part kilogram is charged to the nearest penny" {
    // 999 grams at £1.20 is £1.1988, which rounds to £1.20.
    var per_kilo: KiloPrice = KiloPrice(money.from_minor(120, Currency.gbp))
    assert price_flour(999g, per_kilo) == DeliveryCost(money.from_minor(120, Currency.gbp))
}
