// Time: built-in types that hold moments, days and lengths of time.

/// Whether a delivery can go on the shelf: it arrived before the day's
/// `cutoff`, its flour is good after `today`, and the proving time printed
/// on the sack is one the bakery can use.
action check_delivery(
    arrived: ArrivedAt,
    cutoff: Cutoff,
    best_before: BestBefore,
    today: BakeryDay,
    proving: ProvingTime
) -> Shelvable {
    // Moments, days and durations are ordered, so `<`, `<=`, `>` and `>=`
    // work on them as on numbers. Text has no order.
    return Shelvable(arrived < cutoff and best_before > today and proving <= 2h)
}

// Time: an `Instant` is a moment, written in ISO 8601 with its offset; a
// `CalendarDate` is a day with no time or zone; a `Duration` is a length
// of time, written with a unit (`45m`, `2h`), and its bounds are written
// the same way.

/// A moment by the bakery's clock.
type ShopTime = Instant {}

// `ArrivedAt` and `Cutoff` are both moments, but they mean different
// things, so each is its own type and one can't be passed for the other.
// Both are built on `ShopTime`, though, and that is what lets them be
// compared: `<` orders two values of the same type, and each widens to
// `ShopTime`. Two types built straight on `Instant` would share nothing
// but the representation, and comparing them would be an error.

/// When the delivery arrived.
type ArrivedAt = ShopTime {}

/// The latest a delivery can arrive and still be shelved that day.
type Cutoff = ShopTime {}

/// A day in the bakery's calendar, such as today.
type BakeryDay = CalendarDate {}

/// The last day the flour is good. Built on `BakeryDay`, so it can be
/// compared with today.
type BestBefore = BakeryDay {}

/// How long the dough proves, between 30 minutes and 4 hours.
type ProvingTime = Duration {
    min: 30m
    max: 4h
}

/// Whether a delivery can go on the shelf.
type Shelvable = Bool {}
