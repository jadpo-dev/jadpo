// Literals for moments and days are text, checked while compiling: a
// moment needs its offset (`Z` here), and a day is `YYYY-MM-DD`. A
// duration is a number with a unit: `ms`, `s`, `m`, `h` or `d`.

test "fresh flour that arrived on time goes on the shelf" {
    assert check_delivery(
        "2026-03-02T07:45:00Z",
        "2026-03-02T09:00:00Z",
        "2026-06-30",
        "2026-03-02",
        90m
    )
}

test "a late delivery waits for tomorrow" {
    var late: ArrivedAt = "2026-03-02T09:30:00Z"
    assert not check_delivery(late, "2026-03-02T09:00:00Z", "2026-06-30", "2026-03-02", 90m)
}

test "a proving time over two hours is refused" {
    assert not check_delivery(
        "2026-03-02T07:45:00Z",
        "2026-03-02T09:00:00Z",
        "2026-06-30",
        "2026-03-02",
        3h
    )
}
