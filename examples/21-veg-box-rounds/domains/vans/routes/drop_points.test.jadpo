use vans/entities { DropPoint }
use vans/queries { drop_points_layer }
use vans/fixtures { keswick_drop_points }

test "the map fetches the drop points as GeoJSON" {
    var all_three: List<DropPoint> = keswick_drop_points()
    assert list.count(all_three) == 3
    var response: Response = request {
        method: HttpMethod.get
        path: "/drop-points"
    }
    assert response.status == 200
    assert response.output == drop_points_layer()
    assert list.map(response.output.features, pin -> pin.properties.name) == [
        "Braithwaite Stores",
        "Keswick Market",
        "Threlkeld Village Hall"
    ]
}
