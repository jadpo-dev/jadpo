// A route sends a layer bare, as it sends a list: the whole response is
// plain GeoJSON, which a mapping library fetches as it is, with `GET`,
// from the route's address. Its properties hold only what an `Output`
// may, so nothing meant for the server leaves it.

use vans/types { DropPointPin }
use vans/queries { drop_points_layer }

/// Drop points, for the customer map.
routes DropPoints {
    prefix: /drop-points

    /// Every drop point, as GeoJSON.
    GET / {
        authentication: RouteAuthentication.none
        output: FeatureCollection<Point, DropPointPin>
        run: drop_points_layer()
    }
}
