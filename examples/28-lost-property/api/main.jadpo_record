// Generated by Jadpo from the routes of API main; update it with `jadpo api update`, never by hand.
record api 1

POST /enquiries
    authentication none
    input OfficeQuestion (body)
    output AiStream (server-sent events)
    status 200
    fails answer_unavailable

POST /losses
    authentication none
    input ReportedLoss (body)
    output LossReceipt
    status 202

GET /openapi.json
    generated openapi
    authentication none
    status 200

output LossReceipt
    reference: Uuid

input OfficeQuestion
    asked_question: Text { max_length: 1000 }

input ReportedLoss
    lost_on: CalendarDate
    passenger_email: Email
    passenger_name: Text { max_length: 120 }
    reader_locale: Locale
    what_was_lost: Text { max_length: 500 }

failure answer_unavailable
    status 503
    message "We can't answer just now. Please ring the office."
