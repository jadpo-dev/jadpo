// Generated by Jadpo from the hosts the app can reach; update it with `jadpo records update`, never by hand.
record network 1

connection couriers
    for SwiftCouriers.v1
    host https://api.swift-couriers.example
    host https://sandbox.swift-couriers.example

connection depot_scans
    for AmazonSqs.v2012_11_05
    host config.sqs_endpoint

connection mail
    for Resend.v1
    host config.resend_host

connection rates
    for ParcelRates.v1
    host https://api.parcel-rates.example
    host https://sandbox.parcel-rates.example
