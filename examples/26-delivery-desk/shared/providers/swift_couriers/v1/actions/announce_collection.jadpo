// An action without `public` is the package's own: only its subscribers
// run it, so it may emit the package's events. It calls its own API to say
// more than the webhook did, and never touches the app's data.

/// Looks up a collected pickup and announces what was collected.
action announce_collection(event: PickupCollected) -> Unit {
    var collection_details: CollectedPickup = pickup_collections.retrieve(
        PickupLookup {
            id: event.pickup_id
        }
    )
    emit ParcelsCollected {
        pickup_id: collection_details.id
        driver_name: collection_details.driver_name
        parcel_count: collection_details.parcel_count
        collected_at: event.occurred_at
    }
}
