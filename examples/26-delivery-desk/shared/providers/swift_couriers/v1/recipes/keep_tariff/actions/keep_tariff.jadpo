use deliveries/entities { CourierTariff }
use shared/providers/swift_couriers

/// Keeps a price list Swift published.
action keep_tariff(event: SwiftCouriers.TariffPublished) -> CourierTariff {
    return CourierTariff.create {
        set: {
            morning_pence: event.morning_pence
            afternoon_pence: event.afternoon_pence
        }
    }
}
