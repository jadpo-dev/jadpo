{
  "openapi": "3.1.0",
  "info": {
    "title": "Parcel Rates",
    "version": "2026-09-01",
    "description": "Prices for sending a parcel across the UK, from every courier Parcel Rates compares."
  },
  "servers": [
    { "url": "https://api.parcel-rates.example", "description": "live" },
    { "url": "https://sandbox.parcel-rates.example", "description": "sandbox" }
  ],
  "components": {
    "securitySchemes": {
      "bearer": { "type": "http", "scheme": "bearer" }
    },
    "schemas": {
      "QuoteRequest": {
        "type": "object",
        "required": ["from_postcode", "to_postcode", "weight_grams"],
        "properties": {
          "from_postcode": { "type": "string", "maxLength": 8 },
          "to_postcode": { "type": "string", "maxLength": 8 },
          "weight_grams": { "type": "integer", "minimum": 1, "maximum": 30000 }
        }
      },
      "Quote": {
        "type": "object",
        "required": ["id", "amount", "currency", "valid_until"],
        "properties": {
          "id": { "type": "string", "maxLength": 32 },
          "amount": { "type": "integer", "description": "The price in pence." },
          "currency": { "type": "string", "enum": ["GBP"] },
          "valid_until": { "type": "string", "format": "date-time" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  },
  "security": [{ "bearer": [] }],
  "paths": {
    "/v1/quotes": {
      "post": {
        "operationId": "createQuote",
        "tags": ["parcel_quotes"],
        "summary": "Prices a parcel from one postcode to another.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/QuoteRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "The cheapest price.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Quote" } }
            }
          },
          "422": {
            "description": "No courier covers that route.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    }
  }
}
