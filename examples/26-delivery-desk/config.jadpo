config {
    /// The courier's API key: a secret, sent only as the package's scheme
    /// says, and never read by code.
    couriers_api_key: Text {
        secret: true
    }
    /// Which of the courier's hosts this deployment calls, its sandbox or
    /// its live API.
    couriers_environment: ProviderEnvironment {
        default: ProviderEnvironment.sandbox
    }
    /// The secret Swift Couriers signs its webhooks with.
    couriers_webhook_secret: Text {
        secret: true
    }
    /// Resend's API key, which sends the desk's email.
    resend_api_key: Text {
        secret: true
    }
    /// Where Resend's API is.
    resend_host: Url {
        default: "https://api.resend.com"
    }
    /// The address the desk's email comes from, and goes to.
    desk_address: Email {
        default: "desk@delivery-desk.example"
    }
}
