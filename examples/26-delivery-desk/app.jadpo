// The desk's own integration is called through a connection: which
// package, which domains may call it, the credential its scheme sends
// from a secret setting, and which of its hosts each deployment calls.
application {
    connections: {
        couriers: {
            package: SwiftCouriers.v1
            domains: [courier_desk]
            credential: config.couriers_api_key
            environment: config.couriers_environment
        }
    }
}
