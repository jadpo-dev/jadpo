// Generated by Jadpo from the routes of API main; update it with `jadpo api update`, never by hand.
record api 1

api main
    idempotency required

GET /openapi.json
    generated openapi
    authentication none
    status 200

POST /pickups
    authentication none
    input PickupForm (body)
    output BookedPickup
    status 201
    fails pickup_slot_gone

POST /return_bookings
    authentication none
    input ReturnBookingForm (body)
    output BookedWithReturn
    status 201
    fails pickup_slot_gone

output BookedPickup
    collect_at: Instant
    id: Text { max_length: 64 }

output BookedWithReturn
    collect_at: Instant
    outbound_id: Text { max_length: 64 }
    return_id: Text { max_length: 64 }?

input PickupForm
    postcode: Text { max_length: 8 }
    slot: Text { max_length: 20 }

input ReturnBookingForm
    postcode: Text { max_length: 8 }
    return_postcode: Text { max_length: 8 }
    return_slot: Text { max_length: 20 }
    slot: Text { max_length: 20 }

failure pickup_slot_gone
    status 409
    message "That pickup slot has gone; choose another."
