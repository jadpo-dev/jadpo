// Generated by Jadpo from the routes of API main; update it with `jadpo api update`, never by hand.
record api 1

GET /openapi.json
    generated openapi
    authentication none
    status 200

POST /pickups
    authentication none
    input PickupForm (body)
    output BookedPickup
    status 201
    fails pickup_slot_gone

output BookedPickup
    collect_at: Instant
    id: Text { max_length: 64 }

input PickupForm
    postcode: Text { max_length: 8 }
    slot: Text { max_length: 20 }

failure pickup_slot_gone
    status 409
    message "That pickup slot has gone; choose another."
