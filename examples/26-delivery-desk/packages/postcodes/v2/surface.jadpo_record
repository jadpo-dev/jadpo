// Generated by Jadpo from this package's code; update it with `jadpo package check`, never by hand.
record surface 1

package Postcodes.v2
    /// UK postcodes: reading them as people type them, and the words to show beside them.
    file package.jadpo
    kind library
    version 2.0.0
    licence mit
    jadpo 1.0
    locale en_gb
    guide GUIDE.md

function uk.tidy
    /// Reads a postcode in upper case, as the post office writes it, with any spaces around it left out.
    file libraries/uk.jadpo
    signature (entered: EnteredPostcode) -> UkPostcode
    fails InvalidPostcode

message translations.postcode_hint
    /// Shown under a postcode field.
    file translations/postcode_hint.jadpo

type EnteredPostcode = Text
    /// A postcode as someone typed it.
    file types/entered_postcode.jadpo
    max_length: 20

type UkPostcode = Text
    /// A UK postcode in standard form, such as "SW1A 1AA".
    file types/uk_postcode.jadpo
    max_length: 8
    min_length: 5

failure InvalidPostcode
    /// What was typed isn't a UK postcode.
    file failures/invalid_postcode.jadpo
    kind invalid_value
    code invalid_postcode
