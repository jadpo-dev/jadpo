// The package hands the app what happened as an event; the app's own
// action writes it, since a package never touches the app's data.

use courier_desk/entities { PickupCollection }
use courier_desk/emails { CollectionReceipt }
use shared/providers/swift_couriers

/// Keeps what the courier collected.
action keep_collection(event: SwiftCouriers.ParcelsCollected) -> PickupCollection {
    var kept_row: PickupCollection = PickupCollection.create {
        set: {
            pickup_id: event.pickup_id
            driver_name: event.driver_name
            parcel_count: event.parcel_count
            collected_at: event.collected_at
        }
    }
    emit CollectionReceipt {
        to: config.desk_address
        locale: Locale.en_gb
        driver_name: event.driver_name
        parcel_count: event.parcel_count
        pickup_id: event.pickup_id
    }
    return kept_row
}
