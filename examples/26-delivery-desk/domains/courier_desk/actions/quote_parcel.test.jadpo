use app { rates }
use courier_desk/types { QuoteForm }
use courier_desk/failures { NoCourierForRoute }
use shared/providers/parcel_rates

test "a parcel is priced in pounds" {
    fakes: {
        rates.quotes.create: [
            ParcelRates.Quote {
                id: "q-81"
                amount: ParcelRates.QuotedPrice(money.from_minor(650, Currency.gbp))
                expires_at: "2026-10-21T12:00:00Z"
            }
        ]
    }
    var price: ParcelRates.QuotedPrice = attempt quote_parcel(
        QuoteForm {
            from_postcode: "N1 9GU"
            to_postcode: "EH1 1YZ"
            weight_grams: 2000
        }
    )
    assert price == ParcelRates.QuotedPrice(money.from_minor(650, Currency.gbp))
}

test "a route no courier covers is the desk's own failure" {
    fakes: {
        rates.quotes.create: [no_route]
    }
    assert quote_parcel(
        QuoteForm {
            from_postcode: "N1 9GU"
            to_postcode: "HS1 2AA"
            weight_grams: 2000
        }
    ) fails NoCourierForRoute
}
