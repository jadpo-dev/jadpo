use courier_desk/entities { CourierTariff }
use shared/providers/swift_couriers

test "a new price list is kept" {
    var kept_row: CourierTariff = keep_tariff(
        SwiftCouriers.TariffPublished {
            morning_pence: 650
            afternoon_pence: 550
        }
    )
    assert kept_row.morning_pence == 650
}
