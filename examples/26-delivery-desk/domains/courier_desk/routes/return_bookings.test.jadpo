// A route test sends a fresh `Idempotency-Key` with every write, as the
// desk's terminal does. Since the booking's calls are steps, `jadpo
// test` also runs each test again crashing at every step's boundary, and
// the request sent again under its key must end the same way: the fake
// keeps each key's first answer, as Swift does.

use app { couriers }
use courier_desk/types { ReturnBookingForm }
use shared/providers/swift_couriers

test "a pickup and its return are both booked" {
    fakes: {
        couriers.pickups.create: [
            SwiftCouriers.Pickup {
                id: "swift-5001"
                collect_at: "2026-10-21T09:00:00Z"
            },
            SwiftCouriers.Pickup {
                id: "swift-5002"
                collect_at: "2026-10-23T14:00:00Z"
            }
        ]
    }
    var response: Response = request {
        method: HttpMethod.post
        path: "/return_bookings"
        input: ReturnBookingForm {
            postcode: "N1 9GU"
            slot: "am"
            return_postcode: "E8 3PB"
            return_slot: "pm"
        }
    }
    assert response.status == 201
    var both: Bool = match response.output {
        some(booked) -> booked.outbound_id == "swift-5001" and booked.return_id == "swift-5002"
        none -> false
    }
    assert both
}

test "a taken return slot leaves the outbound pickup booked" {
    fakes: {
        couriers.pickups.create: [
            SwiftCouriers.Pickup {
                id: "swift-5003"
                collect_at: "2026-10-21T09:00:00Z"
            },
            slot_taken
        ]
    }
    var response: Response = request {
        method: HttpMethod.post
        path: "/return_bookings"
        input: ReturnBookingForm {
            postcode: "N1 9GU"
            slot: "am"
            return_postcode: "E8 3PB"
            return_slot: "pm"
        }
    }
    assert response.status == 201
    var outbound_only: Bool = match response.output {
        some(booked) -> booked.outbound_id == "swift-5003" and booked.return_id == none
        none -> false
    }
    assert outbound_only
}
