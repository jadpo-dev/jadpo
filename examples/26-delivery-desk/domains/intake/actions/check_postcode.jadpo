// The app brings a package in whole with `use packages/<name>`, and writes
// what it offers through its name: a type, a failure, a library's function.

use packages/postcodes

/// Reads the postcode a customer typed for their delivery.
action check_postcode(
    entered: Postcodes.v1.EnteredPostcode
) fails Postcodes.v1.InvalidPostcode -> Postcodes.v1.UkPostcode {
    return attempt Postcodes.v1.uk.tidy(entered)
}
