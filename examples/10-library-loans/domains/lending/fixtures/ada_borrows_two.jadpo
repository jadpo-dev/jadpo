// The fixture builds its records through the application's own actions,
// so every rule applies as it does at the desk. Each test that calls it
// gets them in its own copy of the database.

/// Ada, with her card, borrowing two of three copies.
fixture ada_borrows_two() -> Borrower {
    var ada: Member = attempt enrol("ada@example.test", "Ada")
    var card: Card = attempt issue_card(ada.id, "00012345")
    var dune: Book = add_copy("9780441013593", "Dune", Wear.worn)
    var emma: Book = add_copy("9780141439587", "Emma", Wear.pristine)
    var on_shelf: Book = add_copy("9780140449136", "Crime and Punishment", Wear.fragile)
    var second_loan: Loan = attempt lend(emma.id, ada, "2026-11-08")
    var first_loan: Loan = attempt lend(dune.id, ada, "2026-11-01")
    return Borrower {
        member: ada
        card: card
        books: [dune, emma, on_shelf]
        loans: [second_loan, first_loan]
    }
}
