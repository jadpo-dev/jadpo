// `Book.get(book_id)` fails with the domain's failure called
// `BookNotFound`, of kind `not_found`. A domain that declares none gets
// one from the compiler: `vouch` reads a loan by id and fails with
// `LoanNotFound`, which no file here declares.

/// No book has that id.
type BookNotFound = Failure {
    kind: FailureKind.not_found
}
