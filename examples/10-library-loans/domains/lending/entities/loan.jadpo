/// A book lent to a member until a date.
entity Loan {
    id: Uuid
    // A field typed `Book.id` is a reference: the database keeps a foreign
    // key and an index for it, and its block must say what deleting the
    // book does. `restricted` refuses to delete a book that is on loan.
    book_id: Book.id {
        on_delete: OnDelete.restricted
    }
    // `cascade` deletes a member's loans with the member.
    member_id: Member.id {
        on_delete: OnDelete.cascade
    }
    // An optional reference may be `cleared`: deleting the member who
    // vouched for this loan leaves the loan, with no one vouching.
    vouched_by: Member.id? {
        on_delete: OnDelete.cleared
    }
    due_on: CalendarDate
    changed_at: Instant {
        generated: Generated.on_change
    }
    // Out until the book comes back; only the lifecycle's transition
    // changes these two.
    status: LoanStatus
    returned_at: Instant?

    // A lifecycle with no `visible:` hides nothing: returned loans stay on
    // record. A new loan starts `out` (`initial:`), and its transitions are
    // the only way to move it on, each allowed only while it is out, so
    // checking a loan in twice is refused, a conflict its caller maps.
    // With a lifecycle and no `delete` transition, no code deletes a loan.
    lifecycle: {
        initial: {
            status: LoanStatus.out
        }
        transitions: {
            check_in: {
                when: status == LoanStatus.out
                set: {
                    status: LoanStatus.returned
                    returned_at: clock.now
                }
            }
            declare_lost: {
                when: status == LoanStatus.out
                set: {
                    status: LoanStatus.lost
                }
            }
        }
    }

    // A unique rule over several fields has a name, which a write's
    // conflict names: a book is lent once on any day.
    unique: {
        one_loan_per_due_date: [book_id, due_on]
    }

    // Indexes the application's own queries need come from the queries;
    // `indexes:` declares one for lookups from outside, such as a report.
    indexes: {
        by_due_on: [due_on]
    }
}
