use lending/types { BookTitle, BookNumber, LendCount, UseCount, Wear }

/// One copy of a book on the shelves.
entity Book {
    id: Uuid
    isbn: BookNumber
    title: BookTitle
    // Added after the first migration: `jadpo migrate new add_wear`
    // asked what the copies already stored get (see the migration's
    // `changes.jadpo`).
    wear: Wear
    // Counted by `lend`, which the database works out in one step.
    times_lent: LendCount
    last_lent_at: Instant?
    // Counted by `count_in_house_use`, which reads nothing first.
    in_house_uses: UseCount
}
