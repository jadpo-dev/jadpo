use lending/entities { Book }
use lending/types { Wear }

/// Puts a new copy on the shelves.
action add_copy(isbn: Book.isbn, title: Book.title, wear: Wear) -> Book {
    return Book.create {
        set: {
            isbn: isbn
            title: title
            wear: wear
            times_lent: 0
            last_lent_at: none
        }
    }
}
