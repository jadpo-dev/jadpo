test "a small bake still uses the mixer's 2000 grams" {
    // `flour_for` can fail, so even in a test its value comes through
    // `attempt` (or `match`), never by calling it bare.
    var flour: Grams = attempt flour_for(2)
    assert flour == 2000
}

test "a large bake uses 450 grams a loaf" {
    var used: Grams = attempt bake_loaves(10, 1)
    assert used == 4500
}

test "a day's flour bakes forty loaves" {
    // `pantry`'s fixture is public, so this test calls it through its
    // domain, like a public action.
    var used: Grams = attempt bake_loaves(40, pantry.a_days_flour())
    assert used == 18000
}

test "the shared library gives the larger weight" {
    assert portions.larger(10, 20) == 20
}
