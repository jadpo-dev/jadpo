/// How many grams of flour the pantry holds once `delivered` sacks join
/// the `held` ones.
action restock(held: SackCount, delivered: SackCount) fails TooHeavy -> Grams {
    // Twelve full sacks would pass what the scales weigh, so the sum is
    // checked when it runs, and `TooHeavy`, a shared failure, names what
    // went wrong.
    var total: Grams = attempt Grams(
        sacks.grams_in(held) + sacks.grams_in(delivered)
    ) invalid: TooHeavy
    return total
}
