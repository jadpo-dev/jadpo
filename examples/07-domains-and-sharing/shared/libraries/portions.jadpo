// A library is a named group of helper functions, one library per file,
// named after it. It is called like the standard library, through its
// name: `portions.together(...)`. A library holds only functions.

/// Working with weights made of equal portions.
library portions {
    /// The weight of `count` portions of `each` grams.
    function together(each: Grams, count: PortionCount) fails TooHeavy -> Grams {
        var total: Grams = attempt Grams(each * count) {
            max: TooHeavy
        }
        return total
    }

    /// The larger of two weights.
    function larger(first: Grams, second: Grams) -> Grams {
        if (first > second) {
            return first
        }
        return second
    }
}
