// Generated by Jadpo from who can do what; update it with `jadpo records update`, never by hand.
record access 1

entity lodging.Booking
    create guest_id
    read guest_id

entity lodging.Guest
    create Access.system
    read Access.system
    read id
    update Access.system

action lodging.ask_to_sign_in
    who Access.public

action lodging.sign_in_with_code
    who Access.public

action lodging.sign_in_with_link
    who Access.public

sign_in magic_link
    code_attempts: 5
    expires_after: 15m
    failed_codes_per_day: 20
