// Generated by Jadpo from the routes of API main; update it with `jadpo api update`, never by hand.
record api 1

api main
    authentication browser_session

GET /my-stays
    output List<BookingView>
    status 200

POST /my-stays
    caller user
    input StayRequest (body)
    output BookingView
    status 201

GET /openapi.json
    generated openapi
    status 200

POST /sign-in
    authentication none
    input SignInAsk (body)
    status 204

POST /sign-in/code
    authentication none
    input CodeGiven (body)
    output SignedInView
    status 200

POST /sign-in/link
    authentication none
    input LinkGiven (body)
    output SignedInView
    status 200

output BookingView
    arrives_on: CalendarDate
    booked_room: RoomKind
    breakfast: Bool
    id: Uuid
    nights: Int { min: 1, max: 28 }

input CodeGiven
    address: Email
    code: SignInCode

input LinkGiven
    token: SignInToken

enum RoomKind
    variant double_room
    variant family_room
    variant twin_room

input SignInAsk
    address: Email
    locale: Locale

output SignedInView
    next_page: Text

input StayRequest
    arrives_on: CalendarDate
    booked_room: RoomKind
    breakfast: Bool
    guest_email: Email
    guest_locale: Locale
    guest_name: Text { min_length: 1, max_length: 80 }
    nights: Int { min: 1, max: 28 }
