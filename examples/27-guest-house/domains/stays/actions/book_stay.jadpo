// Sending is emitting. The email is kept in the outbox with the booking,
// in the same transaction, and sent once that commits: a booking that
// fails sends nothing. It is rendered whole as it is sent, its subject
// worded in its locale and each template wrapped in the shared layout.
// Its fields are prepared here, so the templates only show them: what to
// bring is worded in the guest's language before it is sent.

use stays/entities { Booking }
use stays/types { StayRequest }
use stays/emails { BookingConfirmed }

/// Books a stay, and confirms it to the guest once it is booked.
action book_stay(input: StayRequest) -> Booking {
    var booking: Booking = Booking.create {
        set: {
            guest_email: input.guest_email
            guest_name: input.guest_name
            room: input.room
            arrives_on: input.arrives_on
            nights: input.nights
            breakfast: input.breakfast
            language: input.language
        }
    }
    emit BookingConfirmed {
        to: booking.guest_email
        locale: booking.language
        guest_name: booking.guest_name
        room: booking.room
        arrives_on: booking.arrives_on
        nights: booking.nights
        breakfast: booking.breakfast
        to_bring: [
            translations.stays.bring_boots(locale: booking.language),
            translations.stays.bring_torch(locale: booking.language)
        ]
    }
    return booking
}
