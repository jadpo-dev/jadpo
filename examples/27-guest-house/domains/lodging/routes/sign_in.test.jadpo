// A route test signs in as a guest's browser would: it asks for a link,
// reads the email from `email.sent`, and posts the token at the end of
// the link the email carries. Jadpo makes the link, the code and the
// email itself; the test only follows them.

use lodging/types { CodeGiven, LinkGiven, SignInAsk, SignedInView }
use lodging/fixtures { guest_at }

test "a guest signs in with the link from their email, in Welsh" {
    var asked: Response = request {
        method: HttpMethod.post
        path: "/sign-in"
        input: SignInAsk {
            address: "megan@example.cymru"
            locale: Locale.cy_gb
        }
    }
    assert asked.status == 204
    var sent: List<SentEmail> = email.sent
    assert list.count(sent) == 1
    assert list.all(
        sent,
        item -> item.to == "megan@example.cymru" and item.subject == "Mewngofnodi i Dŷ Gwyn"
    )
    var emailed_links: List<Text> = list.flatten(list.map(sent, item -> item.links))
    var emailed_link: Text = match list.first(emailed_links) {
        none -> ""
        some(found) -> found
    }
    assert text.starts_with(emailed_link, "https://tygwyn.example/sign-in/confirm?token=")
    var signed_in: Response = request {
        method: HttpMethod.post
        path: "/sign-in/link"
        input: LinkGiven {
            token: SignInToken(text.keep_last(emailed_link, 64))
        }
    }
    assert signed_in.status == 200
    assert signed_in.output == SignedInView {
        next_page: "/"
    }
}

test "a wrong code is refused, with the same answer every time" {
    var asked: Response = request {
        method: HttpMethod.post
        path: "/sign-in"
        input: SignInAsk {
            address: "megan@example.cymru"
            locale: Locale.en_gb
        }
    }
    assert asked.status == 204
    var refused: Response = request {
        method: HttpMethod.post
        path: "/sign-in/code"
        input: CodeGiven {
            address: "megan@example.cymru"
            code: "000000"
        }
    }
    assert refused.status == 401
    assert refused.code == "sign_in_code_invalid"
}

// `test_passkeys` is a software authenticator only a route test holds:
// `register` adds a passkey for a guest through the routes Jadpo writes,
// signed in as `as:` signs a test in, and `sign_in` signs in with it
// through them, as the guest's phone would.
test "a guest who loses her phone signs in by email and adds a new passkey" {
    var megan: Principal.user = guest_at("megan@example.cymru")
    var phone: TestPasskey = test_passkeys.register(megan, "Phone")
    var by_phone: Response = test_passkeys.sign_in(phone)
    assert by_phone.status == 204
    // The phone is lost: Megan signs in with the link emailed to her.
    var asked: Response = request {
        method: HttpMethod.post
        path: "/sign-in"
        input: SignInAsk {
            address: "megan@example.cymru"
            locale: Locale.en_gb
        }
    }
    assert asked.status == 204
    var emailed_links: List<Text> = list.flatten(list.map(email.sent, item -> item.links))
    var emailed_link: Text = match list.first(emailed_links) {
        none -> ""
        some(found) -> found
    }
    var by_link: Response = request {
        method: HttpMethod.post
        path: "/sign-in/link"
        input: LinkGiven {
            token: SignInToken(text.keep_last(emailed_link, 64))
        }
    }
    assert by_link.status == 200
    // Signed in again, she adds a passkey on her new phone.
    var new_phone: TestPasskey = test_passkeys.register(megan, "New phone")
    var by_new_phone: Response = test_passkeys.sign_in(new_phone)
    assert by_new_phone.status == 204
}
