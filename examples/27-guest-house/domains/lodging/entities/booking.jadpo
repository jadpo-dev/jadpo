use lodging/types { GuestName, NightCount, RoomKind }

/// A guest's stay.
entity Booking {
    id: Uuid
    guest_email: Email
    guest_name: GuestName
    booked_room: RoomKind
    arrives_on: CalendarDate
    nights: NightCount
    breakfast: Bool
    guest_locale: Locale

    policy: {
        create: [Access.public]
        read: [Access.public]
    }
}
