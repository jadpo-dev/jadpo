// `guest_id` grants the guest it points at: a guest books, and reads,
// only their own stays.

use lodging/entities { Guest }
use lodging/types { GuestName, NightCount, RoomKind }

/// A guest's stay.
entity Booking {
    id: Uuid
    guest_id: Guest.id {
        on_delete: OnDelete.cascade
    }
    guest_email: Email
    guest_name: GuestName
    booked_room: RoomKind
    arrives_on: CalendarDate
    nights: NightCount
    breakfast: Bool
    guest_locale: Locale

    policy: {
        create: [guest_id]
        read: [guest_id]
    }
}
