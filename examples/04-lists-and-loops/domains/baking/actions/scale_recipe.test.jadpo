use baking/types { Hazard, Ingredient, Recipe }

test "scaling multiplies every ingredient's weight" {
    var sponge: Recipe = Recipe {
        ingredients: [
            Ingredient {
                name: "Flour"
                weight: 200g
            },
            Ingredient {
                name: "Sugar"
                weight: 150g
            }
        ]
        allergens: [Hazard.gluten, Hazard.egg]
    }
    var double: Recipe = scale_recipe(sponge, 2).recipe
    assert list.map(double.ingredients, ingredient -> ingredient.weight) == [400g, 300g]
    assert double.allergens == sponge.allergens
}

test "ingredients over 5 kg go on the floor scale, in recipe order" {
    var loaf: Recipe = Recipe {
        ingredients: [
            Ingredient {
                name: "Flour"
                weight: 600g
            },
            Ingredient {
                name: "Salt"
                weight: 10g
            },
            Ingredient {
                name: "Water"
                weight: 520g
            }
        ]
        allergens: [Hazard.gluten]
    }
    // Ten loaves: 6000 g of flour, 100 g of salt and 5200 g of water.
    assert scale_recipe(loaf, 10).floor_scale == ["Flour", "Water"]
}
