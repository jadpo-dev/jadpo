// Searching a list, and a `Set`.

use baking/types { Allergen, Recipe }

/// Whether a recipe is safe for someone.
type SafeToEat = Bool {}

/// A badge the menu prints beside a recipe.
type Badge = Enum {
    vegan
    vegetarian
    nut_free
}

/// Whether a recipe is safe for someone, and the badges it earns.
type AllergenCheck = Output {
    avoids_all: SafeToEat
    badges: Set<Badge>
}

/// Whether `recipe` avoids every allergen in `avoid`.
function safe_for(recipe: Recipe, avoid: List<Allergen>) -> SafeToEat {
    for allergen in avoid {
        // `list.contains` asks whether a list holds a value equal to
        // the one given.
        if (list.contains(recipe.allergens, allergen)) {
            return false
        }
    }
    return true
}

// A `Set` holds each value once, so two sets are equal when they hold the
// same values, whatever order they were written in. A set is written as a
// list in square brackets where a set is expected, and a set literal that
// repeats a value doesn't compile.
//
// A set's order isn't meaningful: code can't read one, as there is no
// first item and no index, and the order a set is printed in says nothing
// about how it was built. Where order matters, use a `List`. So far a set
// can be built, returned, passed on and compared, but `for` and the
// `collection` operations take only lists, which is why
// `Recipe.allergens`, searched above, is a list.

/// The badges `recipe` earns; this bakery bakes no meat, so every
/// recipe is vegetarian.
function badges(recipe: Recipe) -> Set<Badge> {
    var animal_free: Bool = not list.contains(
        recipe.allergens,
        Allergen.milk
    ) and not list.contains(recipe.allergens, Allergen.egg)
    var nut_free: Bool = not list.contains(recipe.allergens, Allergen.nuts)
    if (animal_free and nut_free) {
        return [Badge.vegan, Badge.vegetarian, Badge.nut_free]
    } else if (animal_free) {
        return [Badge.vegan, Badge.vegetarian]
    } else if (nut_free) {
        return [Badge.vegetarian, Badge.nut_free]
    }
    return [Badge.vegetarian]
}

/// What the menu shows beside `recipe` for someone avoiding the allergens
/// in `avoid`: whether it's safe for them, and the badges it earns.
action check_allergens(recipe: Recipe, avoid: List<Allergen>) -> AllergenCheck {
    return AllergenCheck {
        avoids_all: safe_for(recipe, avoid)
        badges: badges(recipe)
    }
}
