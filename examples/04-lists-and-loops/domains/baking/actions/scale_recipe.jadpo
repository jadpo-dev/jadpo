// Changing and filtering lists with `list.map` and
// `list.filter`. Each takes an inline function, `item -> result`:
// one expression, whose parameter takes its type from the list. It may
// read the variables around it, which is safe because values never
// change. Inline functions exist only as arguments to these operations;
// functions are not values, so they can't be stored or passed to your own
// functions.

use baking/types { Grams, Ingredient, IngredientName, Recipe }

/// How many times a recipe is made at once.
type Batches = Int {
    min: 1
    max: 10
}

/// A recipe made several times over, and the ingredients too heavy for
/// the bench scale, which are weighed on the floor scale instead.
type ScaledRecipe = Output {
    recipe: Recipe
    floor_scale: List<IngredientName>
}

/// The names of the ingredients heavier than `over`, in recipe order.
function heavy_ingredients(recipe: Recipe, over: Grams) -> List<IngredientName> {
    var heavy: List<Ingredient> = list.filter(
        recipe.ingredients,
        ingredient -> ingredient.weight > over
    )
    return list.map(heavy, ingredient -> ingredient.name)
}

/// `recipe` made `bakes` times over, and which ingredients then go on
/// the floor scale.
action scale_recipe(recipe: Recipe, bakes: Batches) -> ScaledRecipe {
    var scaled: List<Ingredient> = list.map(
        recipe.ingredients,
        ingredient -> Ingredient {
            name: ingredient.name
            weight: Grams(ingredient.weight * bakes)
        }
    )
    var whole_batch: Recipe = Recipe {
        ingredients: scaled
        allergens: recipe.allergens
    }
    // The bench scale weighs up to 5 kg.
    return ScaledRecipe {
        recipe: whole_batch
        floor_scale: heavy_ingredients(whole_batch, 5000)
    }
}
