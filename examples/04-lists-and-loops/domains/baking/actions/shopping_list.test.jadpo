use baking/types { Hazard, Ingredient, Recipe }

test "an ingredient that goes in twice is bought once" {
    var shortbread: Recipe = Recipe {
        ingredients: [
            Ingredient {
                name: "Butter"
                weight: 100g
            },
            Ingredient {
                name: "Flour"
                weight: 150g
            },
            Ingredient {
                name: "Butter"
                weight: 10g
            }
        ]
        allergens: [Hazard.gluten, Hazard.milk]
    }
    assert shopping_list(shortbread) == ["Flour", "Butter"]
}
