// A list literal is written in square brackets, and its items take the
// list's element type, so `"Flour"` here is an `IngredientName`.

use baking/types { Hazard, Ingredient, Recipe }

test "a recipe weighs as much as its ingredients" {
    var bread: Recipe = Recipe {
        ingredients: [
            Ingredient {
                name: "Flour"
                weight: 500g
            },
            Ingredient {
                name: "Water"
                weight: 350g
            },
            Ingredient {
                name: "Salt"
                weight: 10g
            }
        ]
        allergens: [Hazard.gluten]
    }
    var label: RecipeLabel = weigh_recipe(bread)
    assert label.total == 860g
    assert label.ingredients == 3
    assert label.flour == 500g
}

test "the first ingredient with a name gives its weight" {
    var bread: Recipe = Recipe {
        ingredients: [
            Ingredient {
                name: "Flour"
                weight: 500g
            },
            Ingredient {
                name: "Water"
                weight: 350g
            }
        ]
        allergens: [Hazard.gluten]
    }
    assert weight_of(bread, "Water") == 350g
    assert weight_of(bread, "Yeast") == none
}

test "an empty recipe weighs nothing" {
    var nothing: Recipe = Recipe {
        ingredients: []
        allergens: []
    }
    assert weigh_recipe(nothing) == RecipeLabel {
        total: 0g
        ingredients: 0
        flour: none
    }
}
