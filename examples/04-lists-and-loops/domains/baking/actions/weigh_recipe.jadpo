// Walking a list with `for`.

use baking/types { IngredientName, IngredientWeight, Recipe }

/// How many ingredients a recipe has.
type IngredientCount = Int {
    min: 0
}

/// What the label on a weighed recipe says: the total weight, how many
/// ingredients went in, and the flour's weight, which bakers work every
/// other amount out from. A recipe with no flour has `none`.
type RecipeLabel = Output {
    total: IngredientWeight
    ingredients: IngredientCount
    flour: IngredientWeight?
}

/// How many ingredients `recipe` has.
function count_ingredients(recipe: Recipe) -> IngredientCount {
    // `list.count` gives a plain `Int`. The standard library is
    // always called through its namespace, so `collection.` always means
    // the standard library. The compiler knows a count is never below
    // zero, so `IngredientCount(...)` can't fail.
    return IngredientCount(list.count(recipe.ingredients))
}

/// The weight of the first ingredient called `name`, or `none`.
function weight_of(recipe: Recipe, name: IngredientName) -> IngredientWeight? {
    for ingredient in recipe.ingredients {
        // `return` inside a loop ends the whole function at once.
        if (ingredient.name == name) {
            return ingredient.weight
        }
    }
    return none
}

/// The label for a weighed `recipe`.
action weigh_recipe(recipe: Recipe) -> RecipeLabel {
    // `var mut` names a value that can be pointed at a new value of the
    // same type. Only a `var mut` local can be assigned; parameters and
    // fields never can.
    var mut total: IngredientWeight = 0g
    // `for` is the only loop. The loop item takes its type from the list:
    // here each `ingredient` is an `Ingredient`. There is no `while`,
    // `break` or `continue`.
    for ingredient in recipe.ingredients {
        total = IngredientWeight(total + ingredient.weight)
    }
    return RecipeLabel {
        total: total
        ingredients: count_ingredients(recipe)
        flour: weight_of(recipe, "Flour")
    }
}
