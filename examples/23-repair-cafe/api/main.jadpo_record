// Generated by Jadpo from the routes of API main; update it with `jadpo api update`, never by hand.
record api 1

POST /repairs
    authentication none
    input RepairRequest (body)
    output RepairTicket
    status 201
    settle within 3s
    fails repair_not_found

POST /repairs/{repair_id: Uuid}/thanks
    authentication none
    input ThanksRequest (body)
    output ThanksReceipt
    status 202

enum RepairKind
    variant bike
    variant knitwear
    variant lamp
    variant microwave
    variant toaster

input RepairRequest
    item: RepairKind
    symptom: Text { min_length: 3, max_length: 300 }

output RepairTicket
    bench_id: Uuid?
    id: Uuid
    item: RepairKind
    ticket_printed_at: Instant?

output ThanksReceipt
    repair_id: Uuid

input ThanksRequest
    note: Text { min_length: 1, max_length: 280 }

failure repair_not_found
    status 404
