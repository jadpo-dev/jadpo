// Generated by Jadpo from the events of domain cafe; update it with `jadpo records update`, never by hand.
record events 1

event BenchAssigned
    bench_id: Uuid
    repair_id: Uuid

event RepairBooked
    item: RepairKind
    repair_id: Uuid

event ThanksLeft
    note: Text { min_length: 1, max_length: 280 }
    repair_id: Uuid

enum RepairKind
    variant bike
    variant knitwear
    variant lamp
    variant microwave
    variant toaster
