// `geo.from_geojson` reads one of the six geometries from GeoJSON text,
// longitude first, as `geo.from_wkt` reads WKT; a layer of features is
// read with `json.read` instead (`moved_checkpoints.jadpo`).

use fellrace/types { DrawnShape }
use fellrace/failures { NotLand }

/// The open fell an organiser drew in a mapping tool.
action land_from_drawing(drawn: DrawnShape) fails NotLand -> Polygon {
    var shape: Geometry = attempt geo.from_geojson(drawn) {
        malformed: NotLand  // not GeoJSON, a feature, or rings that cross
        out_of_range: NotLand  // past a pole, or past the antimeridian
    }
    return match shape {
        Geometry.polygon(outline) -> outline.polygon
        Geometry.multi_polygon -> reject NotLand
        Geometry.point -> reject NotLand
        Geometry.multi_point -> reject NotLand
        Geometry.line_string -> reject NotLand
        Geometry.multi_line_string -> reject NotLand
    }
}
