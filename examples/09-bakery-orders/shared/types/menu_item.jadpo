// The menu's items, shared because `menu` prices them and `sales` puts
// them in baskets. A tagged union: each kind of item carries only the
// choices that make sense for it.

use shared/types { Grain, SliceCount }

/// Something on the menu, with the customer's choices for it.
type MenuItem = Enum {
    loaf: {
        grain: Grain
    }
    cake: {
        slices: SliceCount
    }
    coffee
}
