// Money has no literal: an amount is a whole number of its currency's
// minor units, pence here, with its currency, so `pricing.pence` says
// both once for the whole bakery.

use shared/types { MinorUnits, Sterling }

/// Prices worked out from other prices.
library pricing {
    /// An amount written in pence: `pricing.pence(250)` is £2.50.
    function pence(count: MinorUnits) -> Sterling {
        return Sterling(money.from_minor(count, Currency.gbp))
    }
}
