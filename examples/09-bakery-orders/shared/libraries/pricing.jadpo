use shared/types { Pence, Percent }

/// Prices worked out from other prices.
library pricing {
    /// `percent` per cent of `amount`, to the nearest penny; a half penny
    /// goes to the even penny.
    function percent_of(amount: Pence, percent: Percent) -> Pence {
        return Pence(integer.divide(amount * percent, 100, rounding: Rounding.half_even))
    }
}
