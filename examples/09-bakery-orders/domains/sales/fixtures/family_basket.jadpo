// Test data several of the `sales` domain's test files share.

/// Two white loaves, half a cake and two coffees: 2 x 250 + 2800 + 2 x
/// 280 = 3860 pence, with `code` if one is given.
fixture family_basket(code: DiscountCode?) -> Basket {
    return Basket {
        lines: [
            BasketLine {
                item: MenuItem.loaf {
                    grain: Grain.white
                }
                count: 2
            },
            BasketLine {
                item: MenuItem.cake {
                    slices: 8
                }
                count: 1
            },
            BasketLine {
                item: MenuItem.coffee
                count: 2
            }
        ]
        code: code
    }
}
