use shared/types { MenuItem, Sterling }
use shared/libraries { pricing }
use sales/types { Basket, BasketLine }
use sales/failures { DiscountTooLarge }
use sales/fixtures { family_basket }

test "the till charges full price when a code is unknown" {
    var charged: Sterling = attempt till_total(family_basket("OLDCODE"))
    assert charged == pricing.pence(3860)
}

test "the till still refuses a code worth more than the basket" {
    var coffee: Basket = Basket {
        lines: [
            BasketLine {
                item: MenuItem.coffee
                count: 1
            }
        ]
        code: "FIVEPOUNDS"
    }
    assert till_total(coffee) fails DiscountTooLarge
}
