// Pricing a basket: the menu's prices for each line, then a discount code
// if the customer gave one. Four failures can leave it, each a declared
// type in `failures/`, and `menu` is reached only through its public
// action.
//
// A code's worth is the standard `Discount`: a percentage off, or an
// amount of money off. A `Discount`'s amount may be in any currency, so
// one in pounds is checked when it is used.

use shared/types { Sterling }
use shared/libraries { pricing }
use sales/types { Basket, DiscountCode, Receipt }
use sales/failures { BasketEmpty, CodeNotInPounds, CodeUnknown, DiscountTooLarge }
use sales/actions { price_lines }

/// The discount the code `code` gives.
function discount_for(code: DiscountCode) fails CodeUnknown -> Discount {
    return match code {
        "TENOFF" -> Discount.percentage_off {
            percentage: 10%
        }
        "FIVEPOUNDS" -> Discount.amount_off {
            amount: money.from_minor(500, Currency.gbp)
        }
        _ -> reject CodeUnknown {
            code: code
        }
    }
}

/// What `discount` takes off `subtotal`: a percentage's share rounded half
/// to even to a penny, as `Sterling` rounds, or an amount in pounds.
function amount_off(discount: Discount, subtotal: Sterling) fails CodeNotInPounds -> Sterling {
    match discount {
        Discount.percentage_off(share) -> {
            return Sterling(subtotal * share.percentage)
        }
        Discount.amount_off(fixed) -> {
            return attempt Sterling(fixed.amount) {
                currency: CodeNotInPounds
            }
        }
    }
}

/// The receipt for `basket`.
public action price_basket(
    basket: Basket
) fails BasketEmpty, CodeNotInPounds, CodeUnknown, DiscountTooLarge -> Receipt {
    if (list.count(basket.lines) == 0) {
        reject BasketEmpty
    }
    var subtotal: Sterling = price_lines(basket)
    var mut off: Sterling = pricing.pence(0)
    // `attempt` starts a statement, so a code's discount is worked out in
    // a block arm rather than inside a value.
    match basket.code {
        some(code) -> {
            var discount: Discount = attempt discount_for(code)
            off = attempt amount_off(discount, subtotal)
        }
        none -> {}
    }
    // A fixed discount can be worth more than a small basket, so this is
    // checked when it runs. The `min` arm names the failure and gives its
    // fields, as `reject` does.
    //
    // An `if (off > subtotal) { reject ... }` before it wouldn't make this
    // plain. A comparison bounds each side by the other side's range, so
    // it would say `off` is at most what any `Sterling` can be, never that
    // `subtotal - off` is at least 0: the compiler doesn't reason about
    // the difference between two values. The rule's own check is the way
    // to say it.
    var total: Sterling = attempt Sterling(subtotal - off) {
        min: DiscountTooLarge {
            subtotal: subtotal
        }
    }
    return Receipt {
        subtotal: subtotal
        discount: off
        total: total
    }
}
