// Calling across domains. The dot names the owner of what is called:
//
//   pantry.take_flour(...)    a public action of another domain
//   portions.together(...)    a library, here a shared one
//   list.count(...)     the standard library
//   flour_for(...)            a helper in this file, by its bare name
//
// Searching for `pantry.` finds every call into that domain. `use pantry`
// brings the domain in for those calls; the names this file takes from
// `pantry` and `shared/` (its failure, types and library) come in by
// folder, one line per folder.

use shared/types { FlourWeight, PortionCount, SackCount }
use shared/failures { TooHeavy }
use shared/libraries { portions }
use pantry/failures { FlourShort }
use pantry

/// How many loaves a bake makes.
public type LoafCount = Int {
    min: 1
    max: 100
}

/// The flour for `loaves` loaves of 450g, or at least the 2000g
/// the mixer needs to turn.
function flour_for(loaves: LoafCount) fails TooHeavy -> FlourWeight {
    var needed: FlourWeight = attempt portions.together(450g, PortionCount(loaves))
    return portions.larger(needed, 2000g)
}

/// Bakes `loaves` loaves with flour from the `in_store` sacks in the pantry.
/// Public, so the scenario in the root `tests/` folder can call it.
public action bake_loaves(
    loaves: LoafCount,
    in_store: SackCount
) fails TooHeavy, FlourShort -> FlourWeight {
    var flour: FlourWeight = attempt flour_for(loaves)
    return attempt pantry.take_flour(flour, in_store)
}
