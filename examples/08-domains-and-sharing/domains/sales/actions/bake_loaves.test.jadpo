use shared/types { FlourWeight }
use shared/libraries { portions }
use pantry

test "a small bake still uses the mixer's 2000g" {
    // `flour_for` can fail, so even in a test its value comes through
    // `attempt` (or `match`), never by calling it bare.
    var flour: FlourWeight = attempt flour_for(2)
    assert flour == 2000g
}

test "a large bake uses 450g a loaf" {
    var used: FlourWeight = attempt bake_loaves(10, 1)
    assert used == 4500g
}

test "a day's flour bakes forty loaves" {
    // `pantry`'s fixture is public, so this test calls it through its
    // domain, like a public action.
    var used: FlourWeight = attempt bake_loaves(40, pantry.a_days_flour())
    assert used == 18000g
}

test "the shared library gives the larger weight" {
    assert portions.larger(10kg, 20kg) == 20kg
}
