// A public action is a domain's way in for other domains: `sales` calls
// it as `pantry.take_flour(...)`. Another domain never reaches inside: it
// calls public actions and reads public types, and the domain keeps its
// own rules. When data arrives (area 5), a public action called from
// another domain shares its caller's transaction, so both commit or
// neither does.

use shared/types { FlourWeight, SackCount }
use shared/failures { TooHeavy }
use pantry/failures { FlourShort }
use pantry/libraries { sacks }

/// Takes `asked` flour from the `in_store` full sacks, and says how much
/// flour went.
public action take_flour(
    asked: FlourWeight,
    in_store: SackCount
) fails FlourShort, TooHeavy -> FlourWeight {
    // A local can't reuse a library's or a domain's name, so
    // `sacks.weight_in` below always means the library.
    var available: FlourWeight = attempt sacks.weight_in(in_store)
    if (asked > available) {
        reject FlourShort {
            available: available
        }
    }
    return asked
}
