use shared/types { FlourWeight, SackCount }
use shared/failures { TooHeavy }
use pantry/libraries { sacks }

/// How much flour the pantry holds once `delivered` sacks join
/// the `in_store` ones.
action restock(in_store: SackCount, delivered: SackCount) fails TooHeavy -> FlourWeight {
    // Each side is from 0 to 96kg, so the sum is never below 0 but
    // can pass the 100kg the scales weigh: only `max` can break, and it
    // is checked when it runs. `TooHeavy`, a shared failure, names what
    // went wrong.
    var in_store_weight: FlourWeight = attempt sacks.weight_in(in_store)
    var delivered_now: FlourWeight = attempt sacks.weight_in(delivered)
    var total: FlourWeight = attempt FlourWeight(in_store_weight + delivered_now) {
        max: TooHeavy
    }
    return total
}
