// A library private to its domain: only `pantry` calls it.

use shared/types { FlourWeight, SackCount }
use shared/failures { TooHeavy }

/// Sacks of flour and the weight in them.
library sacks {
    /// The weight of flour in `count` full sacks.
    function weight_in(count: SackCount) fails TooHeavy -> FlourWeight {
        // A weight times a count is a plain `Mass`, so whether it fits the
        // 100kg `FlourWeight` allows is checked when it runs, and `TooHeavy`
        // names what went wrong.
        var weight: FlourWeight = attempt FlourWeight(16kg * count) {
            invalid: TooHeavy
        }
        return weight
    }
}
