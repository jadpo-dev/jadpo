// A fixture (example 07), like everything in a domain, is private unless
// marked `public`. A public fixture is offered to other domains' tests,
// fixtures and seeds, and to scenarios in the root `tests/` folder, which
// call it through its domain: `pantry.a_days_flour()`. Application code
// never calls a fixture, public or not.

use shared/types { SackCount }

/// The full sacks a pantry holds for a day's baking.
public fixture a_days_flour() -> SackCount {
    return 2
}
