// A library is a named group of helper functions, one library per file,
// named after it. It is called like the standard library, through its
// name: `portions.together(...)`. A library holds only functions.

use shared/types { FlourWeight, PortionCount }
use shared/failures { TooHeavy }

/// Working with weights made of equal portions.
library portions {
    /// The weight of `count` portions weighing `each`.
    function together(each: FlourWeight, count: PortionCount) fails TooHeavy -> FlourWeight {
        var total: FlourWeight = attempt FlourWeight(each * count) {
            max: TooHeavy
        }
        return total
    }

    /// The larger of two weights.
    function larger(first: FlourWeight, second: FlourWeight) -> FlourWeight {
        if (first > second) {
            return first
        }
        return second
    }
}
