use bakery/entities { Order }
use bakery/types { CollectionDay, OrderView }

/// The orders the calling outlet hands over on one day.
query handovers(day: CollectionDay) -> List<OrderView> {
    from: Order
    where: Order.collect_on == day.collect_on
    order: [Order.ordered_at asc]
    limit: 100
    include: {
        cake: Order.cake_id
    }
}
