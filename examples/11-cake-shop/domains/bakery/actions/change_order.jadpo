// The action changes the order by its `id` and names no customer: policy
// adds `customer_id` to the update's `WHERE`, so another customer's order
// isn't found, and the caller gets `OrderNotFound` as if it didn't exist.

use bakery/entities { Order, OrderNotFound }
use bakery/types { OrderView }
use bakery/queries { order_by_id }

// `PUT` replaces what may change about an order, so every field is
// required: a client sends the whole of it.

/// What a customer may change about an order.
type ChangeOrder = Input {
    pick: [Order.quantity, Order.collect_on]
}

/// Changes how many cakes an order is for, and when they are collected.
action change_order(order_id: Order.id, input: ChangeOrder) fails OrderNotFound -> OrderView {
    var order: Order = attempt Order.update(order_id) {
        set: {
            quantity: input.quantity
            collect_on: input.collect_on
        }
    }
    return attempt order_by_id(order.id)
}
