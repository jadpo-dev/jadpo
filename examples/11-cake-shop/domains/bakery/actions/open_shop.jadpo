use bakery/entities { Shop }
use bakery/types { ShopName, ShopStatus }
use bakery/failures { ShopNameTaken }

/// Opens a shop for collections.
action open_shop(name: ShopName) fails ShopNameTaken -> Shop {
    return attempt Shop.create {
        set: {
            name: name
            status: ShopStatus.open
        }
        conflict: {
            Shop.name: ShopNameTaken
        }
    }
}
