// No route runs this action, and nothing grants `create` on `Cake`: the
// bakery fills its menu from its own tools. Tests call it without a
// caller, which runs it without policy, to set up the menu they need.

use bakery/entities { Cake }
use bakery/types { CakeName, Flavour, Sterling }

/// Puts a cake on the menu.
action add_cake(name: CakeName, flavour: Flavour, price: Sterling) -> Cake {
    return Cake.create {
        set: {
            name: name
            flavour: flavour
            price: price
            on_menu: true
        }
    }
}
