use bakery/entities { Customer }
use bakery/types { OrderView, OutletWithMenu, ParcelQuote }
use bakery/actions { PlaceOrder, place_order, register }
use bakery/fixtures { market_street }

test "postage is charged by weight with VAT" {
    var market: OutletWithMenu = market_street()
    var ann: Customer = attempt register("ann@example.test", "Ann")
    var order: OrderView = attempt place_order(
        PlaceOrder {
            outlet_id: market.pickup_outlet.id
            cake_id: market.lemon.id
            quantity: 2
            collect_on: "2026-11-07"
        },
        Principal.user(ann)
    )
    // 2 x 450g + 1.2kg + 3lb is 3.46kg, so £6.92 before VAT.
    var quote: ParcelQuote = attempt quote_parcel(
        order.id,
        ParcelRequest {
            label: "GB123456"
        }
    )
    assert quote.postage == money.from_minor(830, Currency.gbp)
}
