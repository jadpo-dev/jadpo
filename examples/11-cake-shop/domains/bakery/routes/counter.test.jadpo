// `as: Principal.service(shop)` signs a shop's counter in with a real key,
// issued for the test and sent as `Authorization: Bearer`.

use bakery/entities { Customer, Shop }
use bakery/types { CollectionDay, OrderView, ShopFront, ShopKeyRequest }
use bakery/actions { PlaceOrder, close_shop, open_shop, place_order, register }
use bakery/fixtures { market_street }

test "a counter lists only its own shop's collections" {
    var front: ShopFront = market_street()
    var harbour: Shop = attempt open_shop("Harbour")
    var ann: Customer = attempt register("ann@example.test", "Ann")
    var at_market: OrderView = attempt place_order(
        PlaceOrder {
            shop_id: front.shop.id
            cake_id: front.lemon.id
            quantity: 1
            collect_on: "2026-11-07"
        },
        Principal.user(ann)
    )
    var at_harbour: OrderView = attempt place_order(
        PlaceOrder {
            shop_id: harbour.id
            cake_id: front.coffee.id
            quantity: 2
            collect_on: "2026-11-07"
        },
        Principal.user(ann)
    )
    assert at_harbour.quantity == 2
    var response: Response = request {
        method: HttpMethod.get
        path: "/counter/collections"
        as: Principal.service(front.shop)
        input: CollectionDay {
            collect_on: "2026-11-07"
        }
    }
    assert response.status == 200
    assert response.output == [at_market]
}

test "a counter rotates its key" {
    var front: ShopFront = market_street()
    var issued: Response = request {
        method: HttpMethod.post
        path: "/counter/keys"
        as: Principal.service(front.shop)
        input: ShopKeyRequest {
            expires_at: "2027-01-01T00:00:00Z"
        }
    }
    assert issued.status == 201
    var listed: Response = request {
        method: HttpMethod.get
        path: "/counter/keys"
        as: Principal.service(front.shop)
    }
    var keys: List<IssuedKey> = match listed.output {
        some(found) -> found
        none -> []
    }
    // `as:` signs each request in with a key of its own, as two counters
    // would, so the list also holds those; the new key is the one that
    // lasts until the new year.
    var rotated: List<IssuedKey> = collection.filter(keys, key -> key.ends_at == "2027-01-01T00:00:00Z")
    assert collection.count(rotated) == 1
}

test "a closed shop's counter is refused" {
    var front: ShopFront = market_street()
    var closed: Shop = attempt close_shop(front.shop.id)
    var response: Response = request {
        method: HttpMethod.get
        path: "/counter/keys"
        as: Principal.service(closed)
    }
    assert response.status == 403
    assert response.code == "service_disabled"
}
