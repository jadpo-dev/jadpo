// `as: Principal.service(outlet)` signs an outlet's counter in with a real key,
// issued for the test and sent as `Authorization: Bearer`.

use bakery/entities { Customer, Outlet }
use bakery/types { CollectionDay, OrderView, OutletKeyRequest, OutletWithMenu }
use bakery/actions { PlaceOrder, close_outlet, open_outlet, place_order, register }
use bakery/fixtures { market_street }

test "a counter lists only its own outlet's handovers" {
    var market: OutletWithMenu = market_street()
    var harbour: Outlet = attempt open_outlet("Harbour")
    var ann: Customer = attempt register("ann@example.test", "Ann")
    var at_market: OrderView = attempt place_order(
        PlaceOrder {
            outlet_id: market.pickup_outlet.id
            cake_id: market.lemon.id
            quantity: 1
            collect_on: "2026-11-07"
        },
        Principal.user(ann)
    )
    var at_harbour: OrderView = attempt place_order(
        PlaceOrder {
            outlet_id: harbour.id
            cake_id: market.coffee.id
            quantity: 2
            collect_on: "2026-11-07"
        },
        Principal.user(ann)
    )
    assert at_harbour.quantity == 2
    var response: Response = request {
        method: HttpMethod.get
        path: "/counter/handovers"
        as: Principal.service(market.pickup_outlet)
        input: CollectionDay {
            collect_on: "2026-11-07"
        }
    }
    assert response.status == 200
    assert response.output == [at_market]
}

test "a counter rotates its key" {
    var market: OutletWithMenu = market_street()
    var new_key: Response = request {
        method: HttpMethod.post
        path: "/counter/keys"
        as: Principal.service(market.pickup_outlet)
        input: OutletKeyRequest {
            key_expires_at: "2027-01-01T00:00:00Z"
        }
    }
    assert new_key.status == 201
    var seen: Response = request {
        method: HttpMethod.get
        path: "/counter/keys"
        as: Principal.service(market.pickup_outlet)
    }
    var outlet_keys: List<IssuedKey> = match seen.output {
        some(found) -> found
        none -> []
    }
    // `as:` signs each request in with a key of its own, as two counters
    // would, so the list also holds those; the new key is the one that
    // lasts until the new year.
    var rotated: List<IssuedKey> = list.filter(
        outlet_keys,
        key -> key.ends_at == "2027-01-01T00:00:00Z"
    )
    assert list.count(rotated) == 1
}

test "a closed outlet's counter is refused" {
    var market: OutletWithMenu = market_street()
    var closed: Outlet = attempt close_outlet(market.pickup_outlet.id)
    var response: Response = request {
        method: HttpMethod.get
        path: "/counter/keys"
        as: Principal.service(closed)
    }
    assert response.status == 403
    assert response.code == "service_disabled"
}
