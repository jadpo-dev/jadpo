// `SuccessStatus.no_content` answers 204 with no body, so the action
// returns `Unit` and the route has no `output:`.

use bakery/actions { SignUp, sign_out, sign_up }

/// Signing up and out on the website.
routes Account {
    prefix: /account

    /// Anyone may sign up; the response sets the session's cookies.
    POST /sign-up {
        authentication: RouteAuthentication.none
        input: SignUp
        status: SuccessStatus.no_content
        run: sign_up(input)
    }

    /// Ends the session and clears its cookies.
    POST /sign-out {
        status: SuccessStatus.no_content
        run: sign_out()
    }
}
