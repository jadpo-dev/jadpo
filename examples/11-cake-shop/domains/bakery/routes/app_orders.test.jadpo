// The app's API accepts only its tokens, so `as:` signs in with a real
// API token sent as `Authorization: Bearer`.

use bakery/entities { Customer }
use bakery/types { OrderView, OutletWithMenu }
use bakery/actions { PlaceOrder, place_order, register }
use bakery/fixtures { market_street }

test "the app lists the customer's orders with its token" {
    var market: OutletWithMenu = market_street()
    var ann: Customer = attempt register("ann@example.test", "Ann")
    var order: OrderView = attempt place_order(
        PlaceOrder {
            outlet_id: market.pickup_outlet.id
            cake_id: market.lemon.id
            quantity: 1
            collect_on: "2026-11-07"
            app_version: "2.4.1"
        },
        Principal.user(ann)
    )
    var response: Response = request {
        method: HttpMethod.get
        path: "/app/orders"
        as: Principal.user(ann)
    }
    assert response.status == 200
    assert response.output == [order]
}

test "an app write without an Idempotency-Key is refused" {
    var market: OutletWithMenu = market_street()
    var ann: Customer = attempt register("ann@example.test", "Ann")
    var response: Response = request {
        method: HttpMethod.post
        path: "/app/orders"
        as: Principal.user(ann)
        input: PlaceOrder {
            outlet_id: market.pickup_outlet.id
            cake_id: market.lemon.id
            quantity: 1
            collect_on: "2026-11-07"
            app_version: "2.4.1"
        }
    }
    assert response.status == 400
    assert response.code == "invalid_request"
}
