// Generated by Jadpo from the routes of API main; update it with `jadpo api update`, never by hand.
record api 1

api main
    authentication browser_session

GET /account/orders
    output List<OrderView>
    status 200

POST /account/orders
    caller user
    input PlaceOrder (body)
    output OrderView
    status 201
    fails cake_not_found
    fails cake_off_menu
    fails outlet_not_found

GET /account/orders/{order_id: Uuid}
    output OrderView
    status 200
    fails order_not_found

PUT /account/orders/{order_id: Uuid}
    input ChangeOrder (body)
    output OrderView
    status 200
    fails order_not_found

POST /account/sign-out
    status 204

POST /account/sign-up
    authentication none
    input SignUp (body)
    status 204
    fails email_taken

GET /cakes
    authentication none
    input MenuFilter (query)
    output Page<CakeView>
    status 200

GET /cakes/{cake_id: Uuid}
    authentication none
    output CakeView
    status 200
    fails cake_not_found

GET /devices
    caller user
    output List<IssuedToken>
    status 200

POST /devices
    caller user
    output PhoneLinked
    status 201

DELETE /devices/{phone_token_id: Uuid}
    status 204

GET /openapi.json
    generated openapi
    status 200

GET /outlets
    authentication none
    output List<OutletView>
    status 200

output CakeView
    flavour: Flavour
    id: Uuid
    name: Text { min_length: 1, max_length: 60 }
    price: Int { min: 0 }

input ChangeOrder
    collect_on: CalendarDate
    quantity: Int { min: 1, max: 12 }

enum Flavour
    variant carrot
    variant chocolate
    variant coffee
    variant lemon

output IssuedToken
    ends_at: Instant
    id: Uuid
    started_at: Instant

input MenuFilter
    after: PageCursor optional
    flavours: List<Flavour> optional
    page_size: PageSize { min: 1, max: 100 } default 20

output OrderView
    cake: CakeView
    collect_on: CalendarDate
    id: Uuid
    quantity: Int { min: 1, max: 12 }

output OutletView
    id: Uuid
    name: Text { min_length: 1, max_length: 40 }

output PhoneLinked
    token: ApiToken

input PlaceOrder
    app_version: Text { pattern: "[0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}" } header "X-App-Version" optional
    cake_id: Uuid
    collect_on: CalendarDate
    outlet_id: Uuid
    quantity: Int { min: 1, max: 12 }

input SignUp
    email: Email
    name: Text { min_length: 1, max_length: 80 }

failure cake_not_found
    status 404

failure cake_off_menu
    status 422
    message "That cake is no longer on the menu."
    cake_id: Uuid

failure email_taken
    status 409
    message "That address already has an account."

failure order_not_found
    status 404

failure outlet_not_found
    status 404
