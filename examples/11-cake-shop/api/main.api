// Written by `jadpo api update` from the routes; never edit it by hand.
// `jadpo check` fails while it disagrees with them.
version: 2

authentication: browser_session

GET /account/orders
    output: List<OrderView>
    status: 200

POST /account/orders
    caller: user
    input: PlaceOrder (body)
    output: OrderView
    status: 201
    fails: cake_not_found 404, cake_off_menu 422, outlet_not_found 404

GET /account/orders/{order_id: Uuid}
    output: OrderView
    status: 200
    fails: order_not_found 404

PUT /account/orders/{order_id: Uuid}
    input: ChangeOrder (body)
    output: OrderView
    status: 200
    fails: order_not_found 404

POST /account/sign-out
    status: 204

POST /account/sign-up
    authentication: none
    input: SignUp (body)
    status: 204
    fails: email_taken 409

GET /cakes
    authentication: none
    input: MenuFilter (query)
    output: Page<CakeView>
    status: 200

GET /cakes/{cake_id: Uuid}
    authentication: none
    output: CakeView
    status: 200
    fails: cake_not_found 404

GET /devices
    caller: user
    output: List<IssuedToken>
    status: 200

POST /devices
    caller: user
    output: PhoneLinked
    status: 201

DELETE /devices/{phone_token_id: Uuid}
    status: 204

GET /outlets
    authentication: none
    output: List<OutletView>
    status: 200

output CakeView
    id: Uuid
    name: Text { min_length: 1, max_length: 60 }
    flavour: Flavour
    price: Int { min: 0 }

input ChangeOrder
    quantity: Int { min: 1, max: 12 }
    collect_on: CalendarDate

enum Flavour
    chocolate
    lemon
    carrot
    coffee

output IssuedToken
    id: Uuid
    started_at: Instant
    ends_at: Instant

input MenuFilter
    flavours: List<Flavour> optional
    page_size: PageSize { min: 1, max: 100 } default 20
    after: PageCursor optional

output OrderView
    id: Uuid
    quantity: Int { min: 1, max: 12 }
    collect_on: CalendarDate
    cake: CakeView

output OutletView
    id: Uuid
    name: Text { min_length: 1, max_length: 40 }

output PhoneLinked
    token: ApiToken

input PlaceOrder
    outlet_id: Uuid
    cake_id: Uuid
    quantity: Int { min: 1, max: 12 }
    collect_on: CalendarDate
    app_version: Text { pattern: "[0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}" } header "X-App-Version" optional

input SignUp
    email: Email
    name: Text { min_length: 1, max_length: 80 }

failure cake_not_found 404

failure cake_off_menu 422 "That cake is no longer on the menu."
    cake_id: Uuid

failure email_taken 409 "That address already has an account."

failure order_not_found 404

failure outlet_not_found 404
