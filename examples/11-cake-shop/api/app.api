// Written by `jadpo api update` from the routes; never edit it by hand.
// `jadpo check` fails while it disagrees with them.
version: 2

idempotency: required

GET /app/orders
    output: List<OrderView>
    status: 200

POST /app/orders
    input: PlaceOrder (body)
    output: OrderView
    status: 201
    fails: cake_not_found 404, cake_off_menu 422, shop_not_found 404

output CakeView
    id: Uuid
    name: Text { min_length: 1, max_length: 60 }
    flavour: Flavour
    price: Int { min: 0 }

enum Flavour
    chocolate
    lemon
    carrot
    coffee

output OrderView
    id: Uuid
    quantity: Int { min: 1, max: 12 }
    collect_on: CalendarDate
    cake: CakeView

input PlaceOrder
    shop_id: Uuid
    cake_id: Uuid
    quantity: Int { min: 1, max: 12 }
    collect_on: CalendarDate
    app_version: Text { pattern: "[0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}" } header "X-App-Version" optional

failure cake_not_found 404

failure cake_off_menu 422 "That cake is no longer on the menu."
    cake_id: Uuid

failure shop_not_found 404
