// Generated by Jadpo from the routes of API app; update it with `jadpo api update`, never by hand.
record api 1

api app
    authentication api_token
    idempotency required

GET /app/openapi.json
    generated openapi
    status 200

GET /app/orders
    output List<OrderView>
    status 200

POST /app/orders
    caller user
    input PlaceOrder (body)
    output OrderView
    status 201
    fails cake_not_found
    fails cake_off_menu
    fails outlet_not_found

output CakeView
    flavour: Flavour
    id: Uuid
    name: Text { min_length: 1, max_length: 60 }
    price: Money { min: 0, currency: GBP, rounding: half_even }

enum Flavour
    variant carrot
    variant chocolate
    variant coffee
    variant lemon

output OrderView
    cake: CakeView
    collect_on: CalendarDate
    id: Uuid
    quantity: Int { min: 1, max: 12 }

input PlaceOrder
    app_version: Text { pattern: "[0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}" } header "X-App-Version" optional
    cake_id: Uuid
    collect_on: CalendarDate
    outlet_id: Uuid
    quantity: Int { min: 1, max: 12 }

failure cake_not_found
    status 404

failure cake_off_menu
    status 422
    message "That cake is no longer on the menu."
    cake_id: Uuid

failure outlet_not_found
    status 404
