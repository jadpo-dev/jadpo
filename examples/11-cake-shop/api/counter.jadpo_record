// Generated by Jadpo from the routes of API counter; update it with `jadpo api update`, never by hand.
record api 1

api counter
    authentication service_key

GET /counter/handovers
    input CollectionDay (query)
    output List<OrderView>
    status 200

GET /counter/keys
    caller service
    output List<IssuedKey>
    status 200

POST /counter/keys
    caller service
    input OutletKeyRequest (body)
    output NewOutletKey
    status 201

DELETE /counter/keys/{outlet_key_id: Uuid}
    status 204

GET /counter/openapi.json
    generated openapi
    status 200

output CakeView
    flavour: Flavour
    id: Uuid
    name: Text { min_length: 1, max_length: 60 }
    price: Money { min: 0, currency: GBP, rounding: half_even }

input CollectionDay
    collect_on: CalendarDate

enum Flavour
    variant carrot
    variant chocolate
    variant coffee
    variant lemon

output IssuedKey
    ends_at: Instant
    id: Uuid
    started_at: Instant

output NewOutletKey
    key: ServiceKey

output OrderView
    cake: CakeView
    collect_on: CalendarDate
    id: Uuid
    quantity: Int { min: 1, max: 12 }

input OutletKeyRequest
    key_expires_at: Instant
