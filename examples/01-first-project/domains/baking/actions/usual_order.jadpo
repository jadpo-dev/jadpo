// A second action, in its own file. It uses `Grams` and calls
// `weigh_loaves`, both declared in other files of this domain, so it
// imports both: a domain's own names come in by folder too, and the call
// stays bare, `weigh_loaves(...)`.

use baking/types { Grams }
use baking/actions { weigh_loaves }

/// The bakery's usual order: four loaves at 250 grams, packed in a 150 gram box.
action usual_order() -> Grams {
    var loaves: Grams = weigh_loaves(250, 4)
    return Grams(loaves + 150)
}
