// A second action, in its own file. It uses `Pence` and calls
// `price_loaves`, both declared in other files of this domain, so it
// imports both: a domain's own names come in by folder too, and the call
// stays bare, `price_loaves(...)`.

use baking/types { Pence }
use baking/actions { price_loaves }

/// The bakery's usual order: four loaves at 250 pence, delivered for 150.
action usual_order() -> Pence {
    var loaves: Pence = price_loaves(250, 4)
    return Pence(loaves + 150)
}
