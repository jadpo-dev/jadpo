// An action is an operation the application offers. Each action has its
// own file in its domain's `actions/` folder, named after it, so a search
// for a name always finds exactly one file.
//
// A file opens with `use` lines naming where every name it uses, but
// doesn't declare, comes from. `use baking/types { Grams }` brings in
// `Grams` from the folder `domains/baking/types/`, where it is in
// `grams.jadpo`. So every name in a file is on a `use` line, built in
// (`Int`, `Bool`), or declared in the file itself. `jadpo fmt` adds a
// missing `use` line and removes one nothing needs.

use baking/types { Grams }

// Types and helpers that only this action uses live here too, after it:
// the declaration a file is named after comes first, and everything else
// in the file is there for it. `LoafCount` and `Grams` are both whole
// numbers, but Jadpo treats them as different types, so one can never be
// passed where the other is expected.

/// How many loaves one customer may buy at once.
type LoafCount = Int {
    min: 1
    max: 50
}

// A function is pure: it works its result out from its arguments and
// nothing else. A helper used only in this file is called by its bare
// name. `///` above a declaration describes it, for editors and generated
// documentation; `//` comments like this one are notes for the reader.

/// The weight of `loaves` loaves at `each` grams a loaf.
function loaves_weight(each: Grams, loaves: LoafCount) -> Grams {
    // Arithmetic works on the representation, so `each * loaves` is a
    // plain `Int`. `Grams(...)` turns it back into `Grams` by checking the
    // rules; it is validation, never a cast. Both sides are at least 0 and
    // `Grams` has no maximum, so the compiler can prove it never fails.
    return Grams(each * loaves)
}

/// What a customer pays for `loaves` loaves: more than three need a
/// paper bag, which weighs 5 grams.
action weigh_loaves(each: Grams, loaves: LoafCount) -> Grams {
    // Every variable states its type. `var` names a value that never
    // changes; example 04 shows `var mut` for one that does.
    var total: Grams = loaves_weight(each, loaves)
    // A condition is always in brackets and must be a `Bool`: Jadpo has no
    // truthiness. Comparing a `LoafCount` with the literal 3 is fine,
    // because a literal takes the type of the other side.
    if (loaves > 3) {
        return Grams(total + 5)
    }
    return total
}
