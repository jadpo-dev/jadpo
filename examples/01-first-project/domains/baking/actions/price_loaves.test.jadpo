// Tests sit beside the file they test, named `<file>.test.jadpo`, and hold
// only `test` declarations. Run them with `jadpo test` from anywhere in
// the project.
//
// A test is a sentence and a body. The body is ordinary code plus
// `assert`, which fails the test when its condition is false. Literals
// such as `250` take the type of the parameter they are passed to, and the
// compiler checks them against its rules: passing `0` loaves would not
// compile, because `LoafCount` starts at 1.

test "one loaf costs its price" {
    assert price_loaves(250, 1) == 250
}

test "four loaves come with a 5 pence bag" {
    var paid: Pence = price_loaves(250, 4)
    assert paid == 1005
}
