use sales/failures { OrderTooLarge }

test "a small order doubles" {
    var doubled: DoubledOrder = attempt double_order(6)
    assert doubled == DoubledOrder {
        cakes: 12
        slices: 144
    }
}

test "an order of more than 12 can't double" {
    assert double_order(13) fails OrderTooLarge
}
