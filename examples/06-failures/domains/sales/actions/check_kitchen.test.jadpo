test "a quiet kitchen with one oven lit takes orders" {
    // A `Unit` action that can fail is called with `attempt` on its own
    // line: its result isn't needed, only whether it failed.
    attempt check_kitchen(3, 1)
}

test "a busy hour needs more ovens lit" {
    attempt check_kitchen(25, 3)
    assert check_kitchen(25, 2) fails KitchenBusy
}

test "cold ovens turn every order away" {
    assert check_kitchen(3, 0) fails OvenDown
}
