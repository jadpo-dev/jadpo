test "an order the kitchen and the shelf can meet is placed" {
    var placed: CakeCount = attempt place_order(10, 2, 5, 1)
    assert placed == 2
}

test "each check passes its own failure on" {
    assert place_order(10, 2, 5, 0) fails OvenDown
    assert place_order(10, 2, 30, 3) fails KitchenBusy
    assert place_order(1, 2, 5, 1) fails CakeSoldOut
}
