// An action that returns nothing returns `Unit`. A failure with no fields
// is rejected by its name alone, and a bare `return` leaves a `Unit`
// action early.

/// Whether the kitchen can take another order now.
action check_kitchen(load: HourlyLoad, ovens: OvensLit) fails KitchenBusy, OvenDown -> Unit {
    if (ovens == 0) {
        reject OvenDown
    }
    if (load < 20) {
        // One oven copes with a quiet hour, so it needs no more checks.
        return
    }
    // A busy hour takes ten orders for each lit oven. `ovens * 10` is from
    // 0 to 30, so it always fits `HourlyLoad`, and the two loads compare.
    var capacity: HourlyLoad = HourlyLoad(ovens * 10)
    if (load >= capacity) {
        reject KitchenBusy
    }
}
