// A check that can fail at runtime. `Type(value)` checks a value against
// a type's rules. When the value is a literal, the compiler checks it
// while compiling. When it is computed and neither the declared ranges
// nor a condition around it (`double_if_room.jadpo`) prove it follows
// every rule, building it can fail, and the code says what each failure
// is in a block after the call, keyed by the rule that can break:
// `attempt CakeCount(n) { max: OrderTooLarge }`. Every failure named there
// has the kind `invalid_value`: a value broke a type's rule.

use sales/types { CakeCount }
use sales/failures { OrderTooLarge }

/// The same order twice over, as a party often asks, and the slices it
/// cuts into.
action double_order(count: CakeCount) fails OrderTooLarge -> DoubledOrder {
    // `count * 2` is at least 2, so `min: 1` always holds, but it can
    // reach 48, past `max: 24`. Only `max` can break, so it has the one
    // arm. An arm for `min` would be an error: it could never run.
    var doubled: CakeCount = attempt CakeCount(count * 2) {
        max: OrderTooLarge
    }
    return DoubledOrder {
        cakes: doubled
        slices: slices_in(doubled)
    }
}

/// A doubled order: its cakes, and the slices they cut into, which a
/// party plans by.
type DoubledOrder = Output {
    cakes: CakeCount
    slices: SliceCount
}

/// A number of slices, never negative.
type SliceCount = Int {
    min: 0
}

/// How many slices `cakes` cakes cut into, at 12 a cake.
function slices_in(cakes: CakeCount) -> SliceCount {
    // `cakes` is at least 1, so the product is at least 12, and
    // `SliceCount` has no maximum: the compiler proves this can't fail,
    // so it takes no `attempt`. (Writing one would be an error.)
    return SliceCount(cakes * 12)
}
