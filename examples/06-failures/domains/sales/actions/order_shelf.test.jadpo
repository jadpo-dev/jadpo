use sales/types { CakeCount }
use sales/failures { OrderTooLarge, ShelfEmpty }

test "a shelf of 10 is one order" {
    var count: CakeCount = attempt order_shelf(10)
    assert count == 10
}

test "an empty shelf and a shelf too big for one order fail differently" {
    assert order_shelf(30) fails OrderTooLarge
    assert order_shelf(0) fails ShelfEmpty
}
