// A named collection's rules break as a number's do.

/// The orders baked together on one tray: at least one, and no more than
/// the oven takes.
type Tray = List<CakeCount> {
    min_length: 1
    max_length: 4
}

/// The orders waiting to be baked, put on one tray.
action fill_tray(waiting: List<CakeCount>) fails NothingToBake, TrayFull -> Tray {
    // `waiting` already holds `CakeCount`s, so building a `Tray` from it
    // checks only the list's own rules: no orders breaks `min_length`,
    // too many breaks `max_length`, and each gets its arm, as `min` and
    // `max` do. A bound on `collection.count(waiting)` before it would
    // prove them, as a condition proves a number.
    var tray: Tray = attempt Tray(waiting) {
        min_length: NothingToBake
        max_length: TrayFull
    }
    return tray
}
