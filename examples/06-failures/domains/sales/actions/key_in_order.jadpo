// `invalid:` on its own: one failure for every rule that can break.

use sales/types { CakeCount }
use sales/failures { CountOutOfRange }

/// A number of cakes as a counter assistant keys it in at the till: any
/// whole number at all, until it is checked.
type KeyedCount = Int {}

/// An order for the number of cakes keyed in at the till.
action key_in_order(entered: KeyedCount) fails CountOutOfRange -> CakeCount {
    // A keyed number can break both `min: 1` and `max: 24`, but the till
    // says the same thing either way, "enter 1 to 24", so `invalid:`
    // alone covers every rule with the one failure. `invalid:` covers only
    // a construction's rules: when data arrives, a write's conditions and
    // an integration call's (areas 6 and 11) each need their own arm.
    var count: CakeCount = attempt CakeCount(entered) {
        invalid: CountOutOfRange
    }
    return count
}
