// Generated by Jadpo from the routes of API main; update it with `jadpo api update`, never by hand.
record api 1

POST /api/queue
    authentication none
    input QueueInput (body)
    output QueueAccepted
    status 202

GET /openapi.json
    generated openapi
    authentication none
    status 200

output QueueAccepted
    ticket: Text { min_length: 1, max_length: 80 }

input QueueInput
    ticket: Text { min_length: 1, max_length: 80 }
