PasswordPolicy: every form its examples take (area 19, "Changing a standard type's encoding")
encoding 1
column min_length smallint
column max_length smallint
column check_breached boolean

example {"min_length":"15","max_length":"64","check_breached":true}
text none
json {"min_length":15,"max_length":64,"check_breached":true}
stored min_length 15
stored max_length 64
stored check_breached TRUE

example {"min_length":"8","max_length":"256","check_breached":false}
text none
json {"min_length":8,"max_length":256,"check_breached":false}
stored min_length 8
stored max_length 256
stored check_breached FALSE
