// The project every golden SQL file in this folder is planned from: one
// query per shape area 6 decides, the entities' `get`, and one action per
// write shape.

type UserName = Text {
    max_length: 80
}

type ProjectName = Text {
    max_length: 80
}

type TodoTitle = Text {
    max_length: 200
}

type Bio = Text {
    max_length: 400
}

type TodoStatus = Enum {
    open
    waiting
    done
}

type Score = Int {
    min: 0
    max: 1000
}

type ViewCount = Int {
    min: 0
}

type CommentBody = Text {
    max_length: 400
}

type UserView = Output {
    pick: [User.id, User.name]
}

type ProfileView = Output {
    pick: [Profile.bio]
}

type UserCard = Output {
    pick: [User.id, User.name]
    profile: ProfileView?
}

type TodoView = Output {
    pick: [Todo.id, Todo.title, Todo.status]
}

type TodoWithOwner = Output {
    pick: [Todo.id, Todo.title]
    owner: UserView
}

type ProjectBoardView = Output {
    pick: [Project.id, Project.name]
    owner: UserCard
    todos: List<TodoWithOwner>
}

type ListTodos = Input {
    status: TodoStatus {
        optional: true
    }
    due_before: Instant {
        optional: true
    }
    page_size: PageSize {
        default: 25
    }
    after: PageCursor {
        optional: true
    }
}

type ProjectNotFound = Failure {
    kind: FailureKind.not_found
    client: {
        project_id: Project.id
    }
}

type TodoNotFound = Failure {
    kind: FailureKind.not_found
}

entity User {
    id: Uuid
    email: Email {
        unique: true
    }
    name: UserName
}

entity Profile {
    id: Uuid
    user_id: User.id {
        on_delete: OnDelete.cascade
        unique: true
    }
    bio: Bio
}

entity Project {
    id: Uuid
    owner_id: User.id {
        on_delete: OnDelete.cascade
    }
    name: ProjectName
    views: ViewCount
}

entity Todo {
    id: Uuid
    owner_id: User.id {
        on_delete: OnDelete.cascade
    }
    project_id: Project.id? {
        on_delete: OnDelete.cleared
    }
    title: TodoTitle
    status: TodoStatus
    score: Score
    due_at: Instant?
    created_at: Instant {
        generated: Generated.on_create
    }
    updated_at: Instant {
        generated: Generated.on_change
    }
}

entity Comment {
    id: Uuid
    todo_id: Todo.id {
        on_delete: OnDelete.restricted
    }
    body: CommentBody
}

/// Exactly one record, or the `missing:` failure with its fields.
query project_by_id(project_id: Project.id) fails ProjectNotFound -> Project {
    from: Project
    where: Project.id == project_id
    missing: ProjectNotFound {
        project_id: project_id
    }
}

/// At most one record, by a unique field.
query user_by_email(email: User.email) -> UserView? {
    from: User
    where: User.email == email
}

/// A bounded list: `in`, `or`, `none`, `not` and `clock.now`.
query todos_by_ids(todo_ids: List<Todo.id>) -> List<TodoView> {
    from: Todo
    where: Todo.id in todo_ids
    where: Todo.due_at == none or Todo.due_at > clock.now
    where: Todo.status in [TodoStatus.open, TodoStatus.waiting]
    where: not (Todo.score < 10)
    where: Todo.project_id != none and not (Todo.due_at < clock.now)
    order: [Todo.created_at asc]
    limit: 100
}

/// A page: optional filters, and a cursor over one direction.
query todos_for_owner(owner_id: User.id, filter: ListTodos) -> Page<TodoView> {
    from: Todo
    where: Todo.owner_id == owner_id
    where_present: Todo.status == filter.status
    where_present: Todo.due_at <= filter.due_before
    order: [Todo.created_at desc]
    page: {
        size: filter.page_size
        after: filter.after
    }
}

/// A page over two directions, sorted by text.
query todos_by_title(owner_id: User.id, after: PageCursor?) -> Page<TodoView> {
    from: Todo
    where: Todo.owner_id == owner_id
    order: [Todo.title asc, Todo.score desc]
    page: {
        size: 20
        after: after
    }
}

/// Includes: a parent with its unique child, and children ordered and
/// limited per record, each with its parent.
query project_board(project_id: Project.id) fails ProjectNotFound -> ProjectBoardView {
    from: Project
    where: Project.id == project_id
    missing: ProjectNotFound {
        project_id: project_id
    }
    include: {
        owner: {
            via: Project.owner_id
            include: {
                profile: Profile.user_id
            }
        }
        todos: {
            via: Todo.project_id
            where: Todo.status != TodoStatus.done
            order: [Todo.created_at asc]
            limit: 50
            include: {
                owner: Todo.owner_id
            }
        }
    }
}

type EditTodo = Input {
    pick: [Todo.title, Todo.due_at, Todo.project_id]
    optional: all
}

type EmailTaken = Failure {
    kind: FailureKind.conflict
}

type UserHasComments = Failure {
    kind: FailureKind.conflict
}

/// A create mapping a unique field.
action sign_up(email: User.email, name: User.name) fails EmailTaken -> User {
    return attempt User.create {
        set: {
            email: email
            name: name
        }
        conflict: {
            User.email: EmailTaken
        }
    }
}

/// A create whose reference may name a user that isn't there.
action add_todo(owner_id: User.id, title: Todo.title) fails UserNotFound -> Todo {
    return attempt Todo.create {
        set: {
            owner_id: owner_id
            project_id: none
            title: title
            status: TodoStatus.open
            score: 0
            due_at: none
        }
    }
}

/// An update of a record loaded earlier.
action finish(todo: Todo) -> Todo {
    return Todo.update(todo) {
        set: {
            status: TodoStatus.done
        }
    }
}

/// A patch, with a field set when another is supplied.
action edit(todo: Todo, changes: EditTodo) fails ProjectNotFound -> Todo {
    return attempt Todo.update(todo) {
        patch: changes
        when_supplied: {
            title: {
                status: TodoStatus.open
            }
        }
    }
}

/// A counter, worked out by the database, by `id`.
action viewed(project_id: Project.id) fails ProjectNotFound -> Project {
    return attempt Project.update(project_id) {
        set: {
            views: ViewCount(Project.views + 1)
        }
    }
}

/// A delete by `id`, refused by a reference its cascade reaches.
action leave(user_id: User.id) fails UserNotFound, UserHasComments -> Unit {
    attempt User.delete(user_id) {
        conflict: {
            Comment.todo_id: UserHasComments
        }
    }
}

/// A delete of a record loaded earlier.
action drop_profile(profile: Profile) -> Unit {
    Profile.delete(profile)
}

// Lifecycles (area 5): records hidden from every read, update and delete,
// transitions, and purge.

type BoardName = Text {
    max_length: 80
}

type Stage = Enum {
    draft
    live
    archived
}

type BoardView = Output {
    pick: [Board.id, Board.name]
}

type CardView = Output {
    pick: [Card.id, Card.stage]
}

type BoardWithCards = Output {
    pick: [Board.id, Board.name]
    cards: List<CardView>
}

type CardWithBoard = Output {
    pick: [Card.id, Card.stage]
    board: BoardView
}

type CardArchived = Failure {
    kind: FailureKind.conflict
}

type BoardNamed = Failure {
    kind: FailureKind.conflict
}

/// A soft delete, purged a month after.
entity Board {
    id: Uuid
    name: BoardName
    deleted_at: Instant?

    lifecycle: {
        visible: deleted_at == none
        transitions: {
            delete: {
                set: {
                    deleted_at: clock.now
                }
            }
        }
        purge: {
            after: 30d
            since: deleted_at
        }
    }
}

/// Scheduled publishing, and a guarded transition.
entity Card {
    id: Uuid
    board_id: Board.id {
        on_delete: OnDelete.cascade
    }
    stage: Stage
    published_at: Instant?
    archived_at: Instant?
    changed_at: Instant {
        generated: Generated.on_change
    }

    lifecycle: {
        visible: published_at != none and published_at <= clock.now
        initial: {
            stage: Stage.draft
        }
        transitions: {
            archive: {
                when: stage == Stage.live
                set: {
                    stage: Stage.archived
                    archived_at: clock.now
                }
            }
        }
    }
}

/// Holds a card, which keeps its board from being purged.
entity Pin {
    id: Uuid
    card_id: Card.id {
        on_delete: OnDelete.restricted
    }
}

/// Holds a board directly.
entity Banner {
    id: Uuid
    board_id: Board.id {
        on_delete: OnDelete.restricted
    }
}

/// Visible records only, with a partial index.
query boards_named(name: Board.name) -> List<BoardView> {
    from: Board
    where: Board.name == name
    order: [Board.id asc]
    limit: 10
}

/// Children through their lifecycle, which reads the clock.
query board_cards(board_id: Board.id) -> BoardWithCards? {
    from: Board
    where: Board.id == board_id
    include: {
        cards: {
            via: Card.board_id
            order: [Card.published_at desc]
            limit: 20
        }
    }
}

/// A parent is included even when its lifecycle hides it.
query card_with_board(card_id: Card.id) -> CardWithBoard? {
    from: Card
    where: Card.id == card_id
    include: {
        board: Card.board_id
    }
}

/// A create filling what the lifecycle owns from `initial:`.
action add_card(board: Board) -> Card {
    return Card.create {
        set: {
            board_id: board.id
            published_at: none
        }
    }
}

/// An update of a visible record.
action rename_board(board: Board, name: Board.name) -> Board {
    return Board.update(board) {
        set: {
            name: name
        }
    }
}

/// A delete that runs the lifecycle's `delete` transition, by `id`.
action close_board(board_id: Board.id) fails BoardNotFound -> Unit {
    attempt Board.delete(board_id)
}

/// A transition whose `when:` can refuse a visible record.
action archive_card(card: Card) fails CardArchived -> Card {
    return attempt Card.archive(card) {
        conflict: {
            Card.archive: CardArchived
        }
    }
}

/// The same, by `id`.
action archive_card_by_id(card_id: Card.id) fails CardNotFound, CardArchived -> Card {
    return attempt Card.archive(card_id) {
        conflict: {
            Card.archive: CardArchived
        }
    }
}
