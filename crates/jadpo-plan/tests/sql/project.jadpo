// The project every golden SQL file in this folder is planned from: one
// query per shape area 6 decides, the entities' `get`, and one action per
// write shape.

type UserName = Text {
    max_length: 80
}

type ProjectName = Text {
    max_length: 80
}

type TodoTitle = Text {
    max_length: 200
}

type Bio = Text {
    max_length: 400
}

type TodoStatus = Enum {
    open
    waiting
    done
}

type Score = Int {
    min: 0
    max: 1000
}

type ViewCount = Int {
    min: 0
}

type CommentBody = Text {
    max_length: 400
}

type UserView = Output {
    pick: [User.id, User.name]
}

type ProfileView = Output {
    pick: [Profile.bio]
}

type UserCard = Output {
    pick: [User.id, User.name]
    profile: ProfileView?
}

type TodoView = Output {
    pick: [Todo.id, Todo.title, Todo.status]
}

type TodoWithOwner = Output {
    pick: [Todo.id, Todo.title]
    owner: UserView
}

type ProjectBoardView = Output {
    pick: [Project.id, Project.name]
    owner: UserCard
    todos: List<TodoWithOwner>
}

type ListTodos = Input {
    status: TodoStatus {
        optional: true
    }
    due_before: Instant {
        optional: true
    }
    page_size: PageSize {
        default: 25
    }
    after: PageCursor {
        optional: true
    }
}

type ProjectNotFound = Failure {
    kind: FailureKind.not_found
    client: {
        project_id: Project.id
    }
}

type TodoNotFound = Failure {
    kind: FailureKind.not_found
}

entity User {
    id: Uuid
    email: Email {
        unique: true
    }
    name: UserName

    policy: {
        create: [Access.public]
        read: [id, Access.authenticated]
        update: [id]
    }
}

principal {
    user: {
        subject: User.email
    }
}

entity Profile {
    id: Uuid
    user_id: User.id {
        on_delete: OnDelete.cascade
        unique: true
    }
    bio: Bio

    policy: {
        create: [user_id]
        read: [user_id]
        update: [user_id]
    }
}

entity Project {
    id: Uuid
    owner_id: User.id {
        on_delete: OnDelete.cascade
    }
    name: ProjectName
    views: ViewCount

    policy: {
        create: [owner_id]
        read: [owner_id, Access.authenticated]
        update: [owner_id]
        delete: [owner_id]
    }
}

entity Todo {
    id: Uuid
    owner_id: User.id {
        on_delete: OnDelete.cascade
    }
    project_id: Project.id? {
        on_delete: OnDelete.cleared
    }
    title: TodoTitle
    status: TodoStatus
    score: Score
    due_at: Instant?
    created_at: Instant {
        generated: Generated.on_create
    }
    updated_at: Instant {
        generated: Generated.on_change
    }

    policy: {
        create: [owner_id]
        read: [owner_id]
        update: [owner_id]
        delete: [owner_id]
    }
}

type Amount = Int {
    min: 0
}

/// A field only its owner reads and changes, and one no client may.
entity Ledger {
    id: Uuid
    owner_id: User.id {
        on_delete: OnDelete.cascade
    }
    title: ProjectName
    balance: Amount {
        policy: {
            read: [owner_id]
            update: [owner_id]
        }
    }
    import_reference: ProjectName? {
        policy: FieldAccess.server_only
    }

    policy: {
        create: [owner_id]
        read: [owner_id, Access.authenticated]
        update: [owner_id, Access.authenticated]
    }
}

type EditLedger = Input {
    pick: [Ledger.title, Ledger.balance]
    optional: all
}

/// A create setting a field no client may, unless it sets nothing.
action open_ledger(owner: Principal.user, title: ProjectName, reference: ProjectName?) -> Ledger {
    return Ledger.create {
        set: {
            owner_id: owner.id
            title: title
            balance: 0
            import_reference: reference
        }
    }
}

/// An update by `id` changing a field its own policy narrows.
action set_balance(ledger_id: Ledger.id, balance: Amount) fails LedgerNotFound -> Ledger {
    return attempt Ledger.update(ledger_id) {
        set: {
            balance: balance
        }
    }
}

/// A patch, whose field's own policy applies when the field is supplied.
action edit_ledger(ledger_id: Ledger.id, input: EditLedger) fails LedgerNotFound -> Ledger {
    return attempt Ledger.update(ledger_id) {
        patch: input
    }
}

entity Comment {
    id: Uuid
    todo_id: Todo.id {
        on_delete: OnDelete.restricted
    }
    body: CommentBody

    policy: {
        create: [Access.authenticated]
        read: [Access.public]
        delete: [Access.authenticated]
    }
}

/// Exactly one record, or the `missing:` failure with its fields.
query project_by_id(project_id: Project.id) fails ProjectNotFound -> Project {
    from: Project
    where: Project.id == project_id
    missing: ProjectNotFound {
        project_id: project_id
    }
}

/// At most one record, by a unique field.
query user_by_email(email: User.email) -> UserView? {
    from: User
    where: User.email == email
}

/// A bounded list: `in`, `or`, `none`, `not` and `clock.now`.
query todos_by_ids(todo_ids: List<Todo.id>) -> List<TodoView> {
    from: Todo
    where: Todo.id in todo_ids
    where: Todo.due_at == none or Todo.due_at > clock.now
    where: Todo.status in [TodoStatus.open, TodoStatus.waiting]
    where: not (Todo.score < 10)
    where: Todo.project_id != none and not (Todo.due_at < clock.now)
    order: [Todo.created_at asc]
    limit: 100
}

/// A page: optional filters, and a cursor over one direction.
query todos_for_owner(owner_id: User.id, filter: ListTodos) -> Page<TodoView> {
    from: Todo
    where: Todo.owner_id == owner_id
    where_present: Todo.status == filter.status
    where_present: Todo.due_at <= filter.due_before
    order: [Todo.created_at desc]
    page: {
        size: filter.page_size
        after: filter.after
    }
}

/// A page over two directions, sorted by text.
query todos_by_title(owner_id: User.id, after: PageCursor?) -> Page<TodoView> {
    from: Todo
    where: Todo.owner_id == owner_id
    order: [Todo.title asc, Todo.score desc]
    page: {
        size: 20
        after: after
    }
}

/// Includes: a parent with its unique child, and children ordered and
/// limited per record, each with its parent.
query project_board(project_id: Project.id) fails ProjectNotFound -> ProjectBoardView {
    from: Project
    where: Project.id == project_id
    missing: ProjectNotFound {
        project_id: project_id
    }
    include: {
        owner: {
            via: Project.owner_id
            include: {
                profile: Profile.user_id
            }
        }
        todos: {
            via: Todo.project_id
            where: Todo.status != TodoStatus.done
            order: [Todo.created_at asc]
            limit: 50
            include: {
                owner: Todo.owner_id
            }
        }
    }
}

type EditTodo = Input {
    pick: [Todo.title, Todo.due_at, Todo.project_id]
    optional: all
}

type EmailTaken = Failure {
    kind: FailureKind.conflict
}

type UserHasComments = Failure {
    kind: FailureKind.conflict
}

/// A create mapping a unique field.
action sign_up(email: User.email, name: User.name) fails EmailTaken -> User {
    return attempt User.create {
        set: {
            email: email
            name: name
        }
        conflict: {
            User.email: EmailTaken
        }
    }
}

/// A create whose reference may name a project that isn't there, owned
/// by the caller, as its `create:` needs.
action add_todo(owner: Principal.user, project_id: Project.id, title: Todo.title) fails ProjectNotFound -> Todo {
    return attempt Todo.create {
        set: {
            owner_id: owner.id
            project_id: project_id
            title: title
            status: TodoStatus.open
            score: 0
            due_at: none
        }
    }
}

/// An update of a record loaded earlier.
action finish(todo: Todo) -> Todo {
    return Todo.update(todo) {
        set: {
            status: TodoStatus.done
        }
    }
}

/// A patch, with a field set when another is supplied.
action edit(todo: Todo, changes: EditTodo) fails ProjectNotFound -> Todo {
    return attempt Todo.update(todo) {
        patch: changes
        when_supplied: {
            title: {
                status: TodoStatus.open
            }
        }
    }
}

/// A counter, worked out by the database, by `id`.
action viewed(project_id: Project.id) fails ProjectNotFound -> Project {
    return attempt Project.update(project_id) {
        set: {
            views: ViewCount(Project.views + 1)
        }
    }
}

/// A delete by `id`, refused by a reference its cascade reaches.
action leave(user_id: User.id) fails UserNotFound, UserHasComments -> Unit {
    attempt User.delete(user_id) {
        conflict: {
            Comment.todo_id: UserHasComments
        }
    }
}

/// A delete of a record loaded earlier.
action drop_profile(profile: Profile) -> Unit {
    Profile.delete(profile)
}

// Lifecycles (area 5): records hidden from every read, update and delete,
// transitions, and purge.

type BoardName = Text {
    max_length: 80
}

type Stage = Enum {
    draft
    live
    archived
}

type BoardView = Output {
    pick: [Board.id, Board.name]
}

type CardView = Output {
    pick: [Card.id, Card.stage]
}

type BoardWithCards = Output {
    pick: [Board.id, Board.name]
    cards: List<CardView>
}

type CardWithBoard = Output {
    pick: [Card.id, Card.stage]
    board: BoardView
}

type CardArchived = Failure {
    kind: FailureKind.conflict
}

type BoardNamed = Failure {
    kind: FailureKind.conflict
}

/// A soft delete, purged a month after.
entity Board {
    id: Uuid
    name: BoardName
    deleted_at: Instant?

    lifecycle: {
        visible: deleted_at == none
        transitions: {
            delete: {
                set: {
                    deleted_at: clock.now
                }
            }
        }
        purge: {
            after: 30d
            since: deleted_at
        }
    }
}

/// Scheduled publishing, and a guarded transition.
entity Card {
    id: Uuid
    board_id: Board.id {
        on_delete: OnDelete.cascade
    }
    stage: Stage
    published_at: Instant?
    archived_at: Instant?
    changed_at: Instant {
        generated: Generated.on_change
    }

    lifecycle: {
        visible: published_at != none and published_at <= clock.now
        initial: {
            stage: Stage.draft
        }
        transitions: {
            archive: {
                when: stage == Stage.live
                set: {
                    stage: Stage.archived
                    archived_at: clock.now
                }
            }
        }
    }
}

/// Holds a card, which keeps its board from being purged.
entity Pin {
    id: Uuid
    card_id: Card.id {
        on_delete: OnDelete.restricted
    }
}

/// Holds a board directly.
entity Banner {
    id: Uuid
    board_id: Board.id {
        on_delete: OnDelete.restricted
    }
}

/// Visible records only, with a partial index.
query boards_named(name: Board.name) -> List<BoardView> {
    from: Board
    where: Board.name == name
    order: [Board.id asc]
    limit: 10
}

/// Children through their lifecycle, which reads the clock.
query board_cards(board_id: Board.id) -> BoardWithCards? {
    from: Board
    where: Board.id == board_id
    include: {
        cards: {
            via: Card.board_id
            order: [Card.published_at desc]
            limit: 20
        }
    }
}

/// A parent is included even when its lifecycle hides it.
query card_with_board(card_id: Card.id) -> CardWithBoard? {
    from: Card
    where: Card.id == card_id
    include: {
        board: Card.board_id
    }
}

/// A create filling what the lifecycle owns from `initial:`.
action add_card(board: Board) -> Card {
    return Card.create {
        set: {
            board_id: board.id
            published_at: none
        }
    }
}

/// An update of a visible record.
action rename_board(board: Board, name: Board.name) -> Board {
    return Board.update(board) {
        set: {
            name: name
        }
    }
}

/// A delete that runs the lifecycle's `delete` transition, by `id`.
action close_board(board_id: Board.id) fails BoardNotFound -> Unit {
    attempt Board.delete(board_id)
}

/// A transition whose `when:` can refuse a visible record.
action archive_card(card: Card) fails CardArchived -> Card {
    return attempt Card.archive(card) {
        conflict: {
            Card.archive: CardArchived
        }
    }
}

/// The same, by `id`.
action archive_card_by_id(card_id: Card.id) fails CardNotFound, CardArchived -> Card {
    return attempt Card.archive(card_id) {
        conflict: {
            Card.archive: CardArchived
        }
    }
}

/// A help article's meaning, compared by straight-line distance.
type ArticleMeaning = Vector {
    dimensions: 3
    distance: VectorDistance.euclidean
}

type ArticleTitle = Text {
    max_length: 80
}

entity HelpArticle {
    id: Uuid
    title: ArticleTitle
    shown_publicly: Bool
    body_meaning: ArticleMeaning?

    policy: {
        read: [Access.public]
    }
}

/// Without the `id`, which the tie-break selects anyway.
type ArticleExcerpt = Output {
    pick: [HelpArticle.title]
}

/// A nearest-neighbour query (area 21): its search settings, the distance
/// as a column and a filter, and the `id` tie-break outside the order the
/// index serves.
query closest_articles(question_meaning: ArticleMeaning) -> List<Nearest<ArticleExcerpt>> {
    from: HelpArticle
    where: HelpArticle.shown_publicly == true
    where: ai.distance(HelpArticle.body_meaning, question_meaning) <= 0.6
    order: [HelpArticle.body_meaning nearest question_meaning]
    limit: 50
}

type Courier = Text {
    max_length: 40
}

type DeliveryState = Enum {
    booked
    sent
    lost
}

type DeliveryDay = CalendarDate {}

type StopCount = Int {
    min: 0
}

type DeliveryWeight = Mass {}

type DeliveryFee = Money {
    currency: Currency.eur
}

type FeeRate = Decimal {
    scale: 2
}

entity Delivery {
    id: Uuid
    courier: Courier
    state: DeliveryState
    sent_on: DeliveryDay
    stops: StopCount?
    weight: DeliveryWeight
    fee: DeliveryFee
    rate: FeeRate

    policy: {
        read: [Access.public]
    }
}

type CourierYear = Output {
    courier: Courier
    sent_year: Int
    state: DeliveryState
    deliveries: Int
    total_weight: Mass
    total_fee: Money
    total_rate: Decimal
    fewest_stops: Delivery.stops
    mean_stops: Decimal?
}

/// An aggregate query (chunk 5.6c): a text, a time bucket and an enum as
/// groups, the enum and the text sorted in Jadpo's order as the
/// tie-break, a quantity, money and decimal summed, and an average of a
/// field that may be `none`.
query courier_years(since: DeliveryDay) -> List<CourierYear> {
    from: Delivery
    where: Delivery.sent_on >= since
    group: {
        courier: Delivery.courier
        sent_year: temporal.year(Delivery.sent_on)
        state: Delivery.state
    }
    aggregate: {
        deliveries: count()
        total_weight: sum(Delivery.weight)
        total_fee: sum(Delivery.fee)
        total_rate: sum(Delivery.rate)
        fewest_stops: min(Delivery.stops)
        mean_stops: average(Delivery.stops, scale: 1, rounding: Rounding.half_up)
    }
    order: [deliveries desc]
    limit: 50
}

type DeliveryTotals = Output {
    deliveries: Int
    latest: Delivery.sent_on?
    first_courier: Delivery.courier?
}

/// One row over every delivery: a count, and `max` and `min` of none
/// when there are none.
query delivery_totals() -> DeliveryTotals {
    from: Delivery
    aggregate: {
        deliveries: count()
        latest: max(Delivery.sent_on)
        first_courier: min(Delivery.courier)
    }
}
