// The concrete syntax of Jadpo (docs/compiler-runtime.md §2.2).
//
// Written from the decided syntax of areas 1–4 (docs/language), extended to
// the shapes every other area's examples use: declarations whose bodies are
// `name: value` members, route entries keyed by method and path, and
// statement blocks. The typed AST in src/generated/ is generated from this
// file by `cargo test -p jadpo-syntax --test integration sourcegen::`,
// which fails when the two drift.
//
// Conventions (ungrammar): 'x' is a token, Name is a node, label:Rule names
// an accessor, `?` is optional and `*` repeats. Trivia (whitespace, `//`
// comments and `///` documentation comments) is never written here: it is
// kept in the tree beside the token it belongs to.

//*************************//
// Files                   //
//*************************//

// A `.jadpo` file: its `use` lines, then declarations.
SourceFile =
  UseDecl* Decl*

// A documentation example: declarations, members, route entries and
// statements, with `...` standing for code left out.
Snippet =
  SnippetItem*

SnippetItem =
  UseDecl
| Decl
| Member
| BareMember
| RouteEntry
| Stmt
| Elision

// An email template: text with Jadpo inside `{{ }}` (area 16).
Template =
  TemplateBody

//*************************//
// Imports                 //
//*************************//

// `use shared/types { Pence, Percent }` brings in names from a folder,
// written exactly as the code uses them; `use menu` brings in a domain,
// whose calls stay qualified, `menu.price_item(...)` (area 1, Imports).
UseDecl =
  'use' UsePath UseNames?

// A domain, a domain's or `shared/`'s folder, or a root file:
// `menu`, `sales/types`, `shared/libraries`, `app`.
UsePath =
  NameRef ('/' NameRef)*

UseNames =
  '{' (NameRef (',' NameRef)* ','?)? '}'

//*************************//
// Declarations            //
//*************************//

Decl =
  TypeDecl
| FunctionDecl
| ConstantDecl
| ActionDecl
| QueryDecl
| FixtureDecl
| EntityDecl
| LibraryDecl
| RoutesDecl
| ScheduleDecl
| SubscriberDecl
| TestDecl
| SeedDecl
| PackageDecl
| ResourceDecl
| ProvideDecl
| SingletonDecl

Visibility =
  'public'

// `decline library.similar_exists: "Rounds to 5p for the till"`: a line
// directly above a declaration or a member, after its `///` comments,
// answering one declinable rule there with a reason (area 1, "Declining a
// judgement call"). It is the first child of the node it stands above, so
// every declaration and member may start with `Decline*`.
Decline =
  'decline' DeclineRule ':' reason:'string'

// The rule's id, `area.name`; either part may be a reserved word
// (`library.similar_exists`, `type.standard_exists`).
DeclineRule =
  'ident' ('.' 'ident')*

Name =
  'ident'

// `type Pence = Int { min: 0 }`; every type has a base and a block (area 2).
TypeDecl =
  Visibility? 'type' Name '=' base:Type MemberList?

FunctionDecl =
  Visibility? 'function' Name ParamList FailsClause? RetType? Block

// `constant vat_rate: VatRate = 0.2000`: a fixed value at the top of a file
// or in a library, worked out while compiling (area 3, Constants).
ConstantDecl =
  Visibility? 'constant' Name ':' Type '=' value:Expr

ActionDecl =
  Visibility? 'action' Name ParamList FailsClause? RetType? Block

// A query's body is declarative: `from:`, `where:`, `missing:` (area 6).
QueryDecl =
  Visibility? 'query' Name ParamList FailsClause? RetType? MemberList

// A test-only action that builds data (area 13).
FixtureDecl =
  Visibility? 'fixture' Name ParamList? RetType? Block

EntityDecl =
  Visibility? 'entity' Name MemberList

LibraryDecl =
  Visibility? 'library' Name MemberList

RoutesDecl =
  'routes' Name MemberList

ScheduleDecl =
  'schedule' Name MemberList

SubscriberDecl =
  'subscriber' Name MemberList

TestDecl =
  'test' 'string' Block

SeedDecl =
  'seed' Name? Block

// `package AcmeCouriers.v1 { ... }`, a provider package's index (area 11).
PackageDecl =
  'package' Path MemberList

// `public resource bookings { ... }`: a provider package's operations
// (area 11); `public` makes it part of the package's API.
ResourceDecl =
  Visibility? 'resource' Name MemberList

ProvideDecl =
  'provide' Name MemberList

// Declarations that exist once per project carry no name (area 1):
// `application`, `config`, `principal`, `authentication`, `policy`,
// `flags`, `migration`, `acceptance`, `locales` and `suggestions` (area
// 14); so does a language file's `translations` (area 10), and a provider
// package's `provider` (area 11).
SingletonDecl =
  keyword:'ident' MemberList

//*************************//
// Signatures              //
//*************************//

ParamList =
  '(' (Param (',' Param)* ','?)? ')'

Param =
  Name ':' Type

// `fails` comes before `->` (area 3).
FailsClause =
  'fails' (Type (',' Type)*)

RetType =
  '->' Type

//*************************//
// Members                 //
//*************************//

MemberList =
  '{' MemberItem* '}'

MemberItem =
  Member
| BareMember
| RuleMember
| RouteEntry
| Decl
| Elision

// Every member inside braces is `name: value`; a value is one thing or a
// `{ ... }` block (area 3's colon rule). Keys may be dotted:
// `Todo.priority: { ... }`, `couriers.bookings.create: [slot_taken]`.
Member =
  MemberKey ':' value:Expr? block:MemberList?

MemberKey =
  Name ('.' Name)*

// An enum variant with no data is just its name (area 2).
BareMember =
  Name

// `rule ends_after_start: ends > starts`: a rule across an object type's
// fields, named and checked whenever a value is made (area 2, "Rules
// across fields"). `rule` is a word only before a name and `:`.
RuleMember =
  'rule' Name ':' condition:Expr

// `...` marks code left out of a documentation example.
Elision =
  '...'

// `GET /{todo_id: Todo.id} { ... }`: the one exception to the colon rule
// (area 7).
RouteEntry =
  method:'ident' RoutePath MemberList

RoutePath =
  RouteSegment*

RouteSegment =
  '/' 'path_segment'? PathParam?

PathParam =
  '{' Name (':' Type)? '}'

//*************************//
// Statements              //
//*************************//

Block =
  '{' BlockItem* '}'

BlockItem =
  Stmt
| Member
| Elision

Stmt =
  VarStmt
| AssignStmt
| ReturnStmt
| IfStmt
| ForStmt
| EmitStmt
| AssertStmt
| ExprStmt

// Every variable states its type (area 2); `var mut` can be reassigned
// (area 3).
VarStmt =
  'var' 'mut'? Name (':' Type)? '=' Expr

AssignStmt =
  target:Expr '=' value:Expr

ReturnStmt =
  'return' Expr?

// Conditions are always in brackets (area 3). An `else if` chain is one
// flat list of branches, so its length never nests the tree.
IfStmt =
  'if' Condition Block ElseIf* ElseBranch?

Condition =
  '(' Expr ')'

ElseIf =
  'else' 'if' Condition Block

ElseBranch =
  'else' Block?

ForStmt =
  'for' Name 'in' Expr Block

EmitStmt =
  'emit' Expr

// `assert response.status == 422`, `assert complete(id) fails NotFound`
// (area 13).
AssertStmt =
  'assert' Expr AssertFails?

AssertFails =
  'fails' Type

ExprStmt =
  Expr

//*************************//
// Expressions             //
//*************************//

Expr =
  Literal
| NameRef
| FieldExpr
| CallExpr
| RecordExpr
| ParenExpr
| ListExpr
| OrderedExpr
| BinExpr
| PrefixExpr
| MatchExpr
| AttemptExpr
| RejectExpr
| PropagateExpr
| LambdaExpr
| RoutePathExpr
| GenericExpr
| NullableExpr
| ElisionExpr

Literal =
  value:('int_number' | 'decimal_number' | 'unit_number' | 'string' | 'true' | 'false' | 'none')

NameRef =
  'ident'

// `todo.title`, `Todo.id`, `temporal.in_zone`
FieldExpr =
  Expr '.' NameRef

CallExpr =
  Expr ArgList

ArgList =
  '(' (Arg (',' Arg)* ','?)? ')'

// Named arguments exist only for standard-library operations (area 3).
Arg =
  (Name ':')? Expr

// A value with a block: `TodoView { ... }`, `Todo.update(todo) { set: ... }`,
// `name: ProductName { optional: true }`.
RecordExpr =
  Expr MemberList

ParenExpr =
  '(' Expr ')'

// Square brackets are the only way to write a list (area 2).
ListExpr =
  '[' (Expr (',' Expr)* ','?)? ']'

// `order: [Todo.created_at desc]` (area 6), and
// `order: [HelpArticle.body_meaning nearest question_meaning]` (area 21).
OrderedExpr =
  expr:Expr direction:('asc' | 'desc' | 'nearest') target:Expr?

BinExpr =
  lhs:Expr
  op:(
    'or' | 'and'
  | '==' | '!=' | 'in' | 'matches'
  | '<' | '<=' | '>' | '>='
  | '+' | '-'
  | '*' | '/' | '%'
  )
  rhs:Expr

PrefixExpr =
  op:('not' | '-') Expr

// One `match` for values and call outcomes (area 3).
MatchExpr =
  'match' Expr MatchArmList

MatchArmList =
  '{' MatchArm* '}'

MatchArm =
  Pat '->' Expr? Block?

// `attempt` starts a statement. The block after an attempted call maps
// its conditions, one per line: a construction's are the rules that can
// break, with `invalid:` covering the rest (areas 2–4):
// `attempt CakeCount(n) { max: OrderTooLarge }`.
AttemptExpr =
  'attempt' Expr MemberList?

RejectExpr =
  'reject' Expr

PropagateExpr =
  'propagate'

// `todo -> todo.title`, only as an argument to a standard-library
// collection operation (area 3); `(key, value) -> ...` with two
// parameters, only for a standard operation that takes two (area 19).
LambdaExpr =
  '('? Name (',' Name)* ')'? '->' Expr

// `prefix: /todos/{project_id: Project.id}` (area 7).
RoutePathExpr =
  RoutePath

// `List<Tag>` written as a member's value.
GenericExpr =
  Expr GenericArgList

// `ProductName?` written as a member's value.
NullableExpr =
  Expr '?'

ElisionExpr =
  '...'

//*************************//
// Types                   //
//*************************//

Type =
  PathType
| NullableType

PathType =
  Path GenericArgList?

Path =
  NameRef ('.' NameRef)*

GenericArgList =
  '<' (Type (',' Type)* ','?)? '>'

NullableType =
  Type '?'

//*************************//
// Patterns                //
//*************************//

Pat =
  CasePat
| LiteralPat
| WildcardPat

// `TodoStatus.open`, `PaymentOutcome.paid(payment)`, `some(x)`,
// `success(value)`, `LookupMissing`: brackets name the data a case carries.
CasePat =
  Path PatBinding?

PatBinding =
  '(' Name ')'

LiteralPat =
  '-'? Literal

WildcardPat =
  '_'

//*************************//
// Templates               //
//*************************//

TemplateBody =
  TemplatePart*

TemplatePart =
  TemplateLiteral
| TemplateValue
| TemplateIf
| TemplateFor
| TemplateInclude

TemplateLiteral =
  'template_text'

TemplateValue =
  '{{' Expr '}}'

TemplateIf =
  TemplateIfTag TemplateBody TemplateElse* TemplateEndTag?

TemplateIfTag =
  '{{' 'if' Condition '}}'

TemplateElse =
  TemplateElseTag TemplateBody

TemplateElseTag =
  '{{' 'else' ('if' Condition)? '}}'

TemplateFor =
  TemplateForTag TemplateBody TemplateEndTag?

TemplateForTag =
  '{{' 'for' Name 'in' Expr '}}'

TemplateEndTag =
  '{{' 'end' '}}'

TemplateInclude =
  '{{' 'include' Expr '}}'
