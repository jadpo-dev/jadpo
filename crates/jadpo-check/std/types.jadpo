// Types the standard library declares in Jadpo (docs/compiler-runtime.md
// §2.1). The representation types (`Bool`, `Int`, `Decimal`, `Text`,
// `Bytes`, `Uuid`), the validated text types (`Email`, `Url`, `IpAddress`),
// the time types and `Unit` are built into the checker, because no Jadpo
// declaration can say what they are made of.

/// The formats a `Text` type's `format:` setting accepts (area 2, question 9).
public type TextFormat = Enum {
    email
}

/// The UUID versions a `Uuid` type's `version:` setting can pin
/// (area 2, question 13).
public type UuidVersion = Enum {
    v1
    v2
    v3
    v4
    v5
    v6
    v7
    v8
}
