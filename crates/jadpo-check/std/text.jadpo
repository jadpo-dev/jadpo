// The `text` namespace (area 19, "Text"): the standard type contract's
// three operations, and the operations on text, each listed in
// `jadpo-std`'s operation table and run by `jadpo-value`.
//
// `T` in `format` and `from` is a standard type, or a type built on one;
// which fit, and how each is shown or written, is the type's data entry,
// which the checker reads. `zone:` and `format:` mean something only for
// the types whose entry takes them (the time types), and those need them;
// `precision:`, `display:` and `sign:` only for `Money`, and `unit:`
// (a unit of the quantity's kind, its base unit when left out) only for a
// physical quantity, each of which may leave them out.
// `as:` in `parse` is a type written out, a standard type or a type built
// on one or on `Text`, `Int`, `Decimal` or `Bool`, and the result is that
// type: text that isn't one at all fails `malformed`, and the type's own
// rules fail by their names, as a construction's do. `country:` means
// something only for `PhoneNumber` and `PostalCode`.
//
// The rest take any value built on `Text` and give plain `Text`, counted,
// cut and padded in code points. A count or a position is never negative,
// `find` and `separator` are never empty, `fill:` is one character written
// out, and `trim`, `slice` and the four cuts are never longer than their
// text, so a type built from one keeps the text's `max_length`.

public library text {
    /// Text that `part` appears in.
    function contains(value: Text, part: Text) -> Bool {}

    /// `value` without its first `n` code points.
    function drop_first(value: Text, n: Int) -> Text {}

    /// `value` without its last `n` code points.
    function drop_last(value: Text, n: Int) -> Text {}

    /// Text that ends with `suffix`.
    function ends_with(value: Text, suffix: Text) -> Bool {}

    /// `value` shown to a person in `locale`, in the type's own words.
    function format(value: T, locale: Locale, zone: Zone?, format: TimeFormat?, precision: MoneyPrecision?, display: MoneyDisplay?, sign: MoneySign?, unit: QuantityUnit?) -> PresentationText {}

    /// `value`'s canonical text, the form `parse` reads back, or its code
    /// in another code system a closed list has, `form: CodeForm.alpha3`.
    function from(value: T, form: CodeForm?) -> Text {}

    /// The items with `separator` between them.
    function join(items: List<Text>, separator: Text) -> Text {}

    /// At most `n` code points from the start.
    function keep_first(value: Text, n: Int) -> Text {}

    /// At most `n` code points from the end.
    function keep_last(value: Text, n: Int) -> Text {}

    /// How many code points `value` holds, at least 0.
    function length(value: Text) -> Int {}

    /// `value` in lower case, by `locale`'s rules when it is given.
    function lower(value: Text, locale: Locale?) -> Text {}

    /// `value` with `fill` added at the start until it is `length` code
    /// points long; never cut.
    function pad_start(value: Text, length: Int, fill: Text) -> Text {}

    /// The value of type `as` that `raw`, its canonical text, holds, or
    /// its code in another code system a closed list has, `form:
    /// CodeForm.numeric`; a phone number or a postal code as people write
    /// it in `country`.
    function parse(raw: Text, as: Type, form: CodeForm?, country: Country?) -> T {}

    /// The text in `value` for `locale`: its entry, else the entry of its
    /// language (the locale CLDR's likely subtags give for the language
    /// first), else the application's default locale's, else the first.
    function pick(value: LocalisedText, locale: Locale) -> Text {}

    /// `value` with every `find` replaced by `with`, left to right.
    function replace(value: Text, find: Text, with: Text) -> Text {}

    /// Up to `count` code points from position `from`, cut short at the end.
    function slice(value: Text, from: Int, count: Int) -> Text {}

    /// `value` as lowercase ASCII letters, digits and single `-`.
    function slug(value: Text) -> Text {}

    /// `value` cut at each `separator`, at least one piece.
    function split(value: Text, separator: Text) -> List<Text> {}

    /// Text that starts with `prefix`.
    function starts_with(value: Text, prefix: Text) -> Bool {}

    /// `value` without Unicode white space at either end.
    function trim(value: Text) -> Text {}

    /// `value` in upper case, by `locale`'s rules when it is given.
    function upper(value: Text, locale: Locale?) -> Text {}
}
