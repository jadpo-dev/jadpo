// The `range` namespace (area 19, "Ranges"). Each operation is listed,
// typed, in `jadpo-std`'s operation table, which names the Rust function
// in `jadpo-value` that runs it; a test holds these stubs to that table.
//
// `Range<T>` here is any range whose ends are a `T`: a `Range<T>` itself,
// or `InstantRange`, whose ends are instants, or `DateRange`, whose ends
// are dates. A call's ranges are all of one range type, and a range it
// gives is of that type too. Each follows the range's own end rule: a
// `Range<T>` and an `InstantRange` hold every value from their start up
// to, not including, their end, a `DateRange` every date up to and
// including its end, and an open end (`none`) holds everything on its
// side.

public library range {
    /// Whether `value` is inside `range`.
    function contains(range: Range<T>, value: T) -> Bool {}

    /// Whether `a` and `b` share at least one value.
    function overlaps(a: Range<T>, b: Range<T>) -> Bool {}

    /// The part `a` and `b` share; `none` when they don't overlap.
    function intersection(a: Range<T>, b: Range<T>) -> Range<T>? {}
}
