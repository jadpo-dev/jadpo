// The standard types (area 19, "The standard types" and "Every standard
// type meets one contract"): one declaration each, global, in one flat
// set. Each is paired with its data entry in `jadpo-std`'s `standard`
// module (its canonical text, JSON shape, storage, format for people,
// order, named validator and the shape `type.standard_exists` matches),
// and every baseline operation reads that entry, so a type added here
// with its entry needs no new code; a test holds the two to each other.
//
// A type whose base is its own name is built into the language
// (`jadpo_std::Builtin`): no declaration can say what it is made of, so
// the declaration only names it. An enum with no variants listed takes
// them from its table in `jadpo-std` (the IANA zones, the CLDR locales,
// the media types), too long to repeat here.

/// A US bank's ABA routing number (area 19), nine digits with a 3-7-1
/// checksum: `021000021`.
public type AbaRoutingNumber = Text {}

/// One of the 14 allergens a food label must name (area 19, UK FIR 2014
/// and EU Regulation 1169/2011, Annex II), written as its own name,
/// `milk`, and shown as the Food Standards Agency words it.
public type Allergen = Enum {
    celery
    cereals_containing_gluten
    crustaceans
    eggs
    fish
    lupin
    milk
    molluscs
    mustard
    peanuts
    sesame
    soybeans
    sulphites
    tree_nuts
}

/// What an image shows, for someone who can't see it (area 19, WCAG 2.2's
/// text alternative): one line of 1 to 1,000 characters. An image with
/// nothing to say has `none`.
public type AltText = Text {}

/// An angle, held in radians to 9 places (area 19), written `90deg` or
/// `1.5rad`.
public type Angle = Angle {}

/// An area, held in square metres to 6 places (area 19), written `12sqm`
/// or `2ha`; a `Length` times a `Length`.
public type Area = Area {}

/// Width to height in whole numbers (area 19), written `16:9`: `16:9` and
/// `32:18` are two values.
public type AspectRatio = Object {
    width: Int
    height: Int
}

/// An audio codec as the W3C WebCodecs Codec Registry names it (area 19,
/// RFC 6381's form): `mp4a.40.2`, `opus`.
public type AudioCodec = Text {}

/// A bank account to pay into or take from (area 19): a UK sort code and
/// account number, an IBAN, or another country's account by its country,
/// its bank's code where it has one, and its number. Shown masked to its
/// number's last four. Personal data.
public type BankAccount = Enum {
    uk: {
        sort_code: UkSortCode
        account_number: UkAccountNumber
    }
    iban: {
        iban: Iban
    }
    other: {
        country: Country
        bank_code: Text?
        account_number: Text
    }
}

/// A count of hundredths of a percent (area 19), a whole number of any
/// sign, so 25 basis points is never read as 25%: shown `25 bp`.
public type BasisPoints = Int {}

/// A bank identifier code (area 19, ISO 9362), 8 or 11 characters:
/// `DEUTDEFF`.
public type Bic = Text {}

/// Data per second, held in whole bits per second (area 19), written
/// `100Mbps`; a `DataSize` over a `Duration`.
public type Bitrate = Bitrate {}

/// A person's blood group, ABO and RhD (area 19), written `O-`: health
/// data.
public type BloodType = Enum {
    a_positive
    a_negative
    ab_positive
    ab_negative
    b_positive
    b_negative
    o_positive
    o_negative
}

/// A booking's record locator (area 19, IATA's passenger name record),
/// six capitals and digits: `X7K9QZ`.
public type BookingReference = Text {}

/// The cabin a seat is sold in (area 19), written as its own name,
/// `premium_economy`.
public type CabinClass = Enum {
    business
    economy
    first
    premium_economy
}

/// A calendar day with no time or zone (area 10), written `2026-10-25`.
public type CalendarDate = CalendarDate {}

/// A calendar event (area 19, RFC 5545's `VEVENT`): an all-day event's
/// first and last days, both included, or a timed event's local start and
/// end and its zone, never both, with what it is called and, where it has
/// them, where it is, what it is about and how it repeats. Written as a
/// `VEVENT`, an all-day event's `DTEND` the day after its last.
public type CalendarEvent = Object {
    summary: Text
    first_day: CalendarDate?
    last_day: CalendarDate?
    start: LocalDateTime?
    end: LocalDateTime?
    zone: Zone?
    location: Text?
    description: Text?
    recurrence: RecurrenceRule?
}

/// An amount of calendar time in whole years, months and days (area 19),
/// written `P1Y2M10D`: unlike a `Duration`, a month is a month, however
/// many days it has. It has no order, and `==` compares part by part.
public type CalendarPeriod = Object {
    years: Int
    months: Int
    days: Int
}

/// A country calling code (area 19, ITU-T E.164) with its `+`: `+44`.
public type CallingCode = Text {}

/// The first 6 or 8 digits of a card number, naming its issuer (area
/// 19): `424242`.
public type CardBin = Text {}

/// A card scheme (area 19), written as its own name, `visa`, and shown
/// by the scheme's, "Visa". `money.mask` tells it from a card's number.
public type CardBrand = Enum {
    american_express
    diners_club
    discover
    jcb
    maestro
    mastercard
    unionpay
    visa
}

/// The month a payment card runs to, to its end (area 19), written
/// `2028-12` and shown as the card prints it, `12/28`: `year` from 2000 to
/// 2099, `month` from 1 to 12. Personal data.
public type CardExpiry = Object {
    year: Int
    month: Int
}

/// A shipping carrier by its Standard Carrier Alpha Code (area 19, NMFTA),
/// two to four capitals: `UPSN`.
public type Carrier = Text {}

/// A level of the Common European Framework of Reference for Languages
/// (area 19), written `B2`.
public type CefrLevel = Enum {
    a1
    a2
    b1
    b2
    c1
    c2
}

/// An intermodal container's number (area 19, ISO 6346), its check digit
/// passing: `CSQU3054383`, printed `CSQU 305438 3`.
public type ContainerNumber = Text {}

/// An age rating by the body that gave it (area 19), written `BBFC 12A`:
/// `rating` is one of `scheme`'s categories.
public type ContentRating = Object {
    scheme: ContentRatingScheme
    rating: Text
}

/// A body that rates films or games for age (area 19), written as it
/// writes its name: `BBFC`, `MPA`, `PEGI`, `ESRB`.
public type ContentRatingScheme = Enum {
    bbfc
    mpa
    pegi
    esrb
}

/// A continent (area 19), as UN M49 groups the world: written as its own
/// name, `europe`, and as M49's number with `form: CodeForm.numeric`.
public type Continent = Enum {
    africa
    americas
    antarctica
    asia
    europe
    oceania
}

/// A country (area 19, ISO 3166-1), written as its alpha-2 code, `GB`;
/// `form: CodeForm.alpha3` writes `GBR` and `CodeForm.numeric` `826`. A
/// code that is a reserved word takes a trailing `_`: `Country.in_` is
/// India. A withdrawn code, `YU`, is only read.
public type Country = Enum {}

/// A country's subdivision (area 19, ISO 3166-2), written as its code,
/// `GB-ENG`, its variant `CountrySubdivision.gb_eng`.
public type CountrySubdivision = Enum {}

/// An address range (area 19, RFC 4632 and RFC 4291): its first address
/// as `IpAddress` writes it, `/` and the prefix's length, every bit after
/// the prefix zero: `192.0.2.0/24`, `2001:db8::/32`.
public type Cidr = Text {}

/// A colour in sRGB with its alpha (area 19, question 13), each channel
/// from 0 to 255, written `#1e6fd9`, or `#1e6fd980` when it isn't opaque.
/// `colour`'s operations convert, mix and compare colours.
public type Colour = Object {
    red: Int
    green: Int
    blue: Int
    alpha: Int
}

/// A cookie as a server sets it (area 19, RFC 6265 and RFC 6265bis's
/// `SameSite`): its name and value, then its attributes after `; ` in the
/// RFC's order and spelling, `SID=31d4d96e; Path=/; Secure; HttpOnly`.
/// Personal data.
public type Cookie = Text {}

/// A mass in a volume, held in kilograms per cubic metre to 9 places
/// (area 19), written `5mgL` or `1gL`; a `Mass` over a `Volume`.
public type Concentration = Concentration {}

/// An electric current, held in amperes to 6 places (area 19), written
/// `500mA`.
public type Current = Current {}

/// An amount of data, held in whole bytes (area 19), written `5MB` or
/// `4KiB`.
public type DataSize = DataSize {}

/// The days from `start` to `end`, both included (area 19), written
/// `2026-10-01/2026-10-31`.
public type DateRange = Object {
    start: CalendarDate
    end: CalendarDate
}

/// An active ISO 4217 currency (area 19), written as its code, `GBP`.
public type Currency = Enum {}

/// An amount off a price or a percentage off it (area 19), a choice:
/// `money.apply_discount` takes one off a `Price`. An amount off is never
/// below 0, and a percentage off is from 0% to 100%.
public type Discount = Enum {
    amount_off: {
        amount: Money
    }
    percentage_off: {
        percentage: Percentage
    }
}

/// A driving licence's number with the country that issued it (area 19):
/// the number upper case with no spaces, in that country's form where it
/// publishes one, `MCADI801206HZ9HM` for Great Britain. Shown masked to
/// its last four. Personal data.
public type DrivingLicenceNumber = Object {
    country: Country
    number: Text
}

/// A length of time, exact to the millisecond (area 10), written `PT1H30M`.
public type Duration = Duration {}

/// A GTIN-13, the European article number (area 19, GS1), its check digit
/// passing: `4006381333931`.
public type Ean13 = Text {}

/// An email address (area 2), checked as one.
public type Email = Email {}

/// A mailbox (area 19, RFC 5322): an address with the name shown with it,
/// written `Ada Lovelace <ada@example.com>`. Personal data.
public type EmailWithName = Object {
    name: Text?
    address: Email
}

/// One emoji (area 19, UTS #51), fully qualified, as Unicode's list
/// writes it: a red heart is `U+2764 U+FE0F`.
public type Emoji = Text {}

/// Energy, held in joules to 3 places (area 19), written `2kWh` or
/// `250kcal`.
public type Energy = Energy {}

/// An energy performance certificate's band (area 19, the UK's EPC),
/// written `C`.
public type EpcRating = Enum {
    a
    b
    c
    d
    e
    f
    g
}

/// A rate between two currencies at an instant (area 19): one `from` is
/// `rate` of `to`, written `GBP/EUR 1.17 2026-10-18T09:00:00Z`. An app holds
/// one it was given; `money.convert` applies it.
public type ExchangeRate = Object {
    from: Currency
    to: Currency
    rate: Decimal
    at: Instant
}

/// A file's IANA media type (area 16), written `image/png`.
public type FileType = Enum {}

/// An exact rational number as written (area 19), `3/4`: `1/2` and `2/4`
/// are two values. `denominator` is at least 1.
public type Fraction = Object {
    numerator: Int
    denominator: Int
}

/// Frames a second as an exact fraction (area 19), written `30000/1001`
/// for 29.97 and `25/1` for 25: both parts at least 1, held as written.
public type FrameRate = Object {
    numerator: Int
    denominator: Int
}

/// A family name (area 19), one line as the person writes it. Personal
/// data.
public type FamilyName = Text {}

/// How a stored image is turned to be seen upright (area 19, EXIF 2.32's
/// orientation), named for where its first row and column are seen and
/// written as EXIF's value: `top_left` is `1`, `right_top` is `6`.
public type ExifOrientation = Enum {
    top_left
    top_right
    bottom_right
    bottom_left
    left_top
    right_top
    right_bottom
    left_bottom
}

/// A given name (area 19), one line as the person writes it. Personal
/// data.
public type GivenName = Text {}

/// A frequency, held in hertz to 3 places (area 19), written `50Hz` or
/// `2.4GHz`.
public type Frequency = Frequency {}

/// A host (area 19, RFC 3986): a domain name, or an IP address as
/// `IpAddress` writes it, an IPv6 address without brackets.
public type Hostname = Text {}

/// A domain name (area 19, IDNA 2008 by UTS 46), lower case, each label
/// beyond ASCII as its A-label, with no dot at the end:
/// `xn--mnchen-3ya.de`. Every domain name is a `Hostname`.
public type DomainName = Hostname {}

/// An HTTP field name (area 19, RFC 9110), a token in lower case:
/// `content-type`.
public type HttpHeaderName = Text {}

/// An HTTP method (area 19, RFC 9110), one a route is written with,
/// written as its token, `GET`.
public type HttpMethod = Enum {
    get
    post
    put
    patch
    delete
}

/// An HTTP response's status code (area 19, RFC 9110), from 100 to 599.
public type HttpStatus = Int {}

/// A Harmonized System commodity code (area 19, WCO), six to ten digits
/// with no dots: `090111`.
public type HsCode = Text {}

/// An airline's IATA designator (area 19), two characters: `BA`.
public type IataAirline = Text {}

/// An airport's IATA code (area 19), three capitals: `LHR`.
public type IataAirport = Text {}

/// An IBAN (area 19, ISO 13616) in its electronic form, upper case with
/// no spaces, its mod-97 check digits passing: `GB29NWBK60161331926819`.
/// Shown to people in fours.
public type Iban = Text {}

/// A mobile device's IMEI (area 19, 3GPP TS 23.003): 15 digits, its
/// Luhn check digit passing. Personal data.
public type Imei = Text {}

/// An image's width and height in whole pixels (area 19), written
/// `1920x1080`, each from 1 to 2,147,483,647. `media.fit` scales one to fit
/// inside another.
public type ImageDimensions = Object {
    width: Int
    height: Int
}

/// What kind of identity document one is (area 19), written as its own
/// name: `passport`, `identity_card`, `driving_licence`,
/// `residence_permit`.
public type IdentityDocumentKind = Enum {
    passport
    identity_card
    driving_licence
    residence_permit
}

/// An identity document (area 19): its kind, the country that issued it,
/// its number in that country's form for its kind, and the day it
/// expires, if it does. Shown as its number masked to its last four.
/// Personal data.
public type IdentityDocument = Object {
    kind: IdentityDocumentKind
    country: Country
    number: Text
    expires: CalendarDate?
}

/// An airport's ICAO location indicator (area 19), four capitals: `EGLL`.
public type IcaoAirport = Text {}

/// A diagnosis's ICD-10 code (area 19, WHO), with its dot: `I21.9`.
/// Health data.
public type Icd10Code = Text {}

/// Illuminance, held in lux to 3 places (area 19), written `500lx`.
public type Illuminance = Illuminance {}

/// A rule of ICC's Incoterms 2020 (area 19), written as its code, `FOB`.
/// The rules earlier editions had, `DAT`, are only read.
public type Incoterm = Enum {
    cfr
    cif
    cip
    cpt
    daf
    dap
    dat
    ddp
    ddu
    deq
    des
    dpu
    exw
    fas
    fca
    fob
}

/// Space inside each edge (area 19, the CSS box model), never negative,
/// written in CSS's order: `8 16 8 16`.
public type Insets = Object {
    top: Decimal
    right: Decimal
    bottom: Decimal
    left: Decimal
}

/// One moment for everyone (area 10), written `2026-10-25T09:30:00Z`.
public type Instant = Instant {}

/// The instants from `start` up to but not including `end` (area 10),
/// written `2026-10-25T09:00:00Z/2026-10-25T17:00:00Z`.
public type InstantRange = Object {
    start: Instant
    end: Instant
}

/// A rate of interest a year and the basis it is quoted on (area 19),
/// shown as a lender writes it, `5.5% APR`. The rate may be below 0%, as
/// central banks' have been.
public type InterestRate = Object {
    rate: Percentage
    basis: InterestRateBasis
}

/// The basis an interest rate is quoted on (area 19): the annual
/// equivalent rate of savings (`aer`), the annual percentage rate of
/// borrowing (`apr`), or a flat rate on the sum first lent (`flat`).
public type InterestRateBasis = Enum {
    aer
    apr
    flat
}

/// An invoice's number (area 19, EN 16931): 1 to 200 characters, with no
/// space at either end.
public type InvoiceNumber = Text {}

/// An IPv4 or IPv6 address (area 2).
public type IpAddress = IpAddress {}

/// An ISBN (area 19, ISO 2108) in its 13 digits with no hyphens, its
/// check digit passing: `9780306406157`.
public type Isbn = Text {}

/// A securities identification number (area 19, ISO 6166), its Luhn
/// check digit passing: `US0378331005`.
public type Isin = Text {}

/// A week of an ISO 8601 week-numbering year (area 19), written
/// `2026-W43`: `week` from 1 to 52, or 53 in a year that has one.
public type IsoWeek = Object {
    year: Int
    week: Int
}

/// A pointer into a JSON document (area 19, RFC 6901): `/foo/0`, with
/// `~0` for `~` and `~1` for `/`, and empty for the whole document.
public type JsonPointer = Text {}

/// A public key a token is checked against (area 19, RFC 7517 and RFC
/// 8037): an Ed25519 key, `kty` `OKP`, `crv` `Ed25519` and `x` its 32
/// bytes as unpadded Base64url, with an optional key id; `use_` is sent
/// as `use`. Never a private key or a shared secret.
public type Jwk = Object {
    kty: Text
    crv: Text
    x: Text
    kid: Text?
    alg: Text?
    use_: Text?
}

/// A signed token (area 19, RFC 7519) in JWS compact form, three parts of
/// unpadded Base64url joined by `.`, at most 8,192 characters; an
/// unsecured token, with no signature, is never one. `crypto.verify_jwt`
/// checks it. Shown to people as its last four only.
public type Jwt = Text {}

/// A token's registered claims (area 19, RFC 7519 §4.1), once
/// `crypto.verify_jwt` has checked its signature, times, issuer and
/// audience: `aud` is a list, and `exp` always there.
public type JwtClaims = Object {
    iss: Text?
    sub: Text?
    aud: List<Text>
    exp: Instant
    nbf: Instant?
    iat: Instant?
    jti: Text?
}

/// A language (area 19, ISO 639-1), written as its code, `en`; `form:
/// CodeForm.alpha3` writes ISO 639-2's `eng`. `Language.or_` is Odia.
public type Language = Enum {}

/// A lawful basis for processing personal data (area 19, GDPR Article
/// 6(1)), written as its own name, `legitimate_interests`.
public type LawfulBasis = Enum {
    consent
    contract
    legal_obligation
    legitimate_interests
    public_task
    vital_interests
}

/// A Legal Entity Identifier (area 19, ISO 17442), its mod-97 check
/// digits passing: `506700GE1G29325QX363`.
public type Lei = Text {}

/// A length or distance, held in metres to 6 places (area 19), written
/// `5km`, `45cm`, `3inch` or `2metre`; `m` is minutes.
public type Length = Length {}

/// A date and a clock time with no zone (area 19), written
/// `2026-10-25T09:30:00`: not one moment until a zone is chosen.
public type LocalDateTime = Object {
    date: CalendarDate
    time: LocalTime
}

/// A clock time with no date or zone, to the second (area 19), written
/// `09:30:00`: `hour` from 0 to 23, `minute` and `second` from 0 to 59.
public type LocalTime = Object {
    hour: Int
    minute: Int
    second: Int
}

/// A CLDR locale (area 10), written as its BCP 47 tag, `en-GB`.
public type Locale = Enum {}

/// A hardware address (area 19, IEEE 802's EUI-48) in IEEE's form, six
/// pairs of upper-case hexadecimal digits joined by `-`:
/// `AC-DE-48-00-00-80`. Personal data.
public type MacAddress = Text {}

/// What may be kept of a payment card once its number is gone (area 19,
/// PCI DSS): its brand, where a listed scheme issued it, and its last four
/// digits, shown as `Visa •••• 4242`. `money.mask` makes one from a
/// `PaymentCardNumber`. Personal data.
public type MaskedCardNumber = Object {
    brand: CardBrand?
    last_four: Text
}

/// A manufacturing batch or lot (area 19, GS1 AI 10), up to 20 of GS1's
/// characters: `ABC123`.
public type LotNumber = Text {}

/// A mass, held in kilograms to 9 places, a microgram (area 19), written
/// `250g`, `2.5kg` or `500mcg`.
public type Mass = Mass {}

/// A month of the year (area 19).
public type Month = Enum {
    january
    february
    march
    april
    may
    june
    july
    august
    september
    october
    november
    december
}

/// A UK electricity supply's MPAN core (area 19, Elexon), 13 digits, its
/// check digit passing: `1200012345679`.
public type Mpan = Text {}

/// A UK gas supply's meter point reference number (area 19, Xoserve), 6
/// to 10 digits: `1234567`.
public type Mprn = Text {}

/// A person's nationality (area 19), named by the country, as ISO 3166-1
/// codes it: `GB`. Personal data.
public type Nationality = Enum {}

/// A TCP or UDP port (area 19, IANA), from 1 to 65535.
public type NetworkPort = Int {}

/// An NHS number (area 19), ten digits with a mod-11 check digit:
/// `9434765919`, shown to people as `943 476 5919`. Personal data.
public type NhsNumber = Text {}

/// An OAuth scope (area 19, RFC 6749 §3.3): one scope-token of printable
/// ASCII but the space, `"` and `\`, `todos:read`.
public type OAuthScope = Text {}

/// Who an identity provider says signed in (area 19, OpenID Connect Core
/// 1.0 §5.1): the subject and the standard claims a sign-in reads, each
/// by its own name. Personal data.
public type OidcClaims = Object {
    sub: Text
    name: Text?
    given_name: GivenName?
    family_name: FamilyName?
    preferred_username: Text?
    email: Email?
    email_verified: Bool?
    phone_number: PhoneNumber?
    phone_number_verified: Bool?
    picture: Url?
}

/// When a place is open each week and the days that differ, read by the
/// clock in its zone (area 19, OpenStreetMap's `opening_hours`): `Mo-Fr
/// 09:00-17:30; Sa 10:00-16:00; 2026 Dec 25 off [Europe/London]`.
/// `temporal.open_at` asks whether it is open at an instant.
public type OpeningHours = Text {}

/// A passport's number with the country that issued it (area 19, ICAO
/// Doc 9303): the number upper case, in that country's form where it
/// publishes one, `123456789` for the United Kingdom. Shown masked to its
/// last four. Personal data.
public type PassportNumber = Object {
    country: Country
    number: Text
}

/// A paper size (area 19): ISO 216's A and B series and the US letter,
/// legal and tabloid, written `A4`, `Letter`.
public type PaperSize = Enum {
    a0
    a1
    a2
    a3
    a4
    a5
    a6
    a7
    a8
    a9
    a10
    b0
    b1
    b2
    b3
    b4
    b5
    b6
    b7
    b8
    b9
    b10
    letter
    legal
    tabloid
}

/// A researcher's ORCID iD (area 19), its ISO 7064 check character
/// passing: `0000-0002-1825-0097`.
public type Orcid = Text {}

/// What checking a password against its hash says (area 19,
/// `crypto.verify_password`): `correct_outdated` is correct against a hash
/// made with older parameters, so store a fresh one.
public type PasswordCheck = Enum {
    wrong
    correct
    correct_outdated
}

/// A password's hash (area 19, `crypto.hash_password`): the PHC string of
/// Argon2id, `$argon2id$v=19$m=19456,t=2,p=1$<salt>$<hash>`, which a
/// sign-in checks a password against.
public type PasswordHash = Text {}

/// A payment card's number (area 19, ISO/IEC 7812), 12 to 19 digits with
/// a Luhn check digit: `4242424242424242`. Shown to people as its last
/// four only, `•••• 4242`. Personal data.
public type PaymentCardNumber = Text {}

/// The reference a payer sees on a UK bank payment (area 19): up to 18
/// of Bacs's characters, `INV-2026/0042`.
public type PaymentReference = Text {}

/// A proportion where 0.20 is 20% (area 19), written `20%`: held as the
/// exact fraction, shown as the reader's locale writes a percentage.
/// `Percentage(ratio)` makes one from a `Decimal` ratio, 0.25 being 25%.
public type Percentage = Percentage {}

/// A person's name (area 19): their given name and, where they have one,
/// their family name. It has no single text form; `text.format` writes it
/// in the order the reader's locale gives. Personal data.
public type PersonName = Object {
    given: GivenName
    family: FamilyName?
}

/// An internal extension dialled after a phone number (area 19): up to 20
/// digits. Personal data.
public type PhoneExtension = Text {}

/// A phone number (area 19) in E.164, `+447400123456`, valid by
/// libphonenumber's metadata for its region. Personal data.
public type PhoneNumber = Text {}

/// A postal address in any country (area 19): its street lines, its
/// locality, region and postal code where its country uses them, and the
/// country. It has no single text form; `text.format` writes it in its
/// country's order for the reader. Personal data.
public type PostalAddress = Object {
    lines: List<Text>
    locality: Text?
    region: Text?
    postal_code: PostalCode?
    country: Country
}

/// A postal code (area 19), `SW1A 1AA`, checked by its country's pattern
/// where the country is known. Personal data.
public type PostalCode = Text {}

/// Power, held in watts to 3 places (area 19), written `3kW`.
public type Power = Power {}

/// A pressure, held in pascals to 3 places (area 19), written `1013hPa`.
public type Pressure = Pressure {}

/// An amount and whether it includes tax (area 19), so a gross price is
/// never taken for a net one: shown as its amount, `£10.50`. The amount
/// is never below 0.
public type Price = Object {
    amount: Money
    includes_tax: Bool
}

/// An HTTP API's error body (area 19, RFC 9457): what kind of problem it
/// is (`about:blank` when `none`), the status, a short title, a detail
/// for people and the URL of this occurrence, each of which may be
/// `none`. `type_` is sent as `type`, a reserved word in code.
public type ProblemDetails = Object {
    type_: Url?
    status: HttpStatus?
    title: Text?
    detail: Text?
    instance: Url?
}

/// An Ed25519 public key (area 19, RFC 8032), its 32 bytes as unpadded
/// Base64url, `11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo`: not secret,
/// so it may be read, stored and sent.
public type PublicKey = Text {}

/// A device's push notification token (area 19), from Apple's or
/// Google's service, opaque. Personal data.
public type PushToken = Text {}

/// A quarter of a calendar year (area 19), written `2026-Q4`: `quarter`
/// from 1 to 4.
public type Quarter = Object {
    year: Int
    quarter: Int
}

/// An amount of money (area 19): a whole number of its currency's minor
/// units and its `Currency`, written `GBP 10.50`.
public type Money = Money {}

/// The values of one ordered type from `start` up to but not including
/// `end`, either of them `none` for an open end (area 19), written
/// `2026-10-01/..`. `T` is the type in `< >`: `Range<Grams>`.
public type Range = Object {
    start: T?
    end: T?
}

/// One number to another as written (area 19), `16:9`: `16:9` and `32:18`
/// are two values.
public type Ratio = Object {
    numerator: Decimal
    denominator: Decimal
}

/// When something recurs (area 19, RFC 5545): its first occurrence as a
/// local time in its zone, a line feed, then its rule:
/// `DTSTART;TZID=Europe/London:20261026T093000\nRRULE:FREQ=WEEKLY;BYDAY=MO`.
/// `temporal.occurrences` gives the next ones.
public type RecurrenceRule = Text {}

/// A rectangle by its top-left corner and its size, never negative (area
/// 19), written as SVG writes a `viewBox`: `0 0 300 200`.
public type Rect = Object {
    x: Decimal
    y: Decimal
    width: Decimal
    height: Decimal
}

/// A relative reference (area 19, RFC 3986): a path, a query or a
/// fragment, or a host after `//`, with no scheme: `../images/logo.png`,
/// `?page=2`. `web.resolve` makes a `Url` of one.
public type RelativeUrl = Text {}

/// A URL-safe identifier (area 19): lower-case letters and digits in
/// words joined by single hyphens, `autumn-sale`, as `text.slug` writes
/// one.
public type Slug = Text {}

/// An item's serial number (area 19, GS1 AI 21), up to 20 of GS1's
/// characters: `SN-0042a`.
public type SerialNumber = Text {}

/// A seller's stock-keeping unit (area 19), 1 to 64 characters with no
/// spaces: `AB-1234-XL`.
public type Sku = Text {}

/// A SNOMED CT concept's identifier (area 19), its Verhoeff check digit
/// passing: `22298006`. Health data.
public type SnomedConcept = Text {}

/// A serial shipping container code (area 19, GS1), 18 digits, its check
/// digit passing: `106141412345678908`.
public type Sscc = Text {}

/// A timed caption (area 19, WebVTT): when it starts and ends from the
/// start of the media, its end after its start, and its text, written as
/// the cue's timings line and text: `00:00:01.000 --> 00:00:04.000` and a
/// line feed.
public type SubtitleCue = Object {
    start: Duration
    end: Duration
    text: Text
}

/// How land in England and Wales is held (area 19, HM Land Registry),
/// written as its own name, `freehold`.
public type Tenure = Enum {
    commonhold
    freehold
    leasehold
}

/// Which way text runs (area 19), written as HTML's `dir` writes it, `ltr`
/// and `rtl`: what `locale.direction` gives.
public type TextDirection = Enum {
    left_to_right
    right_to_left
}

/// A sound level, held in decibels to 2 places (area 19), written
/// `60dB`. It is logarithmic, so it compares but never adds.
public type SoundLevel = SoundLevel {}

/// A speed, held in metres per second to 6 places (area 19), written
/// `30mph` or `100kmh`; a `Length` over a `Duration`.
public type Speed = Speed {}

/// A taxpayer's identification number with the country that issued it
/// (area 19), as the OECD's common reporting standard records one: any of
/// that country's forms, a UTR or a National Insurance number for the
/// United Kingdom. Shown masked to its last four. Personal data.
public type TaxId = Object {
    country: Country
    number: Text
}

/// A rate of tax (area 19), a percentage never below 0%: `20%`.
public type TaxRate = Percentage {}

/// A temperature, held in kelvin to 3 places (area 19), written
/// `21degC`, `70degF` or `300kelvin`. It adds only a
/// `TemperatureDifference`.
public type Temperature = Temperature {}

/// The difference between two temperatures, held in kelvin to 3 places
/// (area 19): a `Temperature` minus a `Temperature`, or `units.of`.
public type TemperatureDifference = TemperatureDifference {}

/// A UK bank account number (area 19), eight digits with leading zeros
/// kept: `66374958`. Personal data.
public type UkAccountNumber = Text {}

/// A UK company's number at Companies House (area 19), eight digits or
/// two letters and six: `00445790`, `SC123456`.
public type UkCompanyNumber = Text {}

/// A UK National Insurance number (area 19), its prefix one HMRC
/// allocates: `AB123456C`, shown to people as `AB 12 34 56 C`. Personal
/// data.
public type UkNationalInsuranceNumber = Text {}

/// A UK bank sort code (area 19), six digits: `089999`, shown to people
/// as `08-99-99`.
public type UkSortCode = Text {}

/// A UK Unique Taxpayer Reference (area 19), ten digits. Personal data.
public type UkUtr = Text {}

/// A place in trade and transport (area 19, UN/LOCODE): a country's code
/// and three letters or digits, `GBLON`.
public type UnLocode = Text {}

/// A dangerous good's UN number (area 19, the UN Model Regulations):
/// `UN1203`, printed `UN 1203`.
public type UnNumber = Text {}

/// A price per an amount of a quantity (area 19), a choice by the
/// quantity's kind, as the UK's Price Marking Order prices goods by
/// weight, volume, length and area: shown `£2.50/1 kg`. Neither the price
/// nor the amount is below 0.
public type UnitPrice = Enum {
    per_mass: {
        price: Money
        per: Mass
    }
    per_volume: {
        price: Money
        per: Volume
    }
    per_length: {
        price: Money
        per: Length
    }
    per_area: {
        price: Money
        per: Area
    }
}

/// A GTIN-12, the universal product code (area 19, GS1), its check digit
/// passing and its leading zero kept: `036000291452`.
public type UpcA = Text {}

/// A Unique Property Reference Number (area 19, GeoPlace): up to 12
/// digits, held as text so no zero is lost: `100023336956`. Personal data.
public type Uprn = Text {}

/// An `http://` or `https://` URL with a host (area 2).
public type Url = Url {}

/// A URL's path (area 19, RFC 3986): `/` and its segments, with no query
/// or fragment, `/products/42`. Every path is a `RelativeUrl`.
public type UrlPath = RelativeUrl {}

/// A US Employer Identification Number (area 19), nine digits:
/// `123456789`, shown to people as `12-3456789`.
public type UsEin = Text {}

/// A US Social Security number (area 19), nine digits that the SSA could
/// have issued: `123456789`. Shown to people as its last four only,
/// `•••-••-6789`. Personal data.
public type UsSsn = Text {}

/// What an HTTP client says it is (area 19, RFC 9110's `User-Agent`):
/// products and comments, `curl/8.7.1`. Personal data.
public type UserAgent = Text {}

/// A login handle (area 19): lower-case letters, digits, `_`, `.` and
/// `-`, 1 to 64 of them. Personal data.
public type Username = Text {}

/// An offset from UTC in minutes (area 19), written `+05:30`, from 18
/// hours behind to 18 hours ahead.
public type UtcOffset = Object {
    minutes: Int
}

/// Where a visit came from (area 19, Google Analytics' UTM parameters):
/// written as the query that carries them,
/// `utm_source=mailing&utm_medium=email&utm_campaign=autumn_sale`; the
/// term and the content only where a campaign uses them.
public type UtmParameters = Object {
    source: Text
    medium: Text
    campaign: Text
    term: Text?
    content: Text?
}

// The software types (area 19, "Web and software", chunk 5.5n2).

/// A container image reference (area 19, the OCI distribution reference),
/// fully qualified: its registry, its repository in lower case, and a tag,
/// a digest or both: `docker.io/library/nginx:1.27`.
public type ContainerImage = Text {}

/// A CVE record's id (area 19, the CVE programme's ID syntax):
/// `CVE-2021-44228`.
public type Cve = Text {}

/// A content digest (area 19, the OCI image specification): its algorithm,
/// `:` and the encoded hash, `sha256:` and 64 lower-case hexadecimal
/// digits.
public type Digest = Text {}

/// A digital object identifier (area 19, the DOI Handbook), with no
/// resolver before it and ASCII letters in lower case: `10.1038/nphys1170`.
public type Doi = Text {}

/// A file's name every common file system takes (area 19): no `/` or
/// `\`, none of Windows' reserved characters or device names, at most 255
/// bytes: `report.pdf`.
public type FileName = Text {}

/// A portable path (area 19), names joined by `/`, absolute after a
/// leading `/`, in its shortest form: `/var/lib/acme/uploads`,
/// `../shared/logo.png`.
public type FilePath = Text {}

/// A git ref name (area 19, `git check-ref-format --allow-onelevel`): a
/// branch, a tag, a full ref or a commit's hash, `main`,
/// `refs/tags/v1.2.0`.
public type GitRef = Text {}

/// A request's idempotency key (area 19, the IETF's `Idempotency-Key`):
/// 1 to 255 printable ASCII characters, no `"` or `\`.
public type IdempotencyKey = Text {}

/// How severe a log record is (area 19, OpenTelemetry's severities),
/// written as its short name, `INFO`.
public type LogLevel = Enum {
    trace
    debug
    info
    warn
    error
    fatal
}

/// A package URL (area 19, ECMA-427) in its canonical form:
/// `pkg:npm/%40angular/animation@12.3.1`.
public type PackageUrl = Text {}

/// A regular expression (area 2's patterns): matched whole, in linear
/// time, with no backreferences or lookaround: `[A-Z]{2}[0-9]{2}`.
public type RegularExpression = Text {}

/// A version (area 19, SemVer 2.0.0), written `1.2.3-alpha.1+build.5`:
/// ordered by its precedence, which ignores the build metadata.
public type SemanticVersion = Object {
    major: Int
    minor: Int
    patch: Int
    pre_release: Text?
    build: Text?
}

/// A span's id (area 19, W3C Trace Context): 16 lower-case hexadecimal
/// digits, not all zero.
public type SpanId = Text {}

/// An SPDX licence expression (area 19), each identifier as the SPDX
/// licence list spells it: `MIT OR Apache-2.0`.
public type SpdxLicence = Text {}

/// A trace's id (area 19, W3C Trace Context): 32 lower-case hexadecimal
/// digits, not all zero.
public type TraceId = Text {}

/// A frame's SMPTE ST 12-1 address (area 19): hours, minutes, seconds and
/// frames at `rate`, counted drop-frame or not. It has no single text form,
/// since `01:00:00;00` doesn't say its rate, and is shown that way.
public type Timecode = Object {
    hours: Int
    minutes: Int
    seconds: Int
    frames: Int
    rate: FrameRate
    drop_frame: Bool
}

/// A `traceparent` header's value (area 19, W3C Trace Context, version
/// `00`): `00-<trace id>-<span id>-<flags>`.
public type TraceParent = Text {}

/// A ULID (area 19, the ULID specification): 26 characters of Crockford's
/// base 32 in upper case, `01ARZ3NDEKTSV4RRFFQ69G5FAV`.
public type Ulid = Text {}

/// A range of versions (area 19, node-semver's grammar in one spelling):
/// `^1.2.3`, `>=1.0.0 <2.0.0`, `1.2.x || >=2.5.0-beta.1`.
public type VersionRange = Text {}

/// A video codec as the W3C WebCodecs Codec Registry names it (area 19,
/// RFC 6381's form): `avc1.42001E`, `vp09.00.10.08`.
public type VideoCodec = Text {}

/// A video's frame size in pixels (area 19), written `1920x1080`: by its
/// pixels, not a name like "4K".
public type VideoResolution = Object {
    width: Int
    height: Int
}

// The text formats (area 19, "Text formats", chunk 5.5o).

/// HTML that is always safe to write into a page or an email (area 19):
/// building one from text keeps only the allowed elements and attributes,
/// with no scripts, no event handlers and links only to `https:` and
/// `mailto:`, so it never fails; a literal must already be what it keeps.
public type Html = Text {}

/// CommonMark text (area 19), with no control character but a tab, a line
/// feed or a carriage return; `markup.to_html` renders it as `Html`.
public type Markdown = Text {}

// Rich and localised text (area 19, "Text formats", chunk 5.5o2).

/// A structured document (area 19): its blocks in order, as Portable Text
/// holds one, each a paragraph, a heading, a quote or a list item, with
/// nothing nested; `markup.rich_to_html` writes it as `Html`.
public type RichText = List<RichTextBlock> {}

/// One block of a `RichText` (area 19): a heading's level is 1 to 6, a
/// list item's 1 to 9, how deep it sits.
public type RichTextBlock = Enum {
    paragraph: {
        spans: List<RichTextSpan>
    }
    heading: {
        level: Int
        spans: List<RichTextSpan>
    }
    quote: {
        spans: List<RichTextSpan>
    }
    bullet_item: {
        level: Int
        spans: List<RichTextSpan>
    }
    numbered_item: {
        level: Int
        spans: List<RichTextSpan>
    }
}

/// A run of text in a block (area 19), never empty, with no control
/// character but a tab or a line feed (a line break); its marks; and the
/// address it links to, if any: `https:` with a host, or `mailto:`.
public type RichTextSpan = Object {
    text: Text
    marks: List<RichTextMark>
    link: Text?
}

/// A mark on a span of text (area 19), Portable Text's decorators.
public type RichTextMark = Enum {
    strong
    emphasis
    code
    underline
    strike_through
}

/// Text in several locales (area 19), sent as JSON-LD sends a language
/// map, `{"en-GB": "Rye loaf", "fr-FR": "Pain de seigle"}`; `text.pick`
/// reads the entry for a locale.
public type LocalisedText = Map<Locale, Text> {}

/// A UUID (area 2), written in lowercase hexadecimal with hyphens.
public type Uuid = Uuid {}

/// A VAT registration number (area 19), written as VIES writes it: its
/// country's code (`EL` for Greece) and the number in that country's form,
/// `GB980780684`.
public type VatNumber = Object {
    country: Country
    number: Text
}

/// A vehicle identification number (area 19, ISO 3779), 17 characters
/// with no `I`, `O` or `Q`: `1HGCM82633A004352`.
public type Vin = Text {}

/// A voltage, held in volts to 6 places (area 19), written `230V`.
public type Voltage = Voltage {}

/// A volume, held in cubic metres to 9 places (area 19), written
/// `500ml` or `2litre`; an `Area` times a `Length`.
public type Volume = Volume {}

/// A web origin (area 19, RFC 6454): `http` or `https`, the host, and a
/// port only where it isn't the scheme's default:
/// `https://example.com`, `http://localhost:8080`.
public type WebOrigin = Text {}

/// A day of the week (area 10).
public type Weekday = Enum {
    monday
    tuesday
    wednesday
    thursday
    friday
    saturday
    sunday
}

/// A writing system (area 19, ISO 15924), written as its code, `Latn`;
/// `form: CodeForm.numeric` writes its number, `215`.
public type WritingScript = Enum {}

/// A calendar year (area 19), written `2026`, from 0 to 9999.
public type Year = Object {
    year: Int
}

/// A month of a year (area 19), written `2026-10`: `month` from 1 to 12.
public type YearMonth = Object {
    year: Int
    month: Int
}

/// An IANA time zone (area 10), written as its name, `Europe/London`.
public type Zone = Enum {}

/// An instant seen in a zone (area 10), written
/// `2026-10-25T09:30:00+00:00[Europe/London]`.
public type ZonedTime = ZonedTime {}

// The records and measures of commerce, health, travel and the rest
// (chunk 5.5m2).

/// What a barcode encodes, by its symbology (area 19): a GS1 retail code,
/// Code 128's printable ASCII or a QR code's ISO 8859-1 text. Shown as its
/// data.
public type Barcode = Enum {
    ean13: {
        data: Ean13
    }
    upc_a: {
        data: UpcA
    }
    code128: {
        data: Text
    }
    qr_code: {
        data: Text
    }
}

/// How much of something an order line or a stock count holds (area 19):
/// a count of items, or an amount by mass, volume, length or area, never
/// below 0. Shown `3`, `2.5 kg`.
public type UnitQuantity = Enum {
    each: {
        count: Int
    }
    mass: {
        amount: Mass
    }
    volume: {
        amount: Volume
    }
    length: {
        amount: Length
    }
    area: {
        amount: Area
    }
}

/// A rating on its own scale (area 19, schema.org): its value, from its
/// `worst` to its `best`, the best above the worst. Shown `4.5/5`.
public type Rating = Object {
    value: Decimal
    best: Decimal
    worst: Decimal
}

/// A clothing size in its system (area 19), written as a label writes it:
/// `UK 10`, `US M`.
public type ClothingSize = Object {
    system: ClothingSizeSystem
    size: Text
}

/// The system a clothing size is in (area 19), written as its code: `UK`,
/// `EU`, `US`.
public type ClothingSizeSystem = Enum {
    uk
    eu
    us
}

/// A shoe size in its system (area 19), written as a box writes it: `UK
/// 7.5`, `EU 42`.
public type ShoeSize = Object {
    system: ShoeSizeSystem
    size: Text
}

/// The system a shoe size is in (area 19), written as its code: `UK`,
/// `EU`, `US`.
public type ShoeSizeSystem = Enum {
    uk
    eu
    us
}

/// A box's length, width and height (area 19), none below 0. Shown in
/// centimetres, or the unit `unit:` names: `30 × 20 × 10 cm`.
public type Dimensions = Object {
    length: Length
    width: Length
    height: Length
}

/// A parcel's tracking number with its carrier (area 19), written `UPSN
/// 1Z999AA10123456784`.
public type TrackingNumber = Object {
    carrier: Carrier
    number: Text
}

/// A vehicle's registration mark with its country (area 19), written `GB
/// AB12 CDE`, the mark kept as its plate shows it.
public type VehicleRegistration = Object {
    country: Country
    plate: Text
}

/// A flight's designator (area 19, IATA's SSIM), written `BA123`: its
/// airline, its number from 1 to 9999 and any suffix.
public type FlightNumber = Object {
    airline: IataAirline
    number: Int
    suffix: Text?
}

/// Where a law applies (area 19, ISO 3166): a country or one of its
/// subdivisions. Shown by its name: `England`.
public type Jurisdiction = Enum {
    country: {
        country: Country
    }
    subdivision: {
        subdivision: CountrySubdivision
    }
}

/// An AI model by its provider and name (area 19), written
/// `meta-llama/Llama-3.1-8B-Instruct`.
public type ModelId = Object {
    provider: Text
    name: Text
}

/// An amount of a medicine (area 19), by mass or by volume, above nothing.
/// Shown in milligrams or millilitres: `500 mg`, `5 ml`.
public type Dose = Enum {
    mass: {
        amount: Mass
    }
    volume: {
        amount: Volume
    }
}

/// How a medicine is taken (area 19, EDQM's Standard Terms), written as
/// its own name, `oral`, and shown as EDQM words it, "Oral use".
public type RouteOfAdministration = Enum {
    auricular
    buccal
    cutaneous
    inhalation
    intramuscular
    intravenous
    nasal
    ocular
    oral
    rectal
    subcutaneous
    sublingual
    transdermal
    vaginal
}

/// How to take a medicine (area 19, FHIR's `Dosage`): a dose, a route, at
/// least once in a period above nothing, and whether only when needed.
/// Shown `500 mg, Oral use, 2 times per 1 day`.
public type DosageInstruction = Object {
    dose: Dose
    route: RouteOfAdministration
    times: Int
    per: Duration
    as_needed: Bool
}

/// A heart rate (area 19, LOINC 8867-4), a `Frequency` from 0 to 300
/// beats a minute, written `72bpm` and shown `72 bpm`. Health data.
public type HeartRate = Frequency {}

/// A blood pressure (area 19, LOINC 85354-9): its systolic and diastolic
/// `Pressure`s, the diastolic below the systolic. Shown `120/80 mmHg`.
/// Health data.
public type BloodPressure = Object {
    systolic: Pressure
    diastolic: Pressure
}

/// A blood glucose level (area 19), a `Concentration` never below 0:
/// `units.of(5.5, ConcentrationUnit.millimole_of_glucose_per_litre)`, shown
/// `5.5 mmol/L`. Health data.
public type BloodGlucose = Concentration {}

// The geospatial types (area 19, "Geospatial: a future area", chunk 5.5s):
// positions in WGS84 by `latitude` and `longitude`, never a pair, and the
// geometries made of them, sent as GeoJSON (RFC 7946), whose `[longitude,
// latitude]` order exists only on the wire. Storing one and the `geo.`
// operations come with the geospatial area.

/// Degrees north of the equator in WGS84 (area 19), from -90 to 90, held
/// as written: `51.5072`, shown `51.5072° N`.
public type Latitude = Decimal {}

/// Degrees east of the prime meridian in WGS84 (area 19), from -180 to 180,
/// held as written: `-0.1276`, shown `0.1276° W`.
public type Longitude = Decimal {}

/// A compass direction (area 19), degrees clockwise from true north, from
/// 0 to 360: `247.5`, shown `247.5°`.
public type Bearing = Decimal {}

/// A coordinate reference system by its EPSG code (area 19): `EPSG:27700`.
public type Crs = Text {}

/// A geohash cell (area 19, geohash.org): 1 to 12 characters, in lower
/// case: `gcpvj0duq`.
public type Geohash = Text {}

/// An H3 cell (area 19, Uber's H3 index), 15 lower-case hexadecimal
/// digits, its bits valid: `8928308280fffff`.
public type H3Cell = Text {}

/// A web map tile on OpenStreetMap's XYZ scheme (area 19): a zoom from 0 to
/// 30 and a column and row each below 2 to the zoom, shown `10/511/340`.
public type MapTile = Object {
    zoom: Int
    x: Int
    y: Int
}

/// Projected coordinates (area 19): an easting and a northing, by name, in
/// their reference system's units.
public type EastingNorthing = Object {
    easting: Decimal
    northing: Decimal
    crs: Crs
}

/// A position on Earth in WGS84 (area 19): its latitude and longitude by
/// name, and its height above the ellipsoid where it has one. Sent as a
/// GeoJSON `Point`, shown `51.5072° N, 0.1276° W`.
public type Point = Object {
    latitude: Latitude
    longitude: Longitude
    altitude: Length?
}

/// A path of two points or more, in order (area 19): a GeoJSON
/// `LineString`.
public type LineString = Object {
    points: List<Point>
}

/// An area with any holes (area 19): a GeoJSON `Polygon`, each ring closed
/// with four points or more, the outer counterclockwise and each hole
/// clockwise when written.
public type Polygon = Object {
    outer: List<Point>
    holes: List<List<Point>>
}

/// Points, at least one (area 19): a GeoJSON `MultiPoint`.
public type MultiPoint = Object {
    points: List<Point>
}

/// Paths, at least one (area 19): a GeoJSON `MultiLineString`.
public type MultiLineString = Object {
    lines: List<LineString>
}

/// Areas, at least one (area 19): a GeoJSON `MultiPolygon`.
public type MultiPolygon = Object {
    polygons: List<Polygon>
}

/// Any one of the six geometries (area 19), sent as the GeoJSON geometry it
/// holds.
public type Geometry = Enum {
    point: {
        point: Point
    }
    line_string: {
        line_string: LineString
    }
    polygon: {
        polygon: Polygon
    }
    multi_point: {
        multi_point: MultiPoint
    }
    multi_line_string: {
        multi_line_string: MultiLineString
    }
    multi_polygon: {
        multi_polygon: MultiPolygon
    }
}

/// A rectangle on the map by its sides (area 19, RFC 7946's bounding box),
/// named: its south at or below its north, and a west east of its east
/// across the antimeridian.
public type BoundingBox = Object {
    south: Latitude
    west: Longitude
    north: Latitude
    east: Longitude
}

/// A centre and a radius on the ground (area 19), the radius never below
/// 0: shown `1,000 m around 51.5072° N, 0.1276° W`.
public type Circle = Object {
    centre: Point
    radius: Length
}
