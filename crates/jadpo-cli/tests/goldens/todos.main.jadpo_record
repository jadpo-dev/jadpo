// Generated by Jadpo from the routes of API main; update it with `jadpo api update`, never by hand.
record api 1

GET /openapi.json
    generated openapi
    authentication none
    status 200

GET /todos
    authentication none
    input ListTodos (query)
    output List<TodoView>
    status 200

POST /todos
    authentication none
    input CreateTodo (body)
    output TodoView
    status 201

GET /todos/{todo_id: Uuid}
    authentication none
    output TodoView
    status 200
    fails todo_not_found

input CreateTodo
    title: Text { min_length: 1, max_length: 200 }

input ListTodos
    limit: Int { min: 1, max: 50 } default 20
    request_tag: Text { min_length: 1, max_length: 200 } header "X-Request-Tag" optional
    status: List<TodoStatus> optional

enum TodoStatus
    variant done
    variant open

output TodoView
    id: Uuid
    status: TodoStatus
    title: Text { min_length: 1, max_length: 200 }

failure todo_not_found
    status 404
    message "Todo not found."
    todo_id: Uuid
