/// What asking a model for a message takes: the model, the most tokens it
/// may answer with (its thinking included), the system prompt and the
/// conversation.
public type MessageRequest = Object {
    model: Text {
        max_length: 200
    }
    max_tokens: Int {
        min: 1
        max: 1000000
    }
    decline package.standard_candidate: "What an app sends a model is checked where it is written, against `ai: { personal_data: }`, so this field adds no mark"
    system: Text
    messages: List<MessageParam>
}
