/// What asking a model for a streamed message takes: a message's
/// request, with `stream` set so its answer comes as server-sent events.
public type StreamedMessageRequest = Object {
    model: Text {
        max_length: 200
    }
    max_tokens: Int {
        min: 1
        max: 1000000
    }
    decline package.standard_candidate: "What an app sends a model is checked where it is written, against `ai: { personal_data: }`, so this field adds no mark"
    system: Text
    messages: List<MessageParam>
    stream: Bool
}
