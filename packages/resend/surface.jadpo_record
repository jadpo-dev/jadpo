// Generated by Jadpo from this package's code; update it with `jadpo package check`, never by hand.
record surface 1

package Resend.v1
    /// Resend: the app's email sent through Resend's API, as the `email` capability.
    file package.jadpo
    kind provider
    version 1.0.0
    licence apache_2_0
    jadpo 1.0

provider
    /// Resend's API, each request carrying the account's API key as a bearer credential. The connection gives its address, `https://api.resend.com`, in `host:`.
    file provider.jadpo
    protocol json_http
    credential bearer

operation emails.send
    file resources/emails.jadpo
    request POST /emails
    input SendEmailRequest
    output SendEmailResponse
    changes
    fails InvalidAttachment
    fails InvalidParameter
    fails MissingRequiredField
    fails MissingRequiredParameter
    fails ValidationError
    source written https://resend.com/docs/api-reference/emails/send-email

type EmailAttachment = Object
    /// One file sent with an email: its name, its bytes, sent in base64, and its media type.
    file types/email_attachment.jadpo
    content: Bytes
    content_type: Text?
    filename: Text

type SendEmailRequest = Object
    /// One email to send: who it is from and to, its subject, its HTML and its text, and the files sent with it.
    file types/send_email_request.jadpo
    attachments: List<EmailAttachment>
    from: Text
    html: Text?
    subject: Text
    text: Text?
    to: Text

type SendEmailResponse = Object
    /// What Resend answers an email it took with: its id for the email.
    file types/send_email_response.jadpo
    id: Text

failure InvalidAttachment
    /// Resend refused one of the email's attachments.
    file failures/invalid_attachment.jadpo
    kind invalid_value
    code invalid_attachment
    message "Resend refused one of the email's attachments."

failure InvalidParameter
    /// One of the email's values isn't one Resend takes.
    file failures/invalid_parameter.jadpo
    kind invalid_value
    code invalid_parameter
    message "One of the email's values isn't one Resend takes."

failure MissingRequiredField
    /// The email left out something Resend needs.
    file failures/missing_required_field.jadpo
    kind invalid_value
    code missing_required_field
    message "The email left out something Resend needs."

failure MissingRequiredParameter
    /// The email left out a value Resend needs.
    file failures/missing_required_parameter.jadpo
    kind invalid_value
    code missing_required_parameter
    message "The email left out a value Resend needs."

failure ValidationError
    /// Resend refused the email as written.
    file failures/validation_error.jadpo
    kind invalid_value
    code validation_error
    message "Resend refused the email as written."
