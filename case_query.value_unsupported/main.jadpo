type Title = Text {
    max_length: 80
}

entity Book {
    id: Uuid
    title: Title
    subtitle: Title?
    available: Bool
}

type Pages = Int {
    min: 1
    max: 5000
}

entity Manual {
    id: Uuid
    pages: Pages
}

query longer_manuals(pages: Manual.pages) -> List<Manual> {
    from: Manual
    where: Manual.pages > pages * 2
    order: [Manual.pages asc]
    limit: 20
}
