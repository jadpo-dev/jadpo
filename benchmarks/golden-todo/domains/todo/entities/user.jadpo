use todo/types { UserStatus }

entity User {
    id: Uuid
    authentication_subject: Text {
        unique: true
    }
    status: UserStatus
    // Set when the account is provisioned from the identity provider;
    // no request changes it.
    email: Email {
        policy: {
            read: [Access.system]
            update: []
        }
    }
    policy: {
        read: [id, Access.system]
        update: [id]
    }
}
