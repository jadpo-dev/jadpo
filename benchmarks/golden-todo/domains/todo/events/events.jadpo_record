// Generated by Jadpo from the events of domain todo; update it with `jadpo records update`, never by hand.
record events 1

event ReminderPrepared
    recipient: Email
    revision: Int
    title: Text { min_length: 1, max_length: 200 }
    todo_id: Uuid

event ReminderQueued
    revision: Int
    todo_id: Uuid
