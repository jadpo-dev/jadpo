// Generated by Jadpo from the routes of API main; update it with `jadpo api update`, never by hand.
record api 1

api main
    authentication api_token
    authentication browser_session
    authentication external_token
    authentication service_key

POST /auth/exchange
    generated exchange
    caller service
    output ExchangedToken
    status 200

GET /todos
    input ListTodos (query)
    output Page<TodoView>
    status 200

POST /todos
    caller user
    input CreateTodo (body)
    output TodoView
    status 201
    fails due_date_in_past

GET /todos/{todo_id: Uuid}
    output TodoView
    status 200
    fails todo_not_found

PATCH /todos/{todo_id: Uuid}
    input PatchTodo (body)
    output TodoView
    status 200
    fails due_date_in_past
    fails todo_not_found

DELETE /todos/{todo_id: Uuid}
    status 204
    fails todo_not_found

DELETE /users/{user_id: Uuid}
    status 204
    fails user_not_found

GET /users/{user_id: Uuid}/todos
    output UserWithTodos
    status 200
    fails user_not_found

input CreateTodo
    due_at: Instant? default none
    title: Text { min_length: 1, max_length: 200 }

output ExchangedToken
    expires_at: Instant
    token: ServiceToken

input ListTodos
    after: PageCursor optional
    due_before: Instant optional
    page_size: PageSize { min: 1, max: 100 } default 25
    status: TodoStatus optional

input PatchTodo
    due_at: Instant? optional
    status: TodoStatus optional
    title: Text { min_length: 1, max_length: 200 } optional

enum TodoStatus
    variant done
    variant open

output TodoView
    created_at: Instant
    due_at: Instant?
    id: Uuid
    status: TodoStatus
    title: Text { min_length: 1, max_length: 200 }
    updated_at: Instant

output UserWithTodos
    id: Uuid
    todos: List<TodoView>

failure due_date_in_past
    status 422
    message "The due date must be in the future."

failure todo_not_found
    status 404

failure user_not_found
    status 404
