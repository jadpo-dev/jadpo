// Generated by Jadpo from the routes of API main; update it with `jadpo api update`, never by hand.
record api 1

api main
    authentication api_token

POST /api/register
    authentication none
    input Register (body)
    output Registered
    status 201
    fails handle_taken

GET /api/samples/{sample_id: Uuid}
    authentication none
    output SampleView
    status 200
    fails sample_not_found

GET /api/todos
    caller user
    output List<TodoView>
    status 200

POST /api/todos
    caller user
    input AddTodo (body)
    output TodoView
    status 201

GET /openapi.json
    generated openapi
    status 200

input AddTodo
    title: Text { min_length: 1, max_length: 200 }

input Register
    handle: Text { min_length: 1, max_length: 80 }

output Registered
    id: Uuid
    token: ApiToken

output SampleView
    id: Uuid
    payload: Text { max_length: 65536 }
    title: Text { min_length: 1, max_length: 200 }

output TodoView
    id: Uuid
    title: Text { min_length: 1, max_length: 200 }

failure handle_taken
    status 409
    message "That handle is taken."

failure sample_not_found
    status 404
