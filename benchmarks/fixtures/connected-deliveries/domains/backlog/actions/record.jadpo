use app { checks }
use shared/providers/local_checks
use backlog/entities { Receipt }
use backlog/types { Ticket }
use backlog/failures { AlreadyRecorded }

action record(ticket: Ticket) fails AlreadyRecorded -> Unit {
    var checked: LocalChecks.TicketAnswer = attempt checks.tickets.get(LocalChecks.TicketLookup { ticket: LocalChecks.CheckedTicket(ticket) }) {
        ticket_unknown: AlreadyRecorded
    }
    assert Ticket(checked.ticket) == ticket
    var receipt: Receipt = attempt Receipt.create {
        set: {
            ticket: ticket
        }
        conflict: {
            Receipt.ticket: AlreadyRecorded
        }
    }
    assert receipt.ticket == ticket
}
