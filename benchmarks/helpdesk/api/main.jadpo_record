// Generated by Jadpo from the routes of API main; update it with `jadpo api update`, never by hand.
record api 1

api main
    authentication api_token
    authentication browser_session

GET /customers/{customer_id: Uuid}
    output CustomerView
    status 200
    fails customer_not_found

PATCH /customers/{customer_id: Uuid}
    input PatchCustomer (body)
    output CustomerView
    status 200
    fails customer_email_taken
    fails customer_not_found

DELETE /customers/{customer_id: Uuid}
    status 204
    fails customer_not_found

GET /customers/{customer_id: Uuid}/tickets
    output List<TicketView>
    status 200

GET /macros/{macro_id: Uuid}
    output MacroView
    status 200
    fails macro_not_found

PATCH /macros/{macro_id: Uuid}
    input PatchMacro (body)
    output MacroView
    status 200
    fails macro_not_found

DELETE /macros/{macro_id: Uuid}
    status 204
    fails macro_not_found

GET /me
    caller user
    output MeView
    status 200
    fails user_not_found

PATCH /members/{member_id: Uuid}
    input MemberChange (body)
    output MemberView
    status 200
    fails last_owner
    fails membership_not_found

DELETE /members/{member_id: Uuid}
    status 204
    fails last_owner
    fails membership_not_found

PATCH /notes/{note_id: Uuid}
    input WriteMessage (body)
    output NoteView
    status 200
    fails note_not_found

DELETE /notes/{note_id: Uuid}
    status 204
    fails note_not_found

PATCH /replies/{reply_id: Uuid}
    input WriteMessage (body)
    output ReplyView
    status 200
    fails reply_not_found

DELETE /replies/{reply_id: Uuid}
    status 204
    fails reply_not_found

PATCH /tags/{tag_id: Uuid}
    input NameTag (body)
    output TagView
    status 200
    fails tag_name_taken
    fails tag_not_found

DELETE /tags/{tag_id: Uuid}
    status 204
    fails tag_not_found

GET /tickets/{ticket_id: Uuid}
    output TicketView
    status 200
    fails ticket_not_found

PATCH /tickets/{ticket_id: Uuid}
    input PatchTicket (body)
    output TicketView
    status 200
    fails ticket_not_found

DELETE /tickets/{ticket_id: Uuid}
    status 204
    fails ticket_not_found

POST /tickets/{ticket_id: Uuid}/assign
    input Assignment (body)
    output TicketView
    status 200
    fails assignee_cannot_work
    fails membership_not_found
    fails ticket_not_found

GET /tickets/{ticket_id: Uuid}/customer
    output CustomerView
    status 200
    fails customer_not_found
    fails ticket_not_found

GET /tickets/{ticket_id: Uuid}/notes
    output List<NoteView>
    status 200
    fails ticket_not_found

POST /tickets/{ticket_id: Uuid}/notes
    caller user
    input WriteMessage (body)
    output NoteView
    status 201
    fails ticket_not_found

POST /tickets/{ticket_id: Uuid}/reopen
    output TicketView
    status 200
    fails ticket_not_found

GET /tickets/{ticket_id: Uuid}/replies
    output List<ReplyView>
    status 200
    fails ticket_not_found

POST /tickets/{ticket_id: Uuid}/replies
    caller user
    input WriteMessage (body)
    output ReplyView
    status 201
    fails ticket_not_found

POST /tickets/{ticket_id: Uuid}/solve
    output TicketView
    status 200
    fails ticket_not_found

GET /tickets/{ticket_id: Uuid}/tags
    output List<TicketTagView>
    status 200
    fails ticket_not_found

POST /tickets/{ticket_id: Uuid}/tags
    input AddTicketTag (body)
    output TicketTagView
    status 201
    fails already_tagged
    fails tag_not_found
    fails ticket_not_found

DELETE /tickets/{ticket_id: Uuid}/tags/{tag_id: Uuid}
    status 204
    fails ticket_not_found
    fails ticket_tag_not_found

GET /workspaces
    output List<WorkspaceView>
    status 200

POST /workspaces
    caller user
    input NewWorkspace (body)
    output WorkspaceView
    status 201
    fails already_member

GET /workspaces/{workspace_id: Uuid}
    output WorkspaceView
    status 200
    fails workspace_not_found

PATCH /workspaces/{workspace_id: Uuid}
    input WorkspaceRename (body)
    output WorkspaceView
    status 200
    fails workspace_not_found

GET /workspaces/{workspace_id: Uuid}/customers
    output List<CustomerView>
    status 200

POST /workspaces/{workspace_id: Uuid}/customers
    input CreateCustomer (body)
    output CustomerView
    status 201
    fails customer_email_taken
    fails workspace_not_found

GET /workspaces/{workspace_id: Uuid}/macros
    output List<MacroView>
    status 200

POST /workspaces/{workspace_id: Uuid}/macros
    input NewMacro (body)
    output MacroView
    status 201
    fails workspace_not_found

GET /workspaces/{workspace_id: Uuid}/members
    output List<MemberView>
    status 200

POST /workspaces/{workspace_id: Uuid}/members
    input NewMember (body)
    output MemberView
    status 201
    fails already_member
    fails user_not_found
    fails workspace_not_found

GET /workspaces/{workspace_id: Uuid}/tags
    output List<TagView>
    status 200

POST /workspaces/{workspace_id: Uuid}/tags
    input NameTag (body)
    output TagView
    status 201
    fails tag_name_taken
    fails workspace_not_found

GET /workspaces/{workspace_id: Uuid}/tickets
    input ListTickets (query)
    output Page<TicketView>
    status 200

POST /workspaces/{workspace_id: Uuid}/tickets
    input CreateTicket (body)
    output TicketView
    status 201
    fails customer_not_found
    fails workspace_not_found

input AddTicketTag
    tag_id: Uuid

input Assignment
    assignee_id: Uuid?

input CreateCustomer
    email: Email
    name: Text { min_length: 1, max_length: 120 }
    phone: Text { min_length: 5, max_length: 32 }? default none

input CreateTicket
    customer_id: Uuid
    priority: TicketPriority default TicketPriority.normal
    subject: Text { min_length: 1, max_length: 200 }

output CustomerView
    created_at: Instant
    email: Email
    id: Uuid
    name: Text { min_length: 1, max_length: 120 }
    phone: Text { min_length: 5, max_length: 32 }?
    updated_at: Instant

input ListTickets
    after: PageCursor optional
    assignee_id: Uuid optional
    page_size: PageSize { min: 1, max: 100 } default 25
    status: TicketStatus optional

output MacroView
    body: Text { min_length: 1, max_length: 5000 }
    created_at: Instant
    id: Uuid
    title: Text { min_length: 1, max_length: 80 }
    updated_at: Instant

output MeView
    email: Email
    id: Uuid
    status: UserStatus

input MemberChange
    display_name: Text { min_length: 1, max_length: 120 } optional
    role: WorkspaceRole optional

output MemberView
    created_at: Instant
    display_name: Text { min_length: 1, max_length: 120 }
    id: Uuid
    role: WorkspaceRole
    updated_at: Instant
    user_id: Uuid

input NameTag
    name: Text { min_length: 1, max_length: 40 }

input NewMacro
    body: Text { min_length: 1, max_length: 5000 }
    title: Text { min_length: 1, max_length: 80 }

input NewMember
    display_name: Text { min_length: 1, max_length: 120 }
    role: WorkspaceRole
    user_id: Uuid

input NewWorkspace
    display_name: Text { min_length: 1, max_length: 120 }
    name: Text { min_length: 1, max_length: 80 }

output NoteView
    author_id: Uuid?
    body: Text { min_length: 1, max_length: 5000 }
    created_at: Instant
    id: Uuid
    ticket_id: Uuid
    updated_at: Instant

input PatchCustomer
    email: Email optional
    name: Text { min_length: 1, max_length: 120 } optional
    phone: Text { min_length: 5, max_length: 32 }? optional

input PatchMacro
    body: Text { min_length: 1, max_length: 5000 } optional
    title: Text { min_length: 1, max_length: 80 } optional

input PatchTicket
    priority: TicketPriority optional
    subject: Text { min_length: 1, max_length: 200 } optional

output ReplyView
    author_id: Uuid?
    body: Text { min_length: 1, max_length: 5000 }
    created_at: Instant
    id: Uuid
    ticket_id: Uuid
    updated_at: Instant

output TagView
    created_at: Instant
    id: Uuid
    name: Text { min_length: 1, max_length: 40 }

enum TicketPriority
    variant high
    variant low
    variant normal
    variant urgent

enum TicketStatus
    variant open
    variant pending
    variant solved

output TicketTagView
    created_at: Instant
    id: Uuid
    tag: TagView

output TicketView
    assignee_id: Uuid?
    breached_at: Instant?
    created_at: Instant
    customer_id: Uuid?
    first_response_at: Instant?
    id: Uuid
    priority: TicketPriority
    respond_by: Instant
    solved_at: Instant?
    status: TicketStatus
    subject: Text { min_length: 1, max_length: 200 }
    updated_at: Instant

enum UserStatus
    variant active
    variant disabled

input WorkspaceRename
    name: Text { min_length: 1, max_length: 80 }

enum WorkspaceRole
    variant admin
    variant agent
    variant owner
    variant viewer

output WorkspaceView
    created_at: Instant
    id: Uuid
    name: Text { min_length: 1, max_length: 80 }
    updated_at: Instant

input WriteMessage
    body: Text { min_length: 1, max_length: 5000 }

failure already_member
    status 409
    message "That person is already a member of this workspace."

failure already_tagged
    status 409
    message "The ticket already has that tag."

failure assignee_cannot_work
    status 422
    message "Tickets can only be assigned to owners, admins and agents."

failure customer_email_taken
    status 409
    message "This workspace already has a customer with that email."

failure customer_not_found
    status 404

failure last_owner
    status 422
    message "A workspace must keep at least one owner."

failure macro_not_found
    status 404

failure membership_not_found
    status 404

failure note_not_found
    status 404

failure reply_not_found
    status 404

failure tag_name_taken
    status 409
    message "This workspace already has a tag with that name."

failure tag_not_found
    status 404

failure ticket_not_found
    status 404

failure ticket_tag_not_found
    status 404

failure user_not_found
    status 404

failure workspace_not_found
    status 404
